  "statut": "indicatif — à trancher par le référent ; voir SENS_DES_TRAITS.md",
  "repere": {
    "x": "0 = bord gauche de la forme, 1 = bord droit (l'écriture progresse vers x décroissant)",
    "y": "0 = ligne de base ; 1 = hauteur de l'alif ; négatif = sous la ligne",
    "liaison": "une forme liée à droite commence en [1,0] ; une forme qui se lie à gauche finit en [0,0]",
    "pts": "points de passage dans l'ordre du geste ; à recaler sur les contours de Noto Naskh Arabic 700 (comme le prototype de ب)",
    "retours": "paires d'indices [i,j] : le segment pts[i]→pts[j] repasse sur le trait qui vient d'être tracé (aller-retour d'une dent ou d'une hampe)",
    "sens_boucle": "horaire / antihoraire, vu par le lecteur"
  },
  "sources": {
    "AB": "Brustad, Al-Batal, Al-Tonsi, Alif Baa, Georgetown University Press (texte en ligne, Middlebury College)",
    "SK": "Mamoun Sakkal, Arabic Alphabet Chart in Naskh Style: With Teaching Notes, 2016, sakkal.com",
    "BSE": "Biadsy, El-Sana, Saabni, US 8 615 131 B2, Online Arabic handwriting recognition",
    "LIVRE": "ad1, ecriture.conseil_fr"
  },
  "regles": {
    "sens": "droite vers gauche ; un groupe de lettres attachées = un seul geste (AB)",
    "marques": "points, barre de ك, hampe de ط ظ, hamza, madda : après le corps ; dans un mot, après le squelette du mot entier, de droite à gauche ; puis voyelles et signes (AB, BSE)",
    "hampes": "de haut en bas quand elles commencent un trait ; montée puis retour sur le même trait quand on y arrive par une liaison ; ـا monte et s'arrête (AB, SK)",
    "dents": "début : départ au sommet de la dent ; milieu : montée et retour (SK, AB)",
    "points_ordre": "convention non sourcée : de droite à gauche ; pour 3 points, rangée du bas puis sommet"
  },
