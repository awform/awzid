# Copier en .env (ignoré par git) — ou lancer : bash infra/dev-env.sh
# Valeurs de DÉVELOPPEMENT uniquement ; le mot de passe est généré par infra/provision.sh
DATABASE_URL=postgres://awform:CHANGER@localhost:5432/awform_dev
TEST_DATABASE_URL=postgres://awform:CHANGER@localhost:5432/awform_test
AWFORM_CONTENT_DIR=/home/awzid/awform-content
AWFORM_EDITION=dev
API_HOST=127.0.0.1
API_PORT=3000
API_URL=http://127.0.0.1:3000
# cookie de session « Secure » (les navigateurs l'acceptent aussi sur localhost/127.0.0.1)
COOKIE_SECURE=1
# clé de 32 octets en hexadécimal (openssl rand -hex 32) : second facteur des enseignants
AWFORM_SECRET_KEY=CHANGER
