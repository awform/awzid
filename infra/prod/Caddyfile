# Entrée AWFORM.
#  - DÉMONSTRATION (réseau local) : http://<IP> et https://<IP> avec l'autorité de certification INTERNE de
#    Caddy (le navigateur avertit tant que son certificat racine n'est pas installé) ; http://localhost pour
#    le tunnel ssh (contexte sécurisé : hors ligne et micro fonctionnent).
#  - PRODUCTION : remplacer SITE par le domaine (ex. app.awzid.org) et retirer `tls internal` : Caddy
#    obtient alors un certificat Let's Encrypt (le domaine doit pointer vers le serveur).
{
	admin off
	# adresse IP : les navigateurs n'envoient pas de nom (SNI) ; certificat choisi par défaut
	# (SITE_LAN : IP du PC sur le Wi-Fi, redirection de port ; voir application/TEST_APPAREILS.md ;
	# SITE_TS : adresse Tailscale 100.64.0.0/10 de la machine de démonstration, réseau privé)
	default_sni {$DEFAULT_SNI:localhost}
	# audit INF-6 : Caddy est en BORDURE — aucun mandataire amont de confiance ; l'en-tête X-Forwarded-For
	# reçu d'un client est remplacé par sa vraie adresse (l'API ne fait confiance qu'à un saut : Caddy)
	# relais d'école (lot 17) : certificat « à la demande » pour un sous-domaine de relais, seulement si
	# l'API confirme qu'il s'agit d'un relais enregistré et actif
	on_demand_tls {
		ask http://api:3000/api/v1/relais/tls-autorise
	}
}

(awform) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), geolocation=(), payment=(), microphone=(self)"
		Cross-Origin-Opener-Policy same-origin
		X-Frame-Options DENY
		# bêta fermée : invisible des moteurs de recherche et des archives (aussi posé par l'application)
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
		-Server
	}
	# aucun moteur de recherche (robots.txt strict), aucun sitemap
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			User-agent: *
			Disallow: /

			TXT 200
	}
	@sitemap path /sitemap.xml /sitemap_index.xml
	handle @sitemap {
		respond "introuvable" 404
	}
	# sonde de disponibilité (réponse minimale, 503 si la base ne répond pas) et page d'état
	handle /healthz {
		rewrite * /healthz
		reverse_proxy api:3000
	}
	handle /etat {
		rewrite * /etat.html
		reverse_proxy web:3000
	}
	@api path /api/*
	handle @api {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:3000
	}
	# page « service momentanément indisponible » (maintenance, redémarrage) : l'API répond en JSON
	handle_errors 502 503 504 {
		header Retry-After 120
		header Cache-Control no-store
		@apierr path /api/*
		handle @apierr {
			header Content-Type application/json
			respond `{"error":{"code":"service_indisponible"}}` 503
		}
		handle {
			root * /srv/maintenance
			rewrite * /index.html
			file_server {
				status 503
			}
		}
	}
	log {
		output stdout
		format json
	}
}

# nom Tailscale (deploy.sh --ts-name) : site HTTP+HTTPS avec le certificat Let's Encrypt de Tailscale, décrit
# dans /etc/caddy/tsnet/ts.caddy (écrit par ts-cert.sh) ; dossier vide = rien de plus n'est servi
import /etc/caddy/tsnet/*.caddy

# HTTP sur l'adresse du site (audit SEC-7) : servi en réseau local (AWFORM_HTTP=servir, défaut), redirigé vers
# HTTPS en production (AWFORM_HTTP=rediriger, deploy.sh --production)
(servir) {
	import awform
}
(rediriger) {
	redir https://{host}{uri} 308
}
http://{$SITE}, http://{$SITE_LAN:127.0.0.2}, http://{$SITE_TS:127.0.0.3} {
	import {$AWFORM_HTTP:servir}
}

# tunnel ssh depuis le PC : toujours servi (contexte sécurisé pour le navigateur)
http://localhost, http://127.0.0.1 {
	import awform
}

# certificat : autorité INTERNE de Caddy (réseau local, démonstration) ou Let's Encrypt (serveur public :
# AWFORM_TLS=tls_public, posé par deploy.sh --production ; le domaine doit pointer vers le serveur)
(tls_interne) {
	tls internal
}
(tls_public) {
	tls {
		protocols tls1.2 tls1.3
	}
}
https://{$SITE}, https://{$SITE_LAN:127.0.0.2}, https://{$SITE_TS:127.0.0.3} {
	import {$AWFORM_TLS:tls_interne}
	header Strict-Transport-Security "max-age=31536000"
	import awform
}

# Relais d'école (lot 17) : le sous-domaine d'une école (ex. ecole-dakar-01.relais.awzid.org) pointe
# publiquement vers ce serveur ; hors de l'école, il sert donc l'application comme le site principal. Le
# certificat obtenu ici est remis au relais (volume relais_certs, relais-certs.sh), qui le sert sur le Wi-Fi.
# RELAIS_DOMAINE absent : domaine réservé « .invalid », aucun certificat demandé.
https://*.{$RELAIS_DOMAINE:relais.invalid} {
	tls {
		on_demand
	}
	header Strict-Transport-Security "max-age=31536000"
	import awform
}
