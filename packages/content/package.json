{
  "name": "@awform/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modèle typé du contenu AWFORM et import des fichiers des livres (sans ressaisie)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "default": "./dist/projection.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "default": "./dist/scene.js"
    },
    "./tajwid": {
      "types": "./dist/tajwid.d.ts",
      "default": "./dist/tajwid.js"
    },
    "./audio-cle": {
      "types": "./dist/audio-cle.d.ts",
      "default": "./dist/audio-cle.js"
    },
    "./riwayat": {
      "types": "./dist/riwayat.d.ts",
      "default": "./dist/riwayat.js"
    },
    "./suspension": {
      "types": "./dist/suspension.d.ts",
      "default": "./dist/suspension.js"
    },
    "./niveaux": {
      "types": "./dist/niveaux.d.ts",
      "default": "./dist/niveaux.js"
    },
    "./adhkar": {
      "types": "./dist/adhkar.d.ts",
      "default": "./dist/adhkar.js"
    },
    "./vivante": {
      "types": "./dist/vivante.d.ts",
      "default": "./dist/vivante.js"
    },
    "./versets": {
      "types": "./dist/versets.d.ts",
      "default": "./dist/versets.js"
    },
    "./adab": {
      "types": "./dist/adab.d.ts",
      "default": "./dist/adab.js"
    },
    "./adab-classer": {
      "types": "./dist/adab-classer.d.ts",
      "default": "./dist/adab-classer.js"
    },
    "./akhlaq": {
      "types": "./dist/akhlaq.d.ts",
      "default": "./dist/akhlaq.js"
    }
  },
  "bin": {
    "awform-content": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check-content": "node dist/cli.js",
    "tajwid": "node dist/cli-tajwid.js",
    "traductions": "node --no-warnings dist/cli-traductions.js",
    "riwayat": "node --no-warnings dist/cli-riwayat.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
