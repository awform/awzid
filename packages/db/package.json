{
  "name": "@awform/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schéma PostgreSQL (Drizzle), migrations versionnées et import des éditions de contenu",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "node dist/cli/migrate.js",
    "import-content": "node dist/cli/import.js",
    "coran-audio": "node dist/cli/coran-audio.js",
    "lecons-audio": "node dist/cli/lecons-audio.js",
    "mots-coran": "node dist/cli/mots-coran.js"
  },
  "dependencies": {
    "@awform/content": "workspace:*",
    "@awform/grading": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
