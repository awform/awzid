{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":56,"name":"الوَاقِعة ","t":[
[1,534,27,"إِذَا وَقَعَتِ اِ۬لۡوَاقِعَةُ ﰀ"],
[2,534,27,"لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ ﰁ"],
[3,534,27,"خَافِضَةٞ رَّافِعَةٌ ﰂ"],
[4,534,27,"إِذَا رُجَّتِ اِ۬لۡأَرۡضُ رَجّٗا ﰃ"],
[5,534,27,"وَبُسَّتِ اِ۬لۡجِبَالُ بَسّٗا ﰄ"],
[6,534,27,"فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا ﰅ"],
[7,534,27,"وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ ﰆ"],
[8,534,27,"فَأَصۡحَٰبُ اُ۬لۡمَيۡمَنَةِ ﰇ"],
[9,534,27,"مَآ أَصۡحَٰبُ اُ۬لۡمَيۡمَنَةِ ﰈ"],
[10,534,27,"وَأَصۡحَٰبُ اُ۬لۡمَشۡـَٔمَةِ ﰉ"],
[11,534,27,"مَآ أَصۡحَٰبُ اُ۬لۡمَشۡـَٔمَةِ ﰊ"],
[12,534,27,"وَاَلسَّٰبِقُونَ اَ۬لسَّٰبِقُونَ ﰋ"],
[13,534,27,"أُوْلَٰٓئِكَ اَ۬لۡمُقَرَّبُونَ ﰌ"],
[14,534,27,"فِي جَنَّٰتِ اِ۬لنَّعِيمِ ﰍ"],
[15,534,27,"ثُلَّةٞ مِّنَ اَ۬لۡأَوَّلِينَ ﰎ"],
[16,534,27,"وَقَلِيلٞ مِّنَ اَ۬لۡأٓخِرِينَ ﰏ"],
[17,534,27,"عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ ﰐ"],
[18,534,27,"مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ ﰑ"],
[19,535,27,"يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ ﰒ"],
[20,535,27,"بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ ﰓ"],
[21,535,27,"لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزَفُونَ ﰔ"],
[22,535,27,"وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ ﰕ"],
[23,535,27,"وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ ﰖ"],
[24,535,27,"وَحُورٌ عِينٞ ﰗ"],
[25,535,27,"كَأَمۡثَٰلِ اِ۬للُّؤۡلُوِٕ اِ۬لۡمَكۡنُونِ ﰘ"],
[26,535,27,"جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ ﰙ"],
[27,535,27,"لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا ﰚ"],
[28,535,27,"وَأَصۡحَٰبُ اُ۬لۡيَمِينِ ﰛ"],
[29,535,27,"مَآ أَصۡحَٰبُ اُ۬لۡيَمِينِ ﰜ"],
[30,535,27,"فِي سِدۡرٖ مَّخۡضُودٖ ﰝ"],
[31,535,27,"وَطَلۡحٖ مَّنضُودٖ ﰞ"],
[32,535,27,"وَظِلّٖ مَّمۡدُودٖ ﰟ"],
[33,535,27,"وَمَآءٖ مَّسۡكُوبٖ ﰠ"],
[34,535,27,"وَفَٰكِهَةٖ كَثِيرَةٖ ﰡ"],
[35,535,27,"لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ ﰢ"],
[36,535,27,"وَفُرُشٖ مَّرۡفُوعَةٍ ﰣ"],
[37,535,27,"إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءٗ ﰤ"],
[38,535,27,"فَجَعَلۡنَٰهُنَّ أَبۡكَارًا ﰥ"],
[39,535,27,"عُرُبًا أَتۡرَابٗا ﰦ"],
[40,535,27,"لِّأَصۡحَٰبِ اِ۬لۡيَمِينِ ﰧ"],
[41,535,27,"۞ ثُلَّةٞ مِّنَ اَ۬لۡأَوَّلِينَ ﰨ"],
[42,535,27,"وَثُلَّةٞ مِّنَ اَ۬لۡأٓخِرِينَ ﰩ"],
[43,535,27,"وَأَصۡحَٰبُ اُ۬لشِّمَالِ ﰪ"],
[44,535,27,"مَآ أَصۡحَٰبُ اُ۬لشِّمَالِ ﰫ"],
[45,535,27,"فِي سَمُومٖ وَحَمِيمٖ ﰬ"],
[46,535,27,"وَظِلّٖ مِّن يَحۡمُومٖ ﰭ"],
[47,535,27,"لَّا بَارِدٖ وَلَا كَرِيمٍ ﰮ"],
[48,535,27,"إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ ﰯ"],
[49,535,27,"وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لۡحِنثِ اِ۬لۡعَظِيمِ ﰰ"],
[50,535,27,"وَكَانُواْ يَقُولُونَ أَٰى۪ذَا مُتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَٰ۟نَّا لَمَبۡعُوثُونَ ﰱ"],
[51,535,27,"أَوَءَابَآؤُنَا اَ۬لۡأَوَّلُونَ ﰲ"],
[52,535,27,"قُلۡ إِنَّ اَ۬لۡأَوَّلِينَ وَاَلۡأٓخِرِينَ ﰳ"],
[53,535,27,"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ ﰴ"],
[54,536,27,"ثُمَّ إِنَّكُمۡ أَيُّهَا اَ۬لضَّآلُّونَ اَ۬لۡمُكَذِّبُونَ ﰵ"],
[55,536,27,"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ ﰶ"],
[56,536,27,"فَمَالِـُٔونَ مِنۡهَا اَ۬لۡبُطُونَ ﰷ"],
[57,536,27,"فَشَٰرِبُونَ عَلَيۡهِ مِنَ اَ۬لۡحَمِيمِ ﰸ"],
[58,536,27,"فَشَٰرِبُونَ شَرۡبَ اَ۬لۡهِيمِ ﰹ"],
[59,536,27,"هَٰذَا نُزُلُهُمۡ يَوۡمَ اَ۬لدِّينِ ﰺ"],
[60,536,27,"نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ ﰻ"],
[61,536,27,"أَفَرَءَيۡتُم مَّا تُمۡنُونَ ﰼ"],
[62,536,27,"ءَٰا۬نتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ اُ۬لۡخَٰلِقُونَ ﰽ"],
[63,536,27,"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ اُ۬لۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ﰾ"],
[64,536,27,"عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ ﰿ"],
[65,536,27,"وَلَقَدۡ عَلِمۡتُمُ اُ۬لنَّشَآءَةَ اَ۬لۡأُولۭيٰ فَلَوۡلَا تَذَّكَّرُونَ ﱀ"],
[66,536,27,"أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ ﱁ"],
[67,536,27,"ءَٰا۬نتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ اُ۬لزَّٰرِعُونَ ﱂ"],
[68,536,27,"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ ﱃ"],
[69,536,27,"إِنَّا لَمُغۡرَمُونَ ﱄ"],
[70,536,27,"بَلۡ نَحۡنُ مَحۡرُومُونَ ﱅ"],
[71,536,27,"أَفَرَءَيۡتُمُ اُ۬لۡمَآءَ اَ۬لَّذِي تَشۡرَبُونَ ﱆ"],
[72,536,27,"ءَٰا۬نتُمۡ أَنزَلۡتُمُوهُ مِنَ اَ۬لۡمُزۡنِ أَمۡ نَحۡنُ اُ۬لۡمُنزِلُونَ ﱇ"],
[73,536,27,"لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ ﱈ"],
[74,536,27,"أَفَرَءَيۡتُمُ اُ۬لنَّارَ اَ۬لَّتِي تُورُونَ ﱉ"],
[75,536,27,"ءَٰا۬نتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ اُ۬لۡمُنشِـُٔونَ ﱊ"],
[76,536,27,"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ ﱋ"],
[77,536,27,"فَسَبِّحۡ بِاسۡمِ رَبِّكَ اَ۬لۡعَظِيمِ ﱌ"],
[78,536,27,"۞ فَلَآ أُقۡسِمُ بِمَوَٰقِعِ اِ۬لنُّجُومِ ﱍ"],
[79,536,27,"وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ ﱎ"],
[80,537,27,"إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ ﱏ"],
[81,537,27,"فِي كِتَٰبٖ مَّكۡنُونٖ ﱐ"],
[82,537,27,"لَّا يَمَسُّهُۥٓ إِلَّا اَ۬لۡمُطَهَّرُونَ ﱑ"],
[83,537,27,"تَنزِيلٞ مِّن رَّبِّ اِ۬لۡعَٰلَمِينَ ﱒ"],
[84,537,27,"أَفَبِهَٰذَا اَ۬لۡحَدِيثِ أَنتُم مُّدۡهِنُونَ ﱓ"],
[85,537,27,"وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ ﱔ"],
[86,537,27,"فَلَوۡلَآ إِذَا بَلَغَتِ اِ۬لۡحُلۡقُومَ ﱕ"],
[87,537,27,"وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ ﱖ"],
[88,537,27,"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ ﱗ"],
[89,537,27,"فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ ﱘ"],
[90,537,27,"تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ ﱙ"],
[91,537,27,"فَأَمَّآ إِن كَانَ مِنَ اَ۬لۡمُقَرَّبِينَ ﱚ"],
[92,537,27,"فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ ﱛ"],
[93,537,27,"وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ اِ۬لۡيَمِينِ ﱜ"],
[94,537,27,"فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ اِ۬لۡيَمِينِ ﱝ"],
[95,537,27,"وَأَمَّآ إِن كَانَ مِنَ اَ۬لۡمُكَذِّبِينَ اَ۬لضَّآلِّينَ ﱞ"],
[96,537,27,"فَنُزُلٞ مِّنۡ حَمِيمٖ ﱟ"],
[97,537,27,"وَتَصۡلِيَةُ جَحِيمٍ ﱠ"],
[98,537,27,"إِنَّ هَٰذَا لَهۡوَ حَقُّ اُ۬لۡيَقِينِ ﱡ"],
[99,537,27,"فَسَبِّحۡ بِاسۡمِ رَبِّكَ اَ۬لۡعَظِيمِ ﱢ"]
]}
