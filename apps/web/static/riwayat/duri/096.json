{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":96,"name":"العَلَق ","t":[
[1,597,30,"اِ۪قۡرَأۡ بِاسۡمِ رَبِّكَ اَ۬لَّذِي خَلَقَ ﰀ"],
[2,597,30,"خَلَقَ اَ۬لۡإِنسَٰنَ مِنۡ عَلَقٍ ﰁ"],
[3,597,30,"اِ۪قۡرَأۡ وَرَبُّكَ اَ۬لۡأَكۡرَمُ ﰂ"],
[4,597,30,"اُ۬لَّذِي عَلَّمَ بِالۡقَلَمِ ﰃ"],
[5,597,30,"عَلَّمَ اَ۬لۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ ﰄ"],
[6,597,30,"كَلَّآ إِنَّ اَ۬لۡإِنسَٰنَ لَيَطۡغۭيٰٓ ﰅ"],
[7,597,30,"أَن رَّء۪اهُ اُ۪سۡتَغۡنۭيٰٓ ﰆ"],
[8,597,30,"إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجۡعۭيٰٓ ﰇ"],
[9,597,30,"أَرَءَيۡتَ اَ۬لَّذِي يَنۡهۭيٰ ﰈ"],
[10,597,30,"عَبۡدًا إِذَا صَلّۭيٰٓ ﰉ"],
[11,597,30,"أَرَءَيۡتَ إِن كَانَ عَلَى اَ۬لۡهُدۭيٰٓ ﰊ"],
[12,597,30,"أَوۡ أَمَرَ بِالتَّقۡوۭيٰٓ ﰋ"],
[13,598,30,"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلّۭيٰٓ ﰌ"],
[14,598,30,"أَلَمۡ يَعۡلَم بِأَنَّ اَ۬للَّهَ يَر۪يٰ ﰍ"],
[15,598,30,"كَلَّا لَئِن لَّمۡ يَنتَهِ ﰎ"],
[16,598,30,"لَنَسۡفَعَۢا بِالنَّاصِيَةِ ﰏ"],
[17,598,30,"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ ﰐ"],
[18,598,30,"فَلۡيَدۡعُ نَادِيَهُۥ ﰑ"],
[19,598,30,"سَنَدۡعُ اُ۬لزَّبَانِيَةَ ﰒ"],
[20,598,30,"كَلَّا لَا تُطِعۡهُ وَاَسۡجُدۡۤ وَاَقۡتَرِب۩ ﰓ"]
]}
