{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":100,"name":"العَاديَات ","t":[
[1,599,30,"وَاَلۡعَٰدِيَٰتِ ضَبۡحٗا ﰀ"],
[2,599,30,"فَاَلۡمُورِيَٰتِ قَدۡحٗا ﰁ"],
[3,599,30,"فَاَلۡمُغِيرَٰتِ صُبۡحٗا ﰂ"],
[4,599,30,"فَأَثَرۡنَ بِهِۦ نَقۡعٗا ﰃ"],
[5,599,30,"فَوَسَطۡنَ بِهِۦ جَمۡعًا ﰄ"],
[6,600,30,"إِنَّ اَ۬لۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ﰅ"],
[7,600,30,"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ﰆ"],
[8,600,30,"وَإِنَّهُۥ لِحُبِّ اِ۬لۡخَيۡرِ لَشَدِيدٌ ﰇ"],
[9,600,30,"۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي اِ۬لۡقُبُورِ ﰈ"],
[10,600,30,"وَحُصِّلَ مَا فِي اِ۬لصُّدُورِ ﰉ"],
[11,600,30,"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ ﰊ"]
]}
