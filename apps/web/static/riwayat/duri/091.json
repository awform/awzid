{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":91,"name":"الشَّمس ","t":[
[1,595,30,"وَاَلشَّمۡسِ وَضُحۭىٰهَا ﰀ"],
[2,595,30,"وَاَلۡقَمَرِ إِذَا تَلۭىٰهَا ﰁ"],
[3,595,30,"وَاَلنَّه۪ارِ إِذَا جَلّۭىٰهَا ﰂ"],
[4,595,30,"وَاَلَّيۡلِ إِذَا يَغۡشۭىٰهَا ﰃ"],
[5,595,30,"وَاَلسَّمَآءِ وَمَا بَنۭىٰهَا ﰄ"],
[6,595,30,"وَاَلۡأَرۡضِ وَمَا طَحۭىٰهَا ﰅ"],
[7,595,30,"وَنَفۡسٖ وَمَا سَوّۭىٰهَا ﰆ"],
[8,595,30,"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوۭىٰهَا ﰇ"],
[9,595,30,"قَدۡ أَفۡلَحَ مَن زَكّۭىٰهَا ﰈ"],
[10,595,30,"وَقَدۡ خَابَ مَن دَسّۭىٰهَا ﰉ"],
[11,595,30,"كَذَّبَت ثَّمُودُ بِطَغۡوۭىٰهَآ ﰊ"],
[12,595,30,"إِذِ اِ۪نۢبَعَثَ أَشۡقۭىٰهَا ﰋ"],
[13,595,30,"فَقَالَ لَهُمۡ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقۡيٰۭهَا ﰌ"],
[14,595,30,"فَكَذَّبُوهُ فَعَقَرُوهَا ﰍ"],
[15,595,30,"فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوّۭىٰهَا ﰎ"],
[16,595,30,"وَلَا يَخَافُ عُقۡبٰۭهَا ﰏ"]
]}
