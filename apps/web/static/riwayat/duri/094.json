{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":94,"name":"الشَّرح ","t":[
[1,596,30,"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ ﰀ"],
[2,596,30,"وَوَضَعۡنَا عَنكَ وِزۡرَكَ ﰁ"],
[3,597,30,"اَ۬لَّذِيٓ أَنقَضَ ظَهۡرَكَ ﰂ"],
[4,597,30,"وَرَفَعۡنَا لَكَ ذِكۡرَكَ ﰃ"],
[5,597,30,"فَإِنَّ مَعَ اَ۬لۡعُسۡرِ يُسۡرًا ﰄ"],
[6,597,30,"إِنَّ مَعَ اَ۬لۡعُسۡرِ يُسۡرٗا ﰅ"],
[7,597,30,"فَإِذَا فَرَغۡتَ فَاَنصَبۡ ﰆ"],
[8,597,30,"وَإِلَىٰ رَبِّكَ فَاَرۡغَب ﰇ"]
]}
