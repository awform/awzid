{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":93,"name":"الضُّحى ","t":[
[1,596,30,"وَاَلضُّحۭيٰ ﰀ"],
[2,596,30,"وَاَلَّيۡلِ إِذَا سَجۭيٰ ﰁ"],
[3,596,30,"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلۭيٰ ﰂ"],
[4,596,30,"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ اَ۬لۡأُولۭيٰ ﰃ"],
[5,596,30,"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضۭيٰٓ ﰄ"],
[6,596,30,"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوۭيٰ ﰅ"],
[7,596,30,"وَوَجَدَكَ ضَآلّٗا فَهَدۭيٰ ﰆ"],
[8,596,30,"وَوَجَدَكَ عَآئِلٗا فَأَغۡنۭيٰ ﰇ"],
[9,596,30,"فَأَمَّا اَ۬لۡيَتِيمَ فَلَا تَقۡهَرۡ ﰈ"],
[10,596,30,"وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنۡهَرۡ ﰉ"],
[11,596,30,"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ ﰊ"]
]}
