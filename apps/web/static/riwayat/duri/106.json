{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":106,"name":"قُرَيش ","t":[
[1,602,30,"لِإِيلَٰفِ قُرَيۡشٍ ﰀ"],
[2,602,30,"إِۦلَٰفِهِمۡ رِحۡلَةَ اَ۬لشِّتَآءِ وَاَلصَّيۡفِ ﰁ"],
[3,602,30,"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا اَ۬لۡبَيۡتِ ﰂ"],
[4,602,30,"اِ۬لَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ ﰃ"],
[5,602,30,"وَءَامَنَهُم مِّنۡ خَوۡفِۢ ﰄ"]
