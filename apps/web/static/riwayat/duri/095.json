{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":95,"name":"التِّين ","t":[
[1,597,30,"وَاَلتِّينِ وَاَلزَّيۡتُونِ ﰀ"],
[2,597,30,"وَطُورِ سِينِينَ ﰁ"],
[3,597,30,"وَهَٰذَا اَ۬لۡبَلَدِ اِ۬لۡأَمِينِ ﰂ"],
[4,597,30,"لَقَدۡ خَلَقۡنَا اَ۬لۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ ﰃ"],
[5,597,30,"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ ﰄ"],
[6,597,30,"إِلَّا اَ۬لَّذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ ﰅ"],
[7,597,30,"فَمَا يُكَذِّبُكَ بَعۡدُ بِالدِّينِ ﰆ"],
[8,597,30,"أَلَيۡسَ اَ۬للَّهُ بِأَحۡكَمِ اِ۬لۡحَٰكِمِينَ ﰇ"]
]}
