{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":55,"name":"الرَّحمٰن ","t":[
[1,531,27,"اِ۬لرَّحۡمَٰنُ عَلَّمَ اَ۬لۡقُرۡءَانَ ﰀ"],
[2,531,27,"خَلَقَ اَ۬لۡإِنسَٰنَ عَلَّمَهُ اُ۬لۡبَيَانَ ﰁ"],
[3,531,27,"اَ۬لشَّمۡسُ وَاَلۡقَمَرُ بِحُسۡبَانٖ ﰂ"],
[4,531,27,"وَاَلنَّجۡمُ وَاَلشَّجَرُ يَسۡجُدَانِ ﰃ"],
[5,531,27,"وَاَلسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لۡمِيزَانَ ﰄ"],
[6,531,27,"أَلَّا تَطۡغَوۡاْ فِي اِ۬لۡمِيزَانِ ﰅ"],
[7,531,27,"وَأَقِيمُواْ اُ۬لۡوَزۡنَ بِالۡقِسۡطِ وَلَا تُخۡسِرُواْ اُ۬لۡمِيزَانَ ﰆ"],
[8,531,27,"وَاَلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ ﰇ"],
[9,531,27,"فِيهَا فَٰكِهَةٞ وَاَلنَّخۡلُ ذَاتُ اُ۬لۡأَكۡمَامِ ﰈ"],
[10,531,27,"وَاَلۡحَبُّ ذُو اُ۬لۡعَصۡفِ وَاَلرَّيۡحَانُ ﰉ"],
[11,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰊ"],
[12,531,27,"خَلَقَ اَ۬لۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَاَلۡفَخّ۪ارِ ﰋ"],
[13,531,27,"وَخَلَقَ اَ۬لۡجَآنَّ مِن مَّارِجٖ مِّن نّ۪ارٖ ﰌ"],
[14,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰍ"],
[15,531,27,"رَبُّ اُ۬لۡمَشۡرِقَيۡنِ وَرَبُّ اُ۬لۡمَغۡرِبَيۡنِ ﰎ"],
[16,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰏ"],
[17,532,27,"مَرَجَ اَ۬لۡبَحۡرَيۡنِ يَلۡتَقِيَانِ ﰐ"],
[18,532,27,"بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ ﰑ"],
[19,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰒ"],
[20,532,27,"يُخۡرَجُ مِنۡهُمَا اَ۬للُّؤۡلُؤُ وَاَلۡمَرۡجَانُ ﰓ"],
[21,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰔ"],
[22,532,27,"وَلَهُ اُ۬لۡجَوَارِ اِ۬لۡمُنشَـَٔاتُ فِي اِ۬لۡبَحۡرِ كَاَلۡأَعۡلَٰمِ ﰕ"],
[23,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰖ"],
[24,532,27,"كُلُّ مَنۡ عَلَيۡهَا فَانٖ ﰗ"],
[25,532,27,"وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو اُ۬لۡجَلَٰلِ وَاَلۡإِكۡرَامِ ﰘ"],
[26,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰙ"],
[27,532,27,"يَسۡـَٔلُهُۥ مَن فِي اِ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ ﰚ"],
[28,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰛ"],
[29,532,27,"سَنَفۡرُغُ لَكُمۡ أَيُّهَ اَ۬لثَّقَلَانِ ﰜ"],
[30,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰝ"],
[31,532,27,"يَٰمَعۡشَرَ اَ۬لۡجِنِّ وَاَلۡإِنسِ إِنِ اِ۪سۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡط۪ارِ اِ۬لسَّمَٰوَٰتِ وَاَلۡأَرۡضِ فَاَنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ ﰞ"],
[32,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰟ"],
[33,532,27,"يُرۡسَلُ عَلَيۡكُمَا شُوَاظٞ مِّن نّ۪ارٖ ﰠ"],
[34,532,27,"وَنُحَاسٖ فَلَا تَنتَصِرَانِ ﰡ"],
[35,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰢ"],
[36,532,27,"فَإِذَا اَ۪نشَقَّتِ اِ۬لسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَاَلدِّهَانِ ﰣ"],
[37,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰤ"],
[38,532,27,"فَيَوۡمَئِذٖ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞ ﰥ"],
[39,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰦ"],
[40,532,27,"۞ يُعۡرَفُ اُ۬لۡمُجۡرِمُونَ بِسِيمٰۭهُمۡ فَيُؤۡخَذُ بِالنَّوَٰصِي وَاَلۡأَقۡدَامِ ﰧ"],
[41,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰨ"],
[42,533,27,"هَٰذِهِۦ جَهَنَّمُ اُ۬لَّتِي يُكَذِّبُ بِهَا اَ۬لۡمُجۡرِمُونَ ﰩ"],
[43,533,27,"يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ ﰪ"],
[44,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰫ"],
[45,533,27,"وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ ﰬ"],
[46,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰭ"],
[47,533,27,"ذَوَاتَآ أَفۡنَانٖ ﰮ"],
[48,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰯ"],
[49,533,27,"فِيهِمَا عَيۡنَانِ تَجۡرِيَانِ ﰰ"],
[50,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰱ"],
[51,533,27,"فِيهِمَا مِن كُلِّ فَٰكِهَةٖ زَوۡجَانِ ﰲ"],
[52,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰳ"],
[53,533,27,"مُتَّكِـِٔينَ عَلَىٰ فُرُشِۢ بَطَآئِنُهَا مِنۡ إِسۡتَبۡرَقٖۚ وَجَنَى اَ۬لۡجَنَّتَيۡنِ دَانٖ ﰴ"],
[54,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰵ"],
[55,533,27,"فِيهِنَّ قَٰصِرَٰتُ اُ۬لطَّرۡفِ لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ ﰶ"],
[56,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰷ"],
[57,533,27,"كَأَنَّهُنَّ اَ۬لۡيَاقُوتُ وَاَلۡمَرۡجَانُ ﰸ"],
[58,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰹ"],
[59,533,27,"هَلۡ جَزَآءُ اُ۬لۡإِحۡسَٰنِ إِلَّا اَ۬لۡإِحۡسَٰنُ ﰺ"],
[60,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰻ"],
[61,533,27,"وَمِن دُونِهِمَا جَنَّتَانِ ﰼ"],
[62,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰽ"],
[63,533,27,"مُدۡهَآمَّتَانِ ﰾ"],
[64,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰿ"],
[65,533,27,"فِيهِمَا عَيۡنَانِ نَضَّاخَتَانِ ﱀ"],
[66,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﱁ"],
[67,533,27,"فِيهِمَا فَٰكِهَةٞ وَنَخۡلٞ وَرُمَّانٞ ﱂ"],
[68,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﱃ"],
[69,534,27,"فِيهِنَّ خَيۡرَٰتٌ حِسَانٞ ﱄ"],
[70,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﱅ"],
[71,534,27,"۞ حُورٞ مَّقۡصُورَٰتٞ فِي اِ۬لۡخِيَامِ ﱆ"],
[72,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﱇ"],
[73,534,27,"لَمۡ يَطۡمِثۡهُنَّ إِنسٞ قَبۡلَهُمۡ وَلَا جَآنّٞ ﱈ"],
[74,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﱉ"],
[75,534,27,"مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرٖ وَعَبۡقَرِيٍّ حِسَانٖ ﱊ"],
[76,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﱋ"],
[77,534,27,"تَبَٰرَكَ اَ۪سۡمُ رَبِّكَ ذِي اِ۬لۡجَلَٰلِ وَاَلۡإِكۡرَامِ ﱌ"]
]}
