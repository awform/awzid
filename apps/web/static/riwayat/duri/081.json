{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":81,"name":"التَّكوير ","t":[
[1,586,30,"إِذَا اَ۬لشَّمۡسُ كُوِّرَتۡ ﰀ"],
[2,586,30,"وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتۡ ﰁ"],
[3,586,30,"وَإِذَا اَ۬لۡجِبَالُ سُيِّرَتۡ ﰂ"],
[4,586,30,"وَإِذَا اَ۬لۡعِشَارُ عُطِّلَتۡ ﰃ"],
[5,586,30,"وَإِذَا اَ۬لۡوُحُوشُ حُشِرَتۡ ﰄ"],
[6,586,30,"وَإِذَا اَ۬لۡبِحَارُ سُجِرَتۡ ﰅ"],
[7,586,30,"وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتۡ ﰆ"],
[8,586,30,"وَإِذَا اَ۬لۡمَوۡءُۥدَةُ سُئِلَتۡ ﰇ"],
[9,586,30,"بِأَيِّ ذَنۢبٖ قُتِلَتۡ ﰈ"],
[10,586,30,"وَإِذَا اَ۬لصُّحُفُ نُشِّرَتۡ ﰉ"],
[11,586,30,"وَإِذَا اَ۬لسَّمَآءُ كُشِطَتۡ ﰊ"],
[12,586,30,"وَإِذَا اَ۬لۡجَحِيمُ سُعِرَتۡ ﰋ"],
[13,586,30,"وَإِذَا اَ۬لۡجَنَّةُ أُزۡلِفَتۡ ﰌ"],
[14,586,30,"عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ ﰍ"],
[15,586,30,"فَلَآ أُقۡسِمُ بِالۡخُنَّسِ ﰎ"],
[16,586,30,"اِ۬لۡجَوَارِ اِ۬لۡكُنَّسِ ﰏ"],
[17,586,30,"وَاَلَّيۡلِ إِذَا عَسۡعَسَ ﰐ"],
[18,586,30,"وَاَلصُّبۡحِ إِذَا تَنَفَّسَ ﰑ"],
[19,586,30,"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ﰒ"],
[20,586,30,"ذِي قُوَّةٍ عِندَ ذِي اِ۬لۡعَرۡشِ مَكِينٖ ﰓ"],
[21,586,30,"مُّطَاعٖ ثَمَّ أَمِينٖ ﰔ"],
[22,586,30,"وَمَا صَاحِبُكُم بِمَجۡنُونٖ ﰕ"],
[23,586,30,"وَلَقَدۡ رَء۪اهُ بِالۡأُفُقِ اِ۬لۡمُبِينِ ﰖ"],
[24,586,30,"وَمَا هُوَ عَلَى اَ۬لۡغَيۡبِ بِضظَنِينٖ ﰗ"],
[25,586,30,"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ ﰘ"],
[26,586,30,"فَأَيۡنَ تَذۡهَبُونَ ﰙ"],
[27,586,30,"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ ﰚ"],
[28,586,30,"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ ﰛ"],
[29,586,30,"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ اَ۬للَّهُ رَبُّ اُ۬لۡعَٰلَمِينَ ﰜ"]
]}
