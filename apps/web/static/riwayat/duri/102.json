{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":102,"name":"التَّكاثُر ","t":[
[1,600,30,"أَلۡهَىٰكُمُ اُ۬لتَّكَاثُرُ ﰀ"],
[2,600,30,"حَتَّىٰ زُرۡتُمُ اُ۬لۡمَقَابِرَ ﰁ"],
[3,600,30,"كَلَّا سَوۡفَ تَعۡلَمُونَ ﰂ"],
[4,600,30,"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ ﰃ"],
[5,600,30,"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ اَ۬لۡيَقِينِ ﰄ"],
[6,600,30,"لَتَرَوُنَّ اَ۬لۡجَحِيمَ ﰅ"],
[7,600,30,"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ اَ۬لۡيَقِينِ ﰆ"],
[8,600,30,"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ اِ۬لنَّعِيمِ ﰇ"]
]}
