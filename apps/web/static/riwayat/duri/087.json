{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":87,"name":"الأعلى ","t":[
[1,591,30,"سَبِّحِ اِ۪سۡمَ رَبِّكَ اَ۬لۡأَعۡلَى ﰀ"],
[2,591,30,"اَ۬لَّذِي خَلَقَ فَسَوّۭيٰ ﰁ"],
[3,591,30,"وَاَلَّذِي قَدَّرَ فَهَدۭيٰ ﰂ"],
[4,591,30,"وَاَلَّذِيٓ أَخۡرَجَ اَ۬لۡمَرۡعۭيٰ ﰃ"],
[5,591,30,"فَجَعَلَهُۥ غُثَآءً أَحۡوۭيٰ ﰄ"],
[6,591,30,"سَنُقۡرِئُكَ فَلَا تَنسۭيٰٓ ﰅ"],
[7,591,30,"إِلَّا مَا شَآءَ اَ۬للَّهُۚ إِنَّهُۥ يَعۡلَمُ اُ۬لۡجَهۡرَ وَمَا يَخۡفۭيٰ ﰆ"],
[8,591,30,"وَنُيَسِّرُكَ لِلۡيُسۡر۪يٰ ﰇ"],
[9,591,30,"فَذَكِّرۡ إِن نَّفَعَتِ اِ۬لذِّكۡر۪يٰ ﰈ"],
[10,591,30,"سَيَذَّكَّرُ مَن يَخۡشۭيٰ ﰉ"],
[11,592,30,"وَيَتَجَنَّبُهَا اَ۬لۡأَشۡقَى ﰊ"],
[12,592,30,"اَ۬لَّذِي يَصۡلَى اَ۬لنَّارَ اَ۬لۡكُبۡر۪يٰ ﰋ"],
[13,592,30,"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيۭيٰ ﰌ"],
[14,592,30,"قَدۡ أَفۡلَحَ مَن تَزَكّۭيٰ ﰍ"],
[15,592,30,"وَذَكَرَ اَ۪سۡمَ رَبِّهِۦ فَصَلّۭيٰ ﰎ"],
[16,592,30,"بَلۡ يُؤۡثِرُونَ اَ۬لۡحَيَوٰةَ اَ۬لدُّنۡيۭا ﰏ"],
[17,592,30,"وَاَلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقۭيٰٓ ﰐ"],
[18,592,30,"إِنَّ هَٰذَا لَفِي اِ۬لصُّحُفِ اِ۬لۡأُولۭيٰ ﰑ"],
[19,592,30,"صُحُفِ إِبۡرَٰهِيمَ وَمُوسۭيٰ ﰒ"]
]}
