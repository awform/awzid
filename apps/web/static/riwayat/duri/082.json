{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":82,"name":"الانفِطَار ","t":[
[1,587,30,"إِذَا اَ۬لسَّمَآءُ اُ۪نفَطَرَتۡ ﰀ"],
[2,587,30,"وَإِذَا اَ۬لۡكَوَاكِبُ اُ۪نتَثَرَتۡ ﰁ"],
[3,587,30,"وَإِذَا اَ۬لۡبِحَارُ فُجِّرَتۡ ﰂ"],
[4,587,30,"وَإِذَا اَ۬لۡقُبُورُ بُعۡثِرَتۡ ﰃ"],
[5,587,30,"عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ ﰄ"],
[6,587,30,"يَٰٓأَيُّهَا اَ۬لۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ اَ۬لۡكَرِيمِ ﰅ"],
[7,587,30,"اِ۬لَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَّلَكَ ﰆ"],
[8,587,30,"فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ ﰇ"],
[9,587,30,"كَلَّا بَلۡ تُكَذِّبُونَ بِالدِّينِ ﰈ"],
[10,587,30,"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ ﰉ"],
[11,587,30,"كِرَامٗا كَٰتِبِينَ ﰊ"],
[12,587,30,"يَعۡلَمُونَ مَا تَفۡعَلُونَ ﰋ"],
[13,587,30,"إِنَّ اَ۬لۡأَبۡرَارَ لَفِي نَعِيمٖ ﰌ"],
[14,587,30,"وَإِنَّ اَ۬لۡفُجَّارَ لَفِي جَحِيمٖ ﰍ"],
[15,587,30,"يَصۡلَوۡنَهَا يَوۡمَ اَ۬لدِّينِ ﰎ"],
[16,587,30,"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ ﰏ"],
[17,587,30,"وَمَآ أَدۡر۪ىٰكَ مَا يَوۡمُ اُ۬لدِّينِ ﰐ"],
[18,587,30,"ثُمَّ مَآ أَدۡر۪ىٰكَ مَا يَوۡمُ اُ۬لدِّينِ ﰑ"],
[19,587,30,"يَوۡمُ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَاَلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ ﰒ"]
]}
