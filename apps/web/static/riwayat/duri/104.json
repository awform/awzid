{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":104,"name":"الهُمَزة ","t":[
[1,601,30,"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ ﰀ"],
[2,601,30,"اِ۬لَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ ﰁ"],
[3,601,30,"يَحۡسِبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ ﰂ"],
[4,601,30,"كَلَّاۖ لَيُنۢبَذَنَّ فِي اِ۬لۡحُطَمَةِ ﰃ"],
[5,601,30,"وَمَآ أَدۡر۪ىٰكَ مَا اَ۬لۡحُطَمَةُ ﰄ"],
[6,601,30,"نَارُ اُ۬للَّهِ اِ۬لۡمُوقَدَةُ ﰅ"],
[7,601,30,"اُ۬لَّتِي تَطَّلِعُ عَلَى اَ۬لۡأَفۡـِٔدَةِ ﰆ"],
[8,601,30,"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ ﰇ"],
[9,601,30,"فِي عَمَدٖ مُّمَدَّدَةِۢ ﰈ"]
]}
