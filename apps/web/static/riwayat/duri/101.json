{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":101,"name":"القَارعَة ","t":[
[1,600,30,"اِ۬لۡقَارِعَةُ مَا اَ۬لۡقَارِعَةُ ﰀ"],
[2,600,30,"وَمَآ أَدۡر۪ىٰكَ مَا اَ۬لۡقَارِعَةُ ﰁ"],
[3,600,30,"يَوۡمَ يَكُونُ اُ۬لنَّاسُ كَاَلۡفَرَاشِ اِ۬لۡمَبۡثُوثِ ﰂ"],
[4,600,30,"وَتَكُونُ اُ۬لۡجِبَالُ كَاَلۡعِهۡنِ اِ۬لۡمَنفُوشِ ﰃ"],
[5,600,30,"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ ﰄ"],
[6,600,30,"فَهۡوَ فِي عِيشَةٖ رَّاضِيَةٖ ﰅ"],
[7,600,30,"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ ﰆ"],
[8,600,30,"فَأُمُّهُۥ هَاوِيَةٞ ﰇ"],
[9,600,30,"وَمَآ أَدۡر۪ىٰكَ مَا هِيَهۡ ﰈ"],
[10,600,30,"نَارٌ حَامِيَةُۢ ﰉ"]
]}
