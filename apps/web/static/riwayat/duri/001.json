{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":1,"name":"الفَاتِحة ","t":[
[1,1,1,"اِ۬لۡحَمۡدُ لِلَّهِ رَبِّ اِ۬لۡعَٰلَمِينَ ﰀ"],
[2,1,1,"اَ۬لرَّحۡمَٰنِ اِ۬لرَّحِيمِ ﰁ"],
[3,1,1,"مَلِكِ يَوۡمِ اِ۬لدِّينِ ﰂ"],
[4,1,1,"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ ﰃ"],
[5,1,1,"اُ۪هۡدِنَا اَ۬لصِّرَٰطَ اَ۬لۡمُسۡتَقِيمَ ﰄ"],
[6,1,1,"صِرَٰطَ اَ۬لَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ ﰅ"],
[7,1,1,"غَيۡرِ اِ۬لۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا اَ۬لضَّآلِّينَ ﰆ"]
]}
