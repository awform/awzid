{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":80,"name":"عَبَسَ ","t":[
[1,585,30,"عَبَسَ وَتَوَلّۭيٰٓ ﰀ"],
[2,585,30,"أَن جَآءَهُ اُ۬لۡأَعۡمۭيٰ ﰁ"],
[3,585,30,"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكّۭيٰٓ ﰂ"],
[4,585,30,"أَوۡ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكۡر۪يٰٓ ﰃ"],
[5,585,30,"أَمَّا مَنِ اِ۪سۡتَغۡنۭيٰ ﰄ"],
[6,585,30,"فَأَنتَ لَهُۥ تَصَدّۭيٰ ﰅ"],
[7,585,30,"وَمَا عَلَيۡكَ أَلَّا يَزَّكّۭيٰ ﰆ"],
[8,585,30,"وَأَمَّا مَن جَآءَكَ يَسۡعۭيٰ ﰇ"],
[9,585,30,"وَهۡوَ يَخۡشۭيٰ ﰈ"],
[10,585,30,"فَأَنتَ عَنۡهُ تَلَهّۭيٰ ﰉ"],
[11,585,30,"كَلَّآ إِنَّهَا تَذۡكِرَةٞ ﰊ"],
[12,585,30,"فَمَن شَآءَ ذَكَرَهُۥ ﰋ"],
[13,585,30,"فِي صُحُفٖ مُّكَرَّمَةٖ ﰌ"],
[14,585,30,"مَّرۡفُوعَةٖ مُّطَهَّرَةِۢ ﰍ"],
[15,585,30,"بِأَيۡدِي سَفَرَةٖ ﰎ"],
[16,585,30,"كِرَامِۢ بَرَرَةٖ ﰏ"],
[17,585,30,"قُتِلَ اَ۬لۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ ﰐ"],
[18,585,30,"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ ﰑ"],
[19,585,30,"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ﰒ"],
[20,585,30,"ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ ﰓ"],
[21,585,30,"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ ﰔ"],
[22,585,30,"ثُمَّ إِذَا شَآ أَنشَرَهُۥ ﰕ"],
[23,585,30,"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ ﰖ"],
[24,585,30,"فَلۡيَنظُرِ اِ۬لۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ ﰗ"],
[25,585,30,"إِنَّا صَبَبۡنَا اَ۬لۡمَآءَ صَبّٗا ﰘ"],
[26,585,30,"ثُمَّ شَقَقۡنَا اَ۬لۡأَرۡضَ شَقّٗا ﰙ"],
[27,585,30,"فَأَنۢبَتۡنَا فِيهَا حَبّٗا ﰚ"],
[28,585,30,"وَعِنَبٗا وَقَضۡبٗا ﰛ"],
[29,585,30,"وَزَيۡتُونٗا وَنَخۡلٗا ﰜ"],
[30,585,30,"وَحَدَآئِقَ غُلۡبٗا ﰝ"],
[31,585,30,"وَفَٰكِهَةٗ وَأَبّٗا ﰞ"],
[32,585,30,"مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ﰟ"],
[33,585,30,"فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ ﰠ"],
[34,585,30,"يَوۡمَ يَفِرُّ اُ۬لۡمَرۡءُ مِنۡ أَخِيهِ ﰡ"],
[35,585,30,"وَأُمِّهِۦ وَأَبِيهِ ﰢ"],
[36,585,30,"وَصَٰحِبَتِهِۦ وَبَنِيهِ ﰣ"],
[37,585,30,"لِكُلِّ اِ۪مۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ ﰤ"],
[38,585,30,"۞ وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ ﰥ"],
[39,585,30,"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ ﰦ"],
[40,585,30,"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ ﰧ"],
[41,586,30,"تَرۡهَقُهَا قَتَرَةٌ ﰨ"],
[42,586,30,"أُوْلَٰٓئِكَ هُمُ اُ۬لۡكَفَرَةُ اُ۬لۡفَجَرَةُ ﰩ"]
]}
