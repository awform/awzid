{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":92,"name":"اللَّيل ","t":[
[1,595,30,"وَاَلَّيۡلِ إِذَا يَغۡشۭيٰ ﰀ"],
[2,595,30,"وَاَلنَّه۪ارِ إِذَا تَجَلّۭيٰ ﰁ"],
[3,595,30,"وَمَا خَلَقَ اَ۬لذَّكَرَ وَاَلۡأُنثۭيٰٓ ﰂ"],
[4,595,30,"إِنَّ سَعۡيَكُمۡ لَشَتّۭيٰ ﰃ"],
[5,595,30,"فَأَمَّا مَنۡ أَعۡطَىٰ وَاَتَّقۭيٰ ﰄ"],
[6,595,30,"وَصَدَّقَ بِالۡحُسۡنۭيٰ ﰅ"],
[7,595,30,"فَسَنُيَسِّرُهُۥ لِلۡيُسۡر۪يٰ ﰆ"],
[8,595,30,"وَأَمَّا مَنۢ بَخِلَ وَاَسۡتَغۡنۭيٰ ﰇ"],
[9,595,30,"وَكَذَّبَ بِالۡحُسۡنۭيٰ ﰈ"],
[10,596,30,"فَسَنُيَسِّرُهُۥ لِلۡعُسۡر۪يٰ ﰉ"],
[11,596,30,"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدّۭيٰٓ ﰊ"],
[12,596,30,"إِنَّ عَلَيۡنَا لَلۡهُدۭيٰ ﰋ"],
[13,596,30,"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَاَلۡأُولۭيٰ ﰌ"],
[14,596,30,"فَأَنذَرۡتُكُمۡ نَارٗا تَلَظّۭيٰ ﰍ"],
[15,596,30,"لَا يَصۡلَىٰهَآ إِلَّا اَ۬لۡأَشۡقَى ﰎ"],
[16,596,30,"اَ۬لَّذِي كَذَّبَ وَتَوَلّۭيٰ ﰏ"],
[17,596,30,"وَسَيُجَنَّبُهَا اَ۬لۡأَتۡقَى ﰐ"],
[18,596,30,"اَ۬لَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكّۭيٰ ﰑ"],
[19,596,30,"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزۭيٰٓ ﰒ"],
[20,596,30,"إِلَّا اَ۪بۡتِغَآءَ وَجۡهِ رَبِّهِ اِ۬لۡأَعۡلۭيٰ ﰓ"],
[21,596,30,"وَلَسَوۡفَ يَرۡضۭيٰ ﰔ"]
]}
