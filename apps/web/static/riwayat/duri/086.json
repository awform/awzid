{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":86,"name":"الطَّارق ","t":[
[1,591,30,"وَاَلسَّمَآءِ وَاَلطَّارِقِ ﰀ"],
[2,591,30,"وَمَآ أَدۡر۪ىٰكَ مَا اَ۬لطَّارِقُ ﰁ"],
[3,591,30,"اُ۬لنَّجۡمُ اُ۬لثَّاقِبُ ﰂ"],
[4,591,30,"إِن كُلُّ نَفۡسٖ لَّمَا عَلَيۡهَا حَافِظٞ ﰃ"],
[5,591,30,"فَلۡيَنظُرِ اِ۬لۡإِنسَٰنُ مِمَّ خُلِقَ ﰄ"],
[6,591,30,"خُلِقَ مِن مَّآءٖ دَافِقٖ ﰅ"],
[7,591,30,"يَخۡرُجُ مِنۢ بَيۡنِ اِ۬لصُّلۡبِ وَاَلتَّرَآئِبِ ﰆ"],
[8,591,30,"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ ﰇ"],
[9,591,30,"يَوۡمَ تُبۡلَى اَ۬لسَّرَآئِرُ ﰈ"],
[10,591,30,"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ ﰉ"],
[11,591,30,"وَاَلسَّمَآءِ ذَاتِ اِ۬لرَّجۡعِ ﰊ"],
[12,591,30,"وَاَلۡأَرۡضِ ذَاتِ اِ۬لصَّدۡعِ ﰋ"],
[13,591,30,"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ ﰌ"],
[14,591,30,"وَمَا هُوَ بِالۡهَزۡلِ ﰍ"],
[15,591,30,"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا وَأَكِيدُ كَيۡدٗا ﰎ"],
[16,591,30,"فَمَهِّلِ اِ۬لۡكٰ۪فِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا ﰏ"]
]}
