{"v":1,"key":"duri","version":"UthmanicDouri v2.0","source":"KFGQPC","s":77,"name":"المُرسَلات ","t":[
[1,580,29,"وَاَلۡمُرۡسَلَٰتِ عُرۡفٗا ﰀ"],
[2,580,29,"فَاَلۡعَٰصِفَٰتِ عَصۡفٗا ﰁ"],
[3,580,29,"وَاَلنَّٰشِرَٰتِ نَشۡرٗا ﰂ"],
[4,580,29,"فَاَلۡفَٰرِقَٰتِ فَرۡقٗا ﰃ"],
[5,580,29,"فَاَلۡمُلۡقِيَٰتِ ذِكۡرًا ﰄ"],
[6,580,29,"عُذۡرًا أَوۡ نُذۡرًا ﰅ"],
[7,580,29,"إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ ﰆ"],
[8,580,29,"فَإِذَا اَ۬لنُّجُومُ طُمِسَتۡ ﰇ"],
[9,580,29,"وَإِذَا اَ۬لسَّمَآءُ فُرِجَتۡ ﰈ"],
[10,580,29,"وَإِذَا اَ۬لۡجِبَالُ نُسِفَتۡ ﰉ"],
[11,580,29,"وَإِذَا اَ۬لرُّسُلُ اۥُقِّتَتۡ ﰊ"],
[12,580,29,"لِأَيِّ يَوۡمٍ أُجِّلَتۡ ﰋ"],
[13,580,29,"لِيَوۡمِ اِ۬لۡفَصۡلِ ﰌ"],
[14,580,29,"وَمَآ أَدۡر۪ىٰكَ مَا يَوۡمُ اُ۬لۡفَصۡلِ ﰍ"],
[15,580,29,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰎ"],
[16,580,29,"۞ أَلَمۡ نُهۡلِكِ اِ۬لۡأَوَّلِينَ ﰏ"],
[17,580,29,"ثُمَّ نُتۡبِعُهُمُ اُ۬لۡأٓخِرِينَ ﰐ"],
[18,580,29,"كَذَٰلِكَ نَفۡعَلُ بِالۡمُجۡرِمِينَ ﰑ"],
[19,580,29,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰒ"],
[20,581,29,"أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ ﰓ"],
[21,581,29,"فَجَعَلۡنَٰهُ فِي قَر۪ارٖ مَّكِينٍ ﰔ"],
[22,581,29,"إِلَىٰ قَدَرٖ مَّعۡلُومٖ ﰕ"],
[23,581,29,"فَقَدَرۡنَا فَنِعۡمَ اَ۬لۡقَٰدِرُونَ ﰖ"],
[24,581,29,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰗ"],
[25,581,29,"أَلَمۡ نَجۡعَلِ اِ۬لۡأَرۡضَ كِفَاتًا ﰘ"],
[26,581,29,"أَحۡيَآءٗ وَأَمۡوَٰتٗا ﰙ"],
[27,581,29,"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا ﰚ"],
[28,581,29,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰛ"],
[29,581,29,"اَ۪نطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ ﰜ"],
[30,581,29,"اَ۪نطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ ﰝ"],
[31,581,29,"لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ اَ۬للَّهَبِ ﰞ"],
[32,581,29,"إِنَّهَا تَرۡمِي بِشَرَرٖ كَاَلۡقَصۡرِ ﰟ"],
[33,581,29,"كَأَنَّهُۥ جِمَٰلَٰتٞ صُفۡرٞ ﰠ"],
[34,581,29,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰡ"],
[35,581,29,"هَٰذَا يَوۡمُ لَا يَنطِقُونَ ﰢ"],
[36,581,29,"وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ ﰣ"],
[37,581,29,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰤ"],
[38,581,29,"هَٰذَا يَوۡمُ اُ۬لۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَاَلۡأَوَّلِينَ ﰥ"],
[39,581,29,"فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ ﰦ"],
[40,581,29,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰧ"],
[41,581,29,"إِنَّ اَ۬لۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ ﰨ"],
[42,581,29,"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ ﰩ"],
[43,581,29,"كُلُواْ وَاَشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ ﰪ"],
[44,581,29,"إِنَّا كَذَٰلِكَ نَجۡزِي اِ۬لۡمُحۡسِنِينَ ﰫ"],
[45,581,29,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰬ"],
[46,581,29,"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ ﰭ"],
[47,581,29,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰮ"],
[48,581,29,"وَإِذَا قِيلَ لَهُمُ اُ۪رۡكَعُواْ لَا يَرۡكَعُونَ ﰯ"],
[49,581,29,"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰰ"],
[50,581,29,"فَبِأَيِّ حَدِيثِۢ بَعۡدَهُۥ يُؤۡمِنُونَ ﰱ"]
]}
