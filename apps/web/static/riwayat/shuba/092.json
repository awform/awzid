{"v":1,"key":"shuba","version":"kfgqpc_shubah_v30","source":"KFGQPC","s":92,"name":"اللَّيۡلِ","t":[
[1,595,30,"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ ۝١"],
[2,595,30,"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ ۝٢"],
[3,595,30,"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ ۝٣"],
[4,595,30,"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ ۝٤"],
[5,595,30,"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ ۝٥"],
[6,595,30,"وَصَدَّقَ بِٱلۡحُسۡنَىٰ ۝٦"],
[7,595,30,"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ ۝٧"],
[8,595,30,"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ ۝٨"],
[9,595,30,"وَكَذَّبَ بِٱلۡحُسۡنَىٰ ۝٩"],
[10,596,30,"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ ۝١٠"],
[11,596,30,"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ ۝١١"],
[12,596,30,"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ ۝١٢"],
[13,596,30,"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ ۝١٣"],
[14,596,30,"فَأَنذَرۡتُكُمۡ نَارࣰا تَلَظَّىٰ ۝١٤"],
[15,596,30,"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى ۝١٥"],
[16,596,30,"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ ۝١٦"],
[17,596,30,"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى ۝١٧"],
[18,596,30,"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ ۝١٨"],
[19,596,30,"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰٓ ۝١٩"],
[20,596,30,"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ ۝٢٠"],
[21,596,30,"وَلَسَوۡفَ يَرۡضَىٰ ۝٢١"]
]}
