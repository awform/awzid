{"v":1,"key":"shuba","version":"kfgqpc_shubah_v30","source":"KFGQPC","s":87,"name":"الأَعۡلَىٰ","t":[
[1,591,30,"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى ۝١"],
[2,591,30,"ٱلَّذِي خَلَقَ فَسَوَّىٰ ۝٢"],
[3,591,30,"وَٱلَّذِي قَدَّرَ فَهَدَىٰ ۝٣"],
[4,591,30,"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ ۝٤"],
[5,591,30,"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ ۝٥"],
[6,591,30,"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ ۝٦"],
[7,591,30,"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ ۝٧"],
[8,591,30,"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ ۝٨"],
[9,591,30,"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ ۝٩"],
[10,591,30,"سَيَذَّكَّرُ مَن يَخۡشَىٰ ۝١٠"],
[11,592,30,"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى ۝١١"],
[12,592,30,"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ ۝١٢"],
[13,592,30,"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ ۝١٣"],
[14,592,30,"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ ۝١٤"],
[15,592,30,"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ ۝١٥"],
[16,592,30,"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ۝١٦"],
[17,592,30,"وَٱلۡأٓخِرَةُ خَيۡرࣱ وَأَبۡقَىٰٓ ۝١٧"],
[18,592,30,"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ ۝١٨"],
[19,592,30,"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ ۝١٩"]
]}
