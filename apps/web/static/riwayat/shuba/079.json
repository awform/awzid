{"v":1,"key":"shuba","version":"kfgqpc_shubah_v30","source":"KFGQPC","s":79,"name":"النَّازِعَاتِ","t":[
[1,583,30,"وَٱلنَّٰزِعَٰتِ غَرۡقࣰا ۝١"],
[2,583,30,"وَٱلنَّٰشِطَٰتِ نَشۡطࣰا ۝٢"],
[3,583,30,"وَٱلسَّٰبِحَٰتِ سَبۡحࣰا ۝٣"],
[4,583,30,"فَٱلسَّٰبِقَٰتِ سَبۡقࣰا ۝٤"],
[5,583,30,"فَٱلۡمُدَبِّرَٰتِ أَمۡرࣰا ۝٥"],
[6,583,30,"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ ۝٦"],
[7,583,30,"تَتۡبَعُهَا ٱلرَّادِفَةُ ۝٧"],
[8,583,30,"قُلُوبࣱ يَوۡمَئِذࣲ وَاجِفَةٌ ۝٨"],
[9,583,30,"أَبۡصَٰرُهَا خَٰشِعَةࣱ ۝٩"],
[10,583,30,"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ ۝١٠"],
[11,583,30,"أَءِذَا كُنَّا عِظَٰمࣰا نَّٰخِرَةࣰ ۝١١"],
[12,583,30,"قَالُواْ تِلۡكَ إِذࣰا كَرَّةٌ خَاسِرَةࣱ ۝١٢"],
[13,583,30,"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ ۝١٣"],
[14,583,30,"فَإِذَا هُم بِٱلسَّاهِرَةِ ۝١٤"],
[15,583,30,"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ ۝١٥"],
[16,583,30,"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى ۝١٦"],
[17,584,30,"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ ۝١٧"],
[18,584,30,"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ ۝١٨"],
[19,584,30,"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ ۝١٩"],
[20,584,30,"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ ۝٢٠"],
[21,584,30,"فَكَذَّبَ وَعَصَىٰ ۝٢١"],
[22,584,30,"ثُمَّ أَدۡبَرَ يَسۡعَىٰ ۝٢٢"],
[23,584,30,"فَحَشَرَ فَنَادَىٰ ۝٢٣"],
[24,584,30,"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ ۝٢٤"],
[25,584,30,"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ ۝٢٥"],
[26,584,30,"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةࣰ لِّمَن يَخۡشَىٰٓ ۝٢٦"],
[27,584,30,"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا ۝٢٧"],
[28,584,30,"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا ۝٢٨"],
[29,584,30,"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا ۝٢٩"],
[30,584,30,"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ ۝٣٠"],
[31,584,30,"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا ۝٣١"],
[32,584,30,"وَٱلۡجِبَالَ أَرۡسَىٰهَا ۝٣٢"],
[33,584,30,"مَتَٰعࣰا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ۝٣٣"],
[34,584,30,"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ ۝٣٤"],
[35,584,30,"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ ۝٣٥"],
[36,584,30,"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ ۝٣٦"],
[37,584,30,"فَأَمَّا مَن طَغَىٰ ۝٣٧"],
[38,584,30,"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ۝٣٨"],
[39,584,30,"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ ۝٣٩"],
[40,584,30,"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ ۝٤٠"],
[41,584,30,"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ ۝٤١"],
[42,584,30,"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا ۝٤٢"],
[43,584,30,"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ ۝٤٣"],
[44,584,30,"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ ۝٤٤"],
[45,584,30,"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا ۝٤٥"],
[46,584,30,"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا ۝٤٦"]
]}
