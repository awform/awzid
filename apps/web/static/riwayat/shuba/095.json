{"v":1,"key":"shuba","version":"kfgqpc_shubah_v30","source":"KFGQPC","s":95,"name":"التِّينِ","t":[
[1,597,30,"وَٱلتِّينِ وَٱلزَّيۡتُونِ ۝١"],
[2,597,30,"وَطُورِ سِينِينَ ۝٢"],
[3,597,30,"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ ۝٣"],
[4,597,30,"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمࣲ ۝٤"],
[5,597,30,"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ ۝٥"],
[6,597,30,"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونࣲ ۝٦"],
[7,597,30,"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ ۝٧"],
[8,597,30,"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ ۝٨"]
]}
