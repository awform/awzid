{"v":1,"key":"shuba","version":"kfgqpc_shubah_v30","source":"KFGQPC","s":102,"name":"التَّكَاثُرِ","t":[
[1,600,30,"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ ۝١"],
[2,600,30,"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ ۝٢"],
[3,600,30,"كَلَّا سَوۡفَ تَعۡلَمُونَ ۝٣"],
[4,600,30,"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ ۝٤"],
[5,600,30,"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ ۝٥"],
[6,600,30,"لَتَرَوُنَّ ٱلۡجَحِيمَ ۝٦"],
[7,600,30,"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ ۝٧"],
[8,600,30,"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ ۝٨"]
