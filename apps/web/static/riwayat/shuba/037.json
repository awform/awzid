{"v":1,"key":"shuba","version":"kfgqpc_shubah_v30","source":"KFGQPC","s":37,"name":"الصَّافَّاتِ","t":[
[1,446,23,"وَٱلصَّٰٓفَّٰتِ صَفࣰّا ۝١"],
[2,446,23,"فَٱلزَّٰجِرَٰتِ زَجۡرࣰا ۝٢"],
[3,446,23,"فَٱلتَّٰلِيَٰتِ ذِكۡرًا ۝٣"],
[4,446,23,"إِنَّ إِلَٰهَكُمۡ لَوَٰحِدࣱ ۝٤"],
[5,446,23,"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ ۝٥"],
[6,446,23,"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبَ ۝٦"],
[7,446,23,"وَحِفۡظࣰا مِّن كُلِّ شَيۡطَٰنࣲ مَّارِدࣲ ۝٧"],
[8,446,23,"لَّا يَسۡمَعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبࣲ ۝٨"],
[9,446,23,"دُحُورࣰاۖ وَلَهُمۡ عَذَابࣱ وَاصِبٌ ۝٩"],
[10,446,23,"إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابࣱ ثَاقِبࣱ ۝١٠"],
[11,446,23,"فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينࣲ لَّازِبِۭ ۝١١"],
[12,446,23,"بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ ۝١٢"],
[13,446,23,"وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ ۝١٣"],
[14,446,23,"وَإِذَا رَأَوۡاْ ءَايَةࣰ يَسۡتَسۡخِرُونَ ۝١٤"],
[15,446,23,"وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرࣱ مُّبِينٌ ۝١٥"],
[16,446,23,"أَءِذَا مُتۡنَا وَكُنَّا تُرَابࣰا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ ۝١٦"],
[17,446,23,"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ ۝١٧"],
[18,446,23,"قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ ۝١٨"],
[19,446,23,"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ فَإِذَا هُمۡ يَنظُرُونَ ۝١٩"],
[20,446,23,"وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ ۝٢٠"],
[21,446,23,"هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ ۝٢١"],
[22,446,23,"۞ ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ ۝٢٢"],
[23,446,23,"مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ ۝٢٣"],
[24,446,23,"وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ ۝٢٤"],
[25,447,23,"مَا لَكُمۡ لَا تَنَاصَرُونَ ۝٢٥"],
[26,447,23,"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ ۝٢٦"],
[27,447,23,"وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ يَتَسَآءَلُونَ ۝٢٧"],
[28,447,23,"قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ ۝٢٨"],
[29,447,23,"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ ۝٢٩"],
[30,447,23,"وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمࣰا طَٰغِينَ ۝٣٠"],
[31,447,23,"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ ۝٣١"],
[32,447,23,"فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ ۝٣٢"],
[33,447,23,"فَإِنَّهُمۡ يَوۡمَئِذࣲ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ ۝٣٣"],
[34,447,23,"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ ۝٣٤"],
[35,447,23,"إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ ۝٣٥"],
[36,447,23,"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرࣲ مَّجۡنُونِۭ ۝٣٦"],
[37,447,23,"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ ۝٣٧"],
[38,447,23,"إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ ۝٣٨"],
[39,447,23,"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ ۝٣٩"],
[40,447,23,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ۝٤٠"],
[41,447,23,"أُوْلَٰٓئِكَ لَهُمۡ رِزۡقࣱ مَّعۡلُومࣱ ۝٤١"],
[42,447,23,"فَوَٰكِهُ وَهُم مُّكۡرَمُونَ ۝٤٢"],
[43,447,23,"فِي جَنَّٰتِ ٱلنَّعِيمِ ۝٤٣"],
[44,447,23,"عَلَىٰ سُرُرࣲ مُّتَقَٰبِلِينَ ۝٤٤"],
[45,447,23,"يُطَافُ عَلَيۡهِم بِكَأۡسࣲ مِّن مَّعِينِۭ ۝٤٥"],
[46,447,23,"بَيۡضَآءَ لَذَّةࣲ لِّلشَّٰرِبِينَ ۝٤٦"],
[47,447,23,"لَا فِيهَا غَوۡلࣱ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ ۝٤٧"],
[48,447,23,"وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينࣱ ۝٤٨"],
[49,447,23,"كَأَنَّهُنَّ بَيۡضࣱ مَّكۡنُونࣱ ۝٤٩"],
[50,447,23,"فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ يَتَسَآءَلُونَ ۝٥٠"],
[51,447,23,"قَالَ قَآئِلࣱ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينࣱ ۝٥١"],
[52,448,23,"يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ ۝٥٢"],
[53,448,23,"أَءِذَا مُتۡنَا وَكُنَّا تُرَابࣰا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ ۝٥٣"],
[54,448,23,"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ ۝٥٤"],
[55,448,23,"فَٱطَّلَعَ فَرٜءٜاهُ فِي سَوَآءِ ٱلۡجَحِيمِ ۝٥٥"],
[56,448,23,"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ ۝٥٦"],
[57,448,23,"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ ۝٥٧"],
[58,448,23,"أَفَمَا نَحۡنُ بِمَيِّتِينَ ۝٥٨"],
[59,448,23,"إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ ۝٥٩"],
[60,448,23,"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ ۝٦٠"],
[61,448,23,"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ ۝٦١"],
[62,448,23,"أَذَٰلِكَ خَيۡرࣱ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ ۝٦٢"],
[63,448,23,"إِنَّا جَعَلۡنَٰهَا فِتۡنَةࣰ لِّلظَّٰلِمِينَ ۝٦٣"],
[64,448,23,"إِنَّهَا شَجَرَةࣱ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ ۝٦٤"],
[65,448,23,"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ ۝٦٥"],
[66,448,23,"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ۝٦٦"],
[67,448,23,"ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبࣰا مِّنۡ حَمِيمࣲ ۝٦٧"],
[68,448,23,"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ ۝٦٨"],
[69,448,23,"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ ۝٦٩"],
[70,448,23,"فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ ۝٧٠"],
[71,448,23,"وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ ۝٧١"],
[72,448,23,"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ ۝٧٢"],
[73,448,23,"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ ۝٧٣"],
[74,448,23,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ۝٧٤"],
[75,448,23,"وَلَقَدۡ نَادَىٰنَا نُوحࣱ فَلَنِعۡمَ ٱلۡمُجِيبُونَ ۝٧٥"],
[76,448,23,"وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ ۝٧٦"],
[77,449,23,"وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ ۝٧٧"],
[78,449,23,"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ ۝٧٨"],
[79,449,23,"سَلَٰمٌ عَلَىٰ نُوحࣲ فِي ٱلۡعَٰلَمِينَ ۝٧٩"],
[80,449,23,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ۝٨٠"],
[81,449,23,"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ۝٨١"],
[82,449,23,"ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ ۝٨٢"],
[83,449,23,"۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ ۝٨٣"],
[84,449,23,"إِذۡ جَآءَ رَبَّهُۥ بِقَلۡبࣲ سَلِيمٍ ۝٨٤"],
[85,449,23,"إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ ۝٨٥"],
[86,449,23,"أَئِفۡكًا ءَالِهَةࣰ دُونَ ٱللَّهِ تُرِيدُونَ ۝٨٦"],
[87,449,23,"فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَٰلَمِينَ ۝٨٧"],
[88,449,23,"فَنَظَرَ نَظۡرَةࣰ فِي ٱلنُّجُومِ ۝٨٨"],
[89,449,23,"فَقَالَ إِنِّي سَقِيمࣱ ۝٨٩"],
[90,449,23,"فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ ۝٩٠"],
[91,449,23,"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ ۝٩١"],
[92,449,23,"مَا لَكُمۡ لَا تَنطِقُونَ ۝٩٢"],
[93,449,23,"فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِٱلۡيَمِينِ ۝٩٣"],
[94,449,23,"فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ ۝٩٤"],
[95,449,23,"قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ ۝٩٥"],
[96,449,23,"وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ ۝٩٦"],
[97,449,23,"قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنࣰا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ ۝٩٧"],
[98,449,23,"فَأَرَادُواْ بِهِۦ كَيۡدࣰا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ ۝٩٨"],
[99,449,23,"وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ ۝٩٩"],
[100,449,23,"رَبِّ هَبۡ لِي مِنَ ٱلصَّٰلِحِينَ ۝١٠٠"],
[101,449,23,"فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمࣲ ۝١٠١"],
[102,449,23,"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيِّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ ۝١٠٢"],
[103,450,23,"فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ ۝١٠٣"],
[104,450,23,"وَنَٰدَيۡنَٰهُ أَن يَٰٓإِبۡرَٰهِيمُ ۝١٠٤"],
[105,450,23,"قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ۝١٠٥"],
[106,450,23,"إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَٰٓؤُاْ ٱلۡمُبِينُ ۝١٠٦"],
[107,450,23,"وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمࣲ ۝١٠٧"],
[108,450,23,"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ ۝١٠٨"],
[109,450,23,"سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ ۝١٠٩"],
[110,450,23,"كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ۝١١٠"],
[111,450,23,"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ۝١١١"],
[112,450,23,"وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيࣰّا مِّنَ ٱلصَّٰلِحِينَ ۝١١٢"],
[113,450,23,"وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنࣱ وَظَالِمࣱ لِّنَفۡسِهِۦ مُبِينࣱ ۝١١٣"],
[114,450,23,"وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ ۝١١٤"],
[115,450,23,"وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ ۝١١٥"],
[116,450,23,"وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ ۝١١٦"],
[117,450,23,"وَءَاتَيۡنَٰهُمَا ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ ۝١١٧"],
[118,450,23,"وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ ۝١١٨"],
[119,450,23,"وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ ۝١١٩"],
[120,450,23,"سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ ۝١٢٠"],
[121,450,23,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ۝١٢١"],
[122,450,23,"إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ۝١٢٢"],
[123,450,23,"وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ ۝١٢٣"],
[124,450,23,"إِذۡ قَالَ لِقَوۡمِهِۦٓ أَلَا تَتَّقُونَ ۝١٢٤"],
[125,450,23,"أَتَدۡعُونَ بَعۡلࣰا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَٰلِقِينَ ۝١٢٥"],
[126,450,23,"ٱللَّهُ رَبُّكُمۡ وَرَبُّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ ۝١٢٦"],
[127,451,23,"فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ ۝١٢٧"],
[128,451,23,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ۝١٢٨"],
[129,451,23,"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ ۝١٢٩"],
[130,451,23,"سَلَٰمٌ عَلَىٰٓ إِلۡ يَاسِينَ ۝١٣٠"],
[131,451,23,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ۝١٣١"],
[132,451,23,"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ ۝١٣٢"],
[133,451,23,"وَإِنَّ لُوطࣰا لَّمِنَ ٱلۡمُرۡسَلِينَ ۝١٣٣"],
[134,451,23,"إِذۡ نَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ ۝١٣٤"],
[135,451,23,"إِلَّا عَجُوزࣰا فِي ٱلۡغَٰبِرِينَ ۝١٣٥"],
[136,451,23,"ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ ۝١٣٦"],
[137,451,23,"وَإِنَّكُمۡ لَتَمُرُّونَ عَلَيۡهِم مُّصۡبِحِينَ ۝١٣٧"],
[138,451,23,"وَبِٱلَّيۡلِۚ أَفَلَا تَعۡقِلُونَ ۝١٣٨"],
[139,451,23,"وَإِنَّ يُونُسَ لَمِنَ ٱلۡمُرۡسَلِينَ ۝١٣٩"],
[140,451,23,"إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ ۝١٤٠"],
[141,451,23,"فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ ۝١٤١"],
[142,451,23,"فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمࣱ ۝١٤٢"],
[143,451,23,"فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ ۝١٤٣"],
[144,451,23,"لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ ۝١٤٤"],
[145,451,23,"۞ فَنَبَذۡنَٰهُ بِٱلۡعَرَآءِ وَهُوَ سَقِيمࣱ ۝١٤٥"],
[146,451,23,"وَأَنۢبَتۡنَا عَلَيۡهِ شَجَرَةࣰ مِّن يَقۡطِينࣲ ۝١٤٦"],
[147,451,23,"وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ ۝١٤٧"],
[148,451,23,"فَـَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينࣲ ۝١٤٨"],
[149,451,23,"فَٱسۡتَفۡتِهِمۡ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ ۝١٤٩"],
[150,451,23,"أَمۡ خَلَقۡنَا ٱلۡمَلَٰٓئِكَةَ إِنَٰثࣰا وَهُمۡ شَٰهِدُونَ ۝١٥٠"],
[151,451,23,"أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ ۝١٥١"],
[152,451,23,"وَلَدَ ٱللَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ ۝١٥٢"],
[153,451,23,"أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ ۝١٥٣"],
[154,452,23,"مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ ۝١٥٤"],
[155,452,23,"أَفَلَا تَذَّكَّرُونَ ۝١٥٥"],
[156,452,23,"أَمۡ لَكُمۡ سُلۡطَٰنࣱ مُّبِينࣱ ۝١٥٦"],
[157,452,23,"فَأۡتُواْ بِكِتَٰبِكُمۡ إِن كُنتُمۡ صَٰدِقِينَ ۝١٥٧"],
[158,452,23,"وَجَعَلُواْ بَيۡنَهُۥ وَبَيۡنَ ٱلۡجِنَّةِ نَسَبࣰاۚ وَلَقَدۡ عَلِمَتِ ٱلۡجِنَّةُ إِنَّهُمۡ لَمُحۡضَرُونَ ۝١٥٨"],
[159,452,23,"سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ ۝١٥٩"],
[160,452,23,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ۝١٦٠"],
[161,452,23,"فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ ۝١٦١"],
[162,452,23,"مَآ أَنتُمۡ عَلَيۡهِ بِفَٰتِنِينَ ۝١٦٢"],
[163,452,23,"إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِيمِ ۝١٦٣"],
[164,452,23,"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامࣱ مَّعۡلُومࣱ ۝١٦٤"],
[165,452,23,"وَإِنَّا لَنَحۡنُ ٱلصَّآفُّونَ ۝١٦٥"],
[166,452,23,"وَإِنَّا لَنَحۡنُ ٱلۡمُسَبِّحُونَ ۝١٦٦"],
[167,452,23,"وَإِن كَانُواْ لَيَقُولُونَ ۝١٦٧"],
[168,452,23,"لَوۡ أَنَّ عِندَنَا ذِكۡرࣰا مِّنَ ٱلۡأَوَّلِينَ ۝١٦٨"],
[169,452,23,"لَكُنَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ۝١٦٩"],
[170,452,23,"فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ ۝١٧٠"],
[171,452,23,"وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ ۝١٧١"],
[172,452,23,"إِنَّهُمۡ لَهُمُ ٱلۡمَنصُورُونَ ۝١٧٢"],
[173,452,23,"وَإِنَّ جُندَنَا لَهُمُ ٱلۡغَٰلِبُونَ ۝١٧٣"],
[174,452,23,"فَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينࣲ ۝١٧٤"],
[175,452,23,"وَأَبۡصِرۡهُمۡ فَسَوۡفَ يُبۡصِرُونَ ۝١٧٥"],
[176,452,23,"أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ ۝١٧٦"],
[177,452,23,"فَإِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ ٱلۡمُنذَرِينَ ۝١٧٧"],
[178,452,23,"وَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينࣲ ۝١٧٨"],
[179,452,23,"وَأَبۡصِرۡ فَسَوۡفَ يُبۡصِرُونَ ۝١٧٩"],
[180,452,23,"سُبۡحَٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا يَصِفُونَ ۝١٨٠"],
[181,452,23,"وَسَلَٰمٌ عَلَى ٱلۡمُرۡسَلِينَ ۝١٨١"],
[182,452,23,"وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ ۝١٨٢"]
]}
