{"v":1,"key":"shuba","version":"kfgqpc_shubah_v30","source":"KFGQPC","s":89,"name":"الفَجۡرِ","t":[
[1,593,30,"وَٱلۡفَجۡرِ ۝١"],
[2,593,30,"وَلَيَالٍ عَشۡرࣲ ۝٢"],
[3,593,30,"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ ۝٣"],
[4,593,30,"وَٱلَّيۡلِ إِذَا يَسۡرِ ۝٤"],
[5,593,30,"هَلۡ فِي ذَٰلِكَ قَسَمࣱ لِّذِي حِجۡرٍ ۝٥"],
[6,593,30,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ ۝٦"],
[7,593,30,"إِرَمَ ذَاتِ ٱلۡعِمَادِ ۝٧"],
[8,593,30,"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ ۝٨"],
[9,593,30,"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ ۝٩"],
[10,593,30,"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ ۝١٠"],
[11,593,30,"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ ۝١١"],
[12,593,30,"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ ۝١٢"],
[13,593,30,"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ ۝١٣"],
[14,593,30,"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ ۝١٤"],
[15,593,30,"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ ۝١٥"],
[16,593,30,"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ ۝١٦"],
[17,593,30,"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ ۝١٧"],
[18,593,30,"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ۝١٨"],
[19,593,30,"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلࣰا لَّمࣰّا ۝١٩"],
[20,593,30,"وَتُحِبُّونَ ٱلۡمَالَ حُبࣰّا جَمࣰّا ۝٢٠"],
[21,593,30,"كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكࣰّا دَكࣰّا ۝٢١"],
[22,593,30,"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفࣰّا صَفࣰّا ۝٢٢"],
[23,594,30,"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذࣲ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ ۝٢٣"],
[24,594,30,"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي ۝٢٤"],
[25,594,30,"فَيَوۡمَئِذࣲ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدࣱ ۝٢٥"],
[26,594,30,"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدࣱ ۝٢٦"],
[27,594,30,"يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ ۝٢٧"],
[28,594,30,"ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةࣰ مَّرۡضِيَّةࣰ ۝٢٨"],
[29,594,30,"فَٱدۡخُلِي فِي عِبَٰدِي ۝٢٩"],
[30,594,30,"وَٱدۡخُلِي جَنَّتِي ۝٣٠"]
]}
