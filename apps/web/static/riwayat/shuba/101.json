{"v":1,"key":"shuba","version":"kfgqpc_shubah_v30","source":"KFGQPC","s":101,"name":"القَارِعَةِ","t":[
[1,600,30,"ٱلۡقَارِعَةُ ۝١"],
[2,600,30,"مَا ٱلۡقَارِعَةُ ۝٢"],
[3,600,30,"وَمَآ أَدۡرٜىٰكَ مَا ٱلۡقَارِعَةُ ۝٣"],
[4,600,30,"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ ۝٤"],
[5,600,30,"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ ۝٥"],
[6,600,30,"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ ۝٦"],
[7,600,30,"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ ۝٧"],
[8,600,30,"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ ۝٨"],
[9,600,30,"فَأُمُّهُۥ هَاوِيَةࣱ ۝٩"],
[10,600,30,"وَمَآ أَدۡرٜىٰكَ مَا هِيَهۡ ۝١٠"],
[11,600,30,"نَارٌ حَامِيَةُۢ ۝١١"]
]}
