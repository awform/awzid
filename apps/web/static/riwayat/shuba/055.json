{"v":1,"key":"shuba","version":"kfgqpc_shubah_v30","source":"KFGQPC","s":55,"name":"الرَّحۡمَٰن","t":[
[1,531,27,"ٱلرَّحۡمَٰنُ ۝١"],
[2,531,27,"عَلَّمَ ٱلۡقُرۡءَانَ ۝٢"],
[3,531,27,"خَلَقَ ٱلۡإِنسَٰنَ ۝٣"],
[4,531,27,"عَلَّمَهُ ٱلۡبَيَانَ ۝٤"],
[5,531,27,"ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانࣲ ۝٥"],
[6,531,27,"وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ ۝٦"],
[7,531,27,"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ ۝٧"],
[8,531,27,"أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ ۝٨"],
[9,531,27,"وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ ۝٩"],
[10,531,27,"وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ ۝١٠"],
[11,531,27,"فِيهَا فَٰكِهَةࣱ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ ۝١١"],
[12,531,27,"وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ ۝١٢"],
[13,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝١٣"],
[14,531,27,"خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلࣲ كَٱلۡفَخَّارِ ۝١٤"],
[15,531,27,"وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجࣲ مِّن نَّارࣲ ۝١٥"],
[16,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝١٦"],
[17,531,27,"رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ ۝١٧"],
[18,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝١٨"],
[19,532,27,"مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ ۝١٩"],
[20,532,27,"بَيۡنَهُمَا بَرۡزَخࣱ لَّا يَبۡغِيَانِ ۝٢٠"],
[21,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٢١"],
[22,532,27,"يَخۡرُجُ مِنۡهُمَا ٱللُّولُؤُ وَٱلۡمَرۡجَانُ ۝٢٢"],
[23,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٢٣"],
[24,532,27,"وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشِـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ ۝٢٤"],
[25,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٢٥"],
[26,532,27,"كُلُّ مَنۡ عَلَيۡهَا فَانࣲ ۝٢٦"],
[27,532,27,"وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ ۝٢٧"],
[28,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٢٨"],
[29,532,27,"يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنࣲ ۝٢٩"],
[30,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٣٠"],
[31,532,27,"سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ ۝٣١"],
[32,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٣٢"],
[33,532,27,"يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنࣲ ۝٣٣"],
[34,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٣٤"],
[35,532,27,"يُرۡسَلُ عَلَيۡكُمَا شُوَاظࣱ مِّن نَّارࣲ وَنُحَاسࣱ فَلَا تَنتَصِرَانِ ۝٣٥"],
[36,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٣٦"],
[37,532,27,"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةࣰ كَٱلدِّهَانِ ۝٣٧"],
[38,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٣٨"],
[39,532,27,"فَيَوۡمَئِذࣲ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦٓ إِنسࣱ وَلَا جَآنࣱّ ۝٣٩"],
[40,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٤٠"],
[41,532,27,"يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمۡ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ ۝٤١"],
[42,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٤٢"],
[43,533,27,"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ ۝٤٣"],
[44,533,27,"يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانࣲ ۝٤٤"],
[45,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٤٥"],
[46,533,27,"وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ ۝٤٦"],
[47,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٤٧"],
[48,533,27,"ذَوَاتَآ أَفۡنَانࣲ ۝٤٨"],
[49,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٤٩"],
[50,533,27,"فِيهِمَا عَيۡنَانِ تَجۡرِيَانِ ۝٥٠"],
[51,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٥١"],
[52,533,27,"فِيهِمَا مِن كُلِّ فَٰكِهَةࣲ زَوۡجَانِ ۝٥٢"],
[53,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٥٣"],
[54,533,27,"مُتَّكِـِٔينَ عَلَىٰ فُرُشِۭ بَطَآئِنُهَا مِنۡ إِسۡتَبۡرَقࣲۚ وَجَنَى ٱلۡجَنَّتَيۡنِ دَانࣲ ۝٥٤"],
[55,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٥٥"],
[56,533,27,"فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرۡفِ لَمۡ يَطۡمِثۡهُنَّ إِنسࣱ قَبۡلَهُمۡ وَلَا جَآنࣱّ ۝٥٦"],
[57,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٥٧"],
[58,533,27,"كَأَنَّهُنَّ ٱلۡيَاقُوتُ وَٱلۡمَرۡجَانُ ۝٥٨"],
[59,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٥٩"],
[60,533,27,"هَلۡ جَزَآءُ ٱلۡإِحۡسَٰنِ إِلَّا ٱلۡإِحۡسَٰنُ ۝٦٠"],
[61,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٦١"],
[62,533,27,"وَمِن دُونِهِمَا جَنَّتَانِ ۝٦٢"],
[63,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٦٣"],
[64,533,27,"مُدۡهَآمَّتَانِ ۝٦٤"],
[65,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٦٥"],
[66,533,27,"فِيهِمَا عَيۡنَانِ نَضَّاخَتَانِ ۝٦٦"],
[67,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٦٧"],
[68,533,27,"فِيهِمَا فَٰكِهَةࣱ وَنَخۡلࣱ وَرُمَّانࣱ ۝٦٨"],
[69,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٦٩"],
[70,534,27,"فِيهِنَّ خَيۡرَٰتٌ حِسَانࣱ ۝٧٠"],
[71,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٧١"],
[72,534,27,"حُورࣱ مَّقۡصُورَٰتࣱ فِي ٱلۡخِيَامِ ۝٧٢"],
[73,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٧٣"],
[74,534,27,"لَمۡ يَطۡمِثۡهُنَّ إِنسࣱ قَبۡلَهُمۡ وَلَا جَآنࣱّ ۝٧٤"],
[75,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٧٥"],
[76,534,27,"مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرࣲ وَعَبۡقَرِيٍّ حِسَانࣲ ۝٧٦"],
[77,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٧٧"],
[78,534,27,"تَبَٰرَكَ ٱسۡمُ رَبِّكَ ذِي ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ ۝٧٨"]
]}
