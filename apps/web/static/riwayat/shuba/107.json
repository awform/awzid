{"v":1,"key":"shuba","version":"kfgqpc_shubah_v30","source":"KFGQPC","s":107,"name":"المَاعُونِ","t":[
[1,602,30,"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ ۝١"],
[2,602,30,"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ ۝٢"],
[3,602,30,"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ۝٣"],
[4,602,30,"فَوَيۡلࣱ لِّلۡمُصَلِّينَ ۝٤"],
[5,602,30,"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ ۝٥"],
[6,602,30,"ٱلَّذِينَ هُمۡ يُرَآءُونَ ۝٦"],
[7,602,30,"وَيَمۡنَعُونَ ٱلۡمَاعُونَ ۝٧"]
]}
