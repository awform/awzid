{"v":1,"key":"shuba","version":"kfgqpc_shubah_v30","source":"KFGQPC","s":94,"name":"الشَّرۡحِ","t":[
[1,596,30,"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ ۝١"],
[2,596,30,"وَوَضَعۡنَا عَنكَ وِزۡرَكَ ۝٢"],
[3,597,30,"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ ۝٣"],
[4,597,30,"وَرَفَعۡنَا لَكَ ذِكۡرَكَ ۝٤"],
[5,597,30,"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا ۝٥"],
[6,597,30,"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰا ۝٦"],
[7,597,30,"فَإِذَا فَرَغۡتَ فَٱنصَبۡ ۝٧"],
[8,597,30,"وَإِلَىٰ رَبِّكَ فَٱرۡغَب ۝٨"]
]}
