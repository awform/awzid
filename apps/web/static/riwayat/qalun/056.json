{"v":1,"key":"qalun","version":"kfgqpc_qalun_v30","source":"KFGQPC","s":56,"name":"الوَاقِعَةِ","t":[
[1,534,27,"إِذَا وَقَعَتِ ࡴ۬لْوَاقِعَةُ ۝١"],
[2,534,27,"لَيْسَ لِوَقْعَتِهَا كَٰذِبَةٌۖ ۝٢"],
[3,534,27,"خَافِضَةࣱ رَّافِعَةٌ ۝٣"],
[4,534,27,"إِذَا رُجَّتِ ࡴ۬لْأَرْضُ رَجّاࣰ ۝٤"],
[5,534,27,"وَبُسَّتِ ࡴ۬لْجِبَالُ بَسّاࣰ ۝٥"],
[6,534,27,"فَكَانَتْ هَبَآءࣰ مُّنۢبَثّاࣰ ۝٦"],
[7,534,27,"وَكُنتُمْ أَزْوَٰجاࣰ ثَلَٰثَةࣰۖ ۝٧"],
[8,534,27,"فَأَصْحَٰبُ ࡲ۬لْمَيْمَنَةِ ۝٨"],
[9,534,27,"مَا أَصْحَٰبُ ࡲ۬لْمَيْمَنَةِۖ ۝٩"],
[10,534,27,"وَأَصْحَٰبُ ࡲ۬لْمَشْـَٔمَةِ ۝١٠"],
[11,534,27,"مَا أَصْحَٰبُ ࡲ۬لْمَشْـَٔمَةِۖ ۝١١"],
[12,534,27,"وَالسَّٰبِقُونَ ࡰ۬لسَّٰبِقُونَۖ ۝١٢"],
[13,534,27,"أُوْلَٰٓئِكَ ࡰ۬لْمُقَرَّبُونَ ۝١٣"],
[14,534,27,"فِے جَنَّٰتِ ࡴ۬لنَّعِيمِۖ ۝١٤"],
[15,534,27,"ثُلَّةࣱ مِّنَ ࡰ۬لْأَوَّلِينَ ۝١٥"],
[16,534,27,"وَقَلِيلࣱ مِّنَ ࡰ۬لْأٓخِرِينَ ۝١٦"],
[17,534,27,"عَلَىٰ سُرُرࣲ مَّوْضُونَةࣲ ۝١٧"],
[18,534,27,"مُّتَّكِـِٕينَ عَلَيْهَا مُتَقَٰبِلِينَۖ ۝١٨"],
[19,535,27,"يَطُوفُ عَلَيْهِمْ وِلْدَٰنࣱ مُّخَلَّدُونَ ۝١٩"],
[20,535,27,"بِأَكْوَابࣲ وَأَبَارِيقَ ۝٢٠"],
[21,535,27,"وَكَأْسࣲ مِّن مَّعِينࣲ ۝٢١"],
[22,535,27,"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزَفُونَ ۝٢٢"],
[23,535,27,"وَفَٰكِهَةࣲ مِّمَّا يَتَخَيَّرُونَ ۝٢٣"],
[24,535,27,"وَلَحْمِ طَيْرࣲ مِّمَّا يَشْتَهُونَۖ ۝٢٤"],
[25,535,27,"وَحُورٌ عِينࣱ كَأَمْثَٰلِ ࡴ۬للُّؤْلُوِٕ ࡴ۬لْمَكْنُونِ ۝٢٥"],
[26,535,27,"جَزَآءَۢ بِمَا كَانُواْ يَعْمَلُونَۖ ۝٢٦"],
[27,535,27,"لَا يَسْمَعُونَ فِيهَا لَغْواࣰ وَلَا تَأْثِيماًۖ ۝٢٧"],
[28,535,27,"إِلَّا قِيلاࣰ سَلَٰماࣰ سَلَٰماࣰۖ ۝٢٨"],
[29,535,27,"۞ وَأَصْحَٰبُ ࡲ۬لْيَمِينِ مَا أَصْحَٰبُ ࡲ۬لْيَمِينِۖ ۝٢٩"],
[30,535,27,"فِے سِدْرࣲ مَّخْضُودࣲ ۝٣٠"],
[31,535,27,"وَطَلْحࣲ مَّنضُودࣲ ۝٣١"],
[32,535,27,"وَظِلࣲّ مَّمْدُودࣲ ۝٣٢"],
[33,535,27,"وَمَآءࣲ مَّسْكُوبࣲ ۝٣٣"],
[34,535,27,"وَفَٰكِهَةࣲ كَثِيرَةࣲ ۝٣٤"],
[35,535,27,"لَّا مَقْطُوعَةࣲ وَلَا مَمْنُوعَةࣲ ۝٣٥"],
[36,535,27,"وَفُرُشࣲ مَّرْفُوعَةٍۖ ۝٣٦"],
[37,535,27,"إِنَّا أَنشَأْنَٰهُنَّ إِنشَآءࣰ ۝٣٧"],
[38,535,27,"فَجَعَلْنَٰهُنَّ أَبْكَاراً ۝٣٨"],
[39,535,27,"عُرُباً أَتْرَاباࣰ ۝٣٩"],
[40,535,27,"لِّأَصْحَٰبِ ࡴ۬لْيَمِينِۖ ۝٤٠"],
[41,535,27,"ثُلَّةࣱ مِّنَ ࡰ۬لْأَوَّلِينَ ۝٤١"],
[42,535,27,"وَثُلَّةࣱ مِّنَ ࡰ۬لْأٓخِرِينَۖ ۝٤٢"],
[43,535,27,"وَأَصْحَٰبُ ࡲ۬لشِّمَالِ ۝٤٣"],
[44,535,27,"مَا أَصْحَٰبُ ࡲ۬لشِّمَالِۖ ۝٤٤"],
[45,535,27,"فِے سَمُومࣲ وَحَمِيمࣲ ۝٤٥"],
[46,535,27,"وَظِلࣲّ مِّنْ يَّحْمُومࣲ ۝٤٦"],
[47,535,27,"لَّا بَارِدࣲ وَلَا كَرِيمٍۖ ۝٤٧"],
[48,535,27,"إِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُتْرَفِينَۖ ۝٤٨"],
[49,535,27,"وَكَانُواْ يُصِرُّونَ عَلَى ࡰ۬لْحِنثِ ࡴ۬لْعَظِيمِۖ ۝٤٩"],
[50,535,27,"وَكَانُواْ يَقُولُونَ أَٰئِذَا مِتْنَا وَكُنَّا تُرَاباࣰ وَعِظَٰماً إِنَّا لَمَبْعُوثُونَ ۝٥٠"],
[51,535,27,"أَوْءَابَآؤُنَا ࡰ۬لْأَوَّلُونَۖ ۝٥١"],
[52,535,27,"قُلْ إِنَّ ࡰ۬لْأَوَّلِينَ وَالْأٓخِرِينَ لَمَجْمُوعُونَ ۝٥٢"],
[53,535,27,"إِلَىٰ مِيقَٰتِ يَوْمࣲ مَّعْلُومࣲۖ ۝٥٣"],
[54,536,27,"ثُمَّ إِنَّكُمْ أَيُّهَا ࡰ۬لضَّآلُّونَ ࡰ۬لْمُكَذِّبُونَ ۝٥٤"],
[55,536,27,"لَأٓكِلُونَ مِن شَجَرࣲ مِّن زَقُّومࣲ ۝٥٥"],
[56,536,27,"فَمَالِـُٔونَ مِنْهَا ࡰ۬لْبُطُونَ ۝٥٦"],
[57,536,27,"فَشَٰرِبُونَ عَلَيْهِ مِنَ ࡰ۬لْحَمِيمِ ۝٥٧"],
[58,536,27,"فَشَٰرِبُونَ شُرْبَ ࡰ۬لْهِيمِۖ ۝٥٨"],
[59,536,27,"هَٰذَا نُزُلُهُمْ يَوْمَ ࡰ۬لدِّينِۖ ۝٥٩"],
[60,536,27,"نَحْنُ خَلَقْنَٰكُمْۖ فَلَوْلَا تُصَدِّقُونَۖ ۝٦٠"],
[61,536,27,"أَفَرَٰ۬يْتُم مَّا تُمْنُونَ ۝٦١"],
[62,536,27,"ءَٰࡶنتُمْ تَخْلُقُونَهُۥ أَمْ نَحْنُ ࡲ۬لْخَٰلِقُونَۖ ۝٦٢"],
[63,536,27,"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ࡲ۬لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ ۝٦٣"],
[64,536,27,"عَلَىٰ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِے مَا لَا تَعْلَمُونَۖ ۝٦٤"],
[65,536,27,"وَلَقَدْ عَلِمْتُمُ ࡲ۬لنَّشْأَةَ ࡰ۬لْأُولَىٰۖ فَلَوْلَا تَذَّكَّرُونَۖ ۝٦٥"],
[66,536,27,"أَفَرَٰ۬يْتُم مَّا تَحْرُثُونَ ۝٦٦"],
[67,536,27,"ءَٰࡶنتُمْ تَزْرَعُونَهُۥ أَمْ نَحْنُ ࡲ۬لزَّٰرِعُونَۖ ۝٦٧"],
[68,536,27,"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰماࣰ فَظَلْتُمْ تَفَكَّهُونَ ۝٦٨"],
[69,536,27,"إِنَّا لَمُغْرَمُونَ ۝٦٩"],
[70,536,27,"بَلْ نَحْنُ مَحْرُومُونَۖ ۝٧٠"],
[71,536,27,"أَفَرَٰ۬يْتُمُ ࡲ۬لْمَآءَ ࡰ۬لذِے تَشْرَبُونَ ۝٧١"],
[72,536,27,"ءَٰࡶنتُمْ أَنزَلْتُمُوهُ مِنَ ࡰ۬لْمُزْنِ أَمْ نَحْنُ ࡲ۬لْمُنزِلُونَۖ ۝٧٢"],
[73,536,27,"لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجاࣰۖ فَلَوْلَا تَشْكُرُونَۖ ۝٧٣"],
[74,536,27,"أَفَرَٰ۬يْتُمُ ࡲ۬لنَّارَ ࡰ۬لتِے تُورُونَ ۝٧٤"],
[75,536,27,"ءَٰࡶنتُمْ أَنشَأْتُمْ شَجَرَتَهَا أَمْ نَحْنُ ࡲ۬لْمُنشِـُٔونَۖ ۝٧٥"],
[76,536,27,"نَحْنُ جَعَلْنَٰهَا تَذْكِرَةࣰ وَمَتَٰعاࣰ لِّلْمُقْوِينَۖ ۝٧٦"],
[77,536,27,"فَسَبِّحْ بِاسْمِ رَبِّكَ ࡰ۬لْعَظِيمِۖ ۝٧٧"],
[78,536,27,"۞ فَلَا أُقْسِمُ بِمَوَٰقِعِ ࡴ۬لنُّجُومِ ۝٧٨"],
[79,536,27,"وَإِنَّهُۥ لَقَسَمࣱ لَّوْ تَعْلَمُونَ عَظِيمٌ ۝٧٩"],
[80,537,27,"إِنَّهُۥ لَقُرْءَانࣱ كَرِيمࣱ ۝٨٠"],
[81,537,27,"فِے كِتَٰبࣲ مَّكْنُونࣲ ۝٨١"],
[82,537,27,"لَّا يَمَسُّهُۥ إِلَّا ࡰ۬لْمُطَهَّرُونَۖ ۝٨٢"],
[83,537,27,"تَنزِيلࣱ مِّن رَّبِّ ࡴ۬لْعَٰلَمِينَۖ ۝٨٣"],
[84,537,27,"أَفَبِهَٰذَا ࡰ۬لْحَدِيثِ أَنتُم مُّدْهِنُونَ ۝٨٤"],
[85,537,27,"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَۖ ۝٨٥"],
[86,537,27,"فَلَوْلَا إِذَا بَلَغَتِ ࡴ۬لْحُلْقُومَ ۝٨٦"],
[87,537,27,"وَأَنتُمْ حِينَئِذࣲ تَنظُرُونَ ۝٨٧"],
[88,537,27,"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ ۝٨٨"],
[89,537,27,"فَلَوْلَا إِن كُنتُمْ غَيْرَ مَدِينِينَ ۝٨٩"],
[90,537,27,"تَرْجِعُونَهَا إِن كُنتُمْ صَٰدِقِينَۖ ۝٩٠"],
[91,537,27,"فَأَمَّا إِن كَانَ مِنَ ࡰ۬لْمُقَرَّبِينَ ۝٩١"],
[92,537,27,"فَرَوْحࣱ وَرَيْحَانࣱ وَجَنَّتُ نَعِيمࣲۖ ۝٩٢"],
[93,537,27,"وَأَمَّا إِن كَانَ مِنْ أَصْحَٰبِ ࡴ۬لْيَمِينِ ۝٩٣"],
[94,537,27,"فَسَلَٰمࣱ لَّكَ مِنْ أَصْحَٰبِ ࡴ۬لْيَمِينِۖ ۝٩٤"],
[95,537,27,"وَأَمَّا إِن كَانَ مِنَ ࡰ۬لْمُكَذِّبِينَ ࡰ۬لضَّآلِّينَ ۝٩٥"],
[96,537,27,"فَنُزُلࣱ مِّنْ حَمِيمࣲ ۝٩٦"],
[97,537,27,"وَتَصْلِيَةُ جَحِيمٍۖ ۝٩٧"],
[98,537,27,"إِنَّ هَٰذَا لَهْوَ حَقُّ ࡲ۬لْيَقِينِۖ ۝٩٨"],
[99,537,27,"فَسَبِّحْ بِاسْمِ رَبِّكَ ࡰ۬لْعَظِيمِۖ ۝٩٩"]
]}
