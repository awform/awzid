{"v":1,"key":"qalun","version":"kfgqpc_qalun_v30","source":"KFGQPC","s":87,"name":"الْأَعْلَيٰ","t":[
[1,591,30,"سَبِّحِ ࡴٜسْمَ رَبِّكَ ࡰ۬لْأَعْلَى ۝١"],
[2,591,30,"ࡰ۬لذِے خَلَقَ فَسَوَّىٰ ۝٢"],
[3,591,30,"وَالذِے قَدَّرَ فَهَدَىٰ ۝٣"],
[4,591,30,"وَالذِے أَخْرَجَ ࡰ۬لْمَرْعَىٰ ۝٤"],
[5,591,30,"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰۖ ۝٥"],
[6,591,30,"سَنُقْرِئُكَ فَلَا تَنسَىٰ ۝٦"],
[7,591,30,"إِلَّا مَا شَآءَ ࡰ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ ࡲ۬لْجَهْرَ وَمَا يَخْفَىٰۖ ۝٧"],
[8,591,30,"وَنُيَسِّرُكَ لِلْيُسْرَىٰۖ ۝٨"],
[9,591,30,"فَذَكِّرْ إِن نَّفَعَتِ ࡴ۬لذِّكْرَىٰۖ ۝٩"],
[10,591,30,"سَيَذَّكَّرُ مَنْ يَّخْشَىٰ ۝١٠"],
[11,592,30,"وَيَتَجَنَّبُهَا ࡰ۬لْأَشْقَى ۝١١"],
[12,592,30,"ࡰ۬لذِے يَصْلَى ࡰ۬لنَّارَ ࡰ۬لْكُبْرَىٰ ۝١٢"],
[13,592,30,"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰۖ ۝١٣"],
[14,592,30,"قَدْ أَفْلَحَ مَن تَزَكَّىٰ ۝١٤"],
[15,592,30,"وَذَكَرَ ࡰٜسْمَ رَبِّهِۦ فَصَلَّىٰۖ ۝١٥"],
[16,592,30,"بَلْ تُؤْثِرُونَ ࡰ۬لْحَيَوٰةَ ࡰ۬لدُّنْيَا ۝١٦"],
[17,592,30,"وَالْأٓخِرَةُ خَيْرࣱ وَأَبْقَىٰۖ ۝١٧"],
[18,592,30,"إِنَّ هَٰذَا لَفِے ࡴ۬لصُّحُفِ ࡴ۬لْأُولَىٰ ۝١٨"],
[19,592,30,"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰۖ ۝١٩"]
]}
