{"v":1,"key":"qalun","version":"kfgqpc_qalun_v30","source":"KFGQPC","s":79,"name":"النَّازِعَاتِ","t":[
[1,583,30,"وَالنَّٰزِعَٰتِ غَرْقاࣰ ۝١"],
[2,583,30,"وَالنَّٰشِطَٰتِ نَشْطاࣰ ۝٢"],
[3,583,30,"وَالسَّٰبِحَٰتِ سَبْحاࣰ ۝٣"],
[4,583,30,"فَالسَّٰبِقَٰتِ سَبْقاࣰ ۝٤"],
[5,583,30,"فَالْمُدَبِّرَٰتِ أَمْراࣰ ۝٥"],
[6,583,30,"يَوْمَ تَرْجُفُ ࡲ۬لرَّاجِفَةُ ۝٦"],
[7,583,30,"تَتْبَعُهَا ࡰ۬لرَّادِفَةُۖ ۝٧"],
[8,583,30,"قُلُوبࣱ يَوْمَئِذࣲ وَاجِفَةٌ ۝٨"],
[9,583,30,"أَبْصَٰرُهَا خَٰشِعَةࣱۖ ۝٩"],
[10,583,30,"يَقُولُونَ أَٰࢇنَّا لَمَرْدُودُونَ فِے ࡴ۬لْحَافِرَةِ ۝١٠"],
[11,583,30,"إِذَا كُنَّا عِظَٰماࣰ نَّخِرَةࣰۖ ۝١١"],
[12,583,30,"قَالُواْ تِلْكَ إِذاࣰ كَرَّةٌ خَاسِرَةࣱ ۝١٢"],
[13,583,30,"فَإِنَّمَا هِيَ زَجْرَةࣱ وَٰحِدَةࣱ ۝١٣"],
[14,583,30,"فَإِذَا هُم بِالسَّاهِرَةِۖ ۝١٤"],
[15,583,30,"هَلْ أَتَيٰكَ حَدِيثُ مُوسَىٰ ۝١٥"],
[16,583,30,"إِذْ نَادَيٰهُ رَبُّهُۥ بِالْوَادِ ࡴ۬لْمُقَدَّسِ طُوَىۖ ۝١٦"],
[17,584,30,"ࡰٜذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ ۝١٧"],
[18,584,30,"فَقُلْ هَل لَّكَ إِلَىٰ أَن تَزَّكَّىٰ ۝١٨"],
[19,584,30,"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰۖ ۝١٩"],
[20,584,30,"فَأَرَيٰهُ ࡲ۬لْأٓيَةَ ࡰ۬لْكُبْرَىٰ ۝٢٠"],
[21,584,30,"فَكَذَّبَ وَعَصَىٰ ۝٢١"],
[22,584,30,"ثُمَّ أَدْبَرَ يَسْعَىٰ ۝٢٢"],
[23,584,30,"فَحَشَرَ فَنَادَىٰ ۝٢٣"],
[24,584,30,"فَقَالَ أَنَا رَبُّكُمُ ࡲ۬لْأَعْلَىٰ ۝٢٤"],
[25,584,30,"فَأَخَذَهُ ࡲ۬للَّهُ نَكَالَ ࡰ۬لْأٓخِرَةِ وَالْأُولَىٰۖ ۝٢٥"],
[26,584,30,"إِنَّ فِے ذَٰلِكَ لَعِبْرَةࣰ لِّمَنْ يَّخْشَىٰۖ ۝٢٦"],
[27,584,30,"ءَٰࡶنتُمْ أَشَدُّ خَلْقاً أَمِ ࡴ۬لسَّمَآءُۖ بَنَيٰهَا ۝٢٧"],
[28,584,30,"رَفَعَ سَمْكَهَا فَسَوَّيٰهَا ۝٢٨"],
[29,584,30,"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَيٰهَاۖ ۝٢٩"],
[30,584,30,"وَالْأَرْضَ بَعْدَ ذَٰلِكَ دَحَيٰهَا ۝٣٠"],
[31,584,30,"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَيٰهَا ۝٣١"],
[32,584,30,"وَالْجِبَالَ أَرْسَيٰهَا ۝٣٢"],
[33,584,30,"مَتَٰعاࣰ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ ۝٣٣"],
[34,584,30,"فَإِذَا جَآءَتِ ࡴ۬لطَّآمَّةُ ࡲ۬لْكُبْرَىٰ ۝٣٤"],
[35,584,30,"يَوْمَ يَتَذَكَّرُ ࡲ۬لْإِنسَٰنُ مَا سَعَىٰ ۝٣٥"],
[36,584,30,"وَبُرِّزَتِ ࡴ۬لْجَحِيمُ لِمَنْ يَّرَىٰۖ ۝٣٦"],
[37,584,30,"فَأَمَّا مَن طَغَىٰ وَءَاثَرَ ࡰ۬لْحَيَوٰةَ ࡰ۬لدُّنْيَا ۝٣٧"],
[38,584,30,"فَإِنَّ ࡰ۬لْجَحِيمَ هِيَ ࡰ۬لْمَأْوَىٰۖ ۝٣٨"],
[39,584,30,"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ࡰ۬لنَّفْسَ عَنِ ࡴ۬لْهَوَىٰ ۝٣٩"],
[40,584,30,"فَإِنَّ ࡰ۬لْجَنَّةَ هِيَ ࡰ۬لْمَأْوَىٰۖ ۝٤٠"],
[41,584,30,"۞ يَسْـَٔلُونَكَ عَنِ ࡴ۬لسَّاعَةِ أَيَّانَ مُرْسَيٰهَاۖ ۝٤١"],
[42,584,30,"فِيمَ أَنتَ مِن ذِكْرَيٰهَاۖ ۝٤٢"],
[43,584,30,"إِلَىٰ رَبِّكَ مُنتَهَيٰهَاۖ ۝٤٣"],
[44,584,30,"إِنَّمَا أَنتَ مُنذِرُ مَنْ يَّخْشَيٰهَاۖ ۝٤٤"],
[45,584,30,"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُواْ إِلَّا عَشِيَّةً أَوْ ضُحَيٰهَاۖ ۝٤٥"]
]}
