{"v":1,"key":"qalun","version":"kfgqpc_qalun_v30","source":"KFGQPC","s":102,"name":"التَّكَاثُرِ","t":[
[1,600,30,"أَلْهَيٰكُمُ ࡲ۬لتَّكَاثُرُ ۝١"],
[2,600,30,"حَتَّىٰ زُرْتُمُ ࡲ۬لْمَقَابِرَۖ ۝٢"],
[3,600,30,"كَلَّا سَوْفَ تَعْلَمُونَ ۝٣"],
[4,600,30,"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَۖ ۝٤"],
[5,600,30,"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ࡰ۬لْيَقِينِۖ ۝٥"],
[6,600,30,"لَتَرَوُنَّ ࡰ۬لْجَحِيمَ ۝٦"],
[7,600,30,"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ࡰ۬لْيَقِينِ ۝٧"],
[8,600,30,"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ࡴ۬لنَّعِيمِۖ ۝٨"]
]}
