{"v":1,"key":"qalun","version":"kfgqpc_qalun_v30","source":"KFGQPC","s":80,"name":"عَبَسَ","t":[
[1,585,30,"عَبَسَ وَتَوَلَّىٰ ۝١"],
[2,585,30,"أَن جَآءَهُ ࡲ۬لْأَعْمَىٰۖ ۝٢"],
[3,585,30,"وَمَا يُدْرِيكَۖ لَعَلَّهُۥ يَزَّكَّىٰ ۝٣"],
[4,585,30,"أَوْ يَذَّكَّرُ فَتَنفَعُهُ ࡲ۬لذِّكْرَىٰۖ ۝٤"],
[5,585,30,"أَمَّا مَنِ ࡴٜسْتَغْنَىٰ ۝٥"],
[6,585,30,"فَأَنتَ لَهُۥ تَصَّدَّىٰ ۝٦"],
[7,585,30,"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰۖ ۝٧"],
[8,585,30,"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ ۝٨"],
[9,585,30,"وَهْوَ يَخْشَىٰ ۝٩"],
[10,585,30,"فَأَنتَ عَنْهُ تَلَهَّىٰ ۝١٠"],
[11,585,30,"كَلَّاۖ إِنَّهَا تَذْكِرَةࣱۖ ۝١١"],
[12,585,30,"فَمَن شَآءَ ذَكَرَهُۥ ۝١٢"],
[13,585,30,"فِے صُحُفࣲ مُّكَرَّمَةࣲ ۝١٣"],
[14,585,30,"مَّرْفُوعَةࣲ مُّطَهَّرَةِۢ ۝١٤"],
[15,585,30,"بِأَيْدِے سَفَرَةࣲ ۝١٥"],
[16,585,30,"كِرَامِۢ بَرَرَةࣲۖ ۝١٦"],
[17,585,30,"قُتِلَ ࡰ۬لْإِنسَٰنُ مَا أَكْفَرَهُۥۖ ۝١٧"],
[18,585,30,"مِنْ أَيِّ شَےْءٍ خَلَقَهُۥۖ ۝١٨"],
[19,585,30,"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ۝١٩"],
[20,585,30,"ثُمَّ ࡰ۬لسَّبِيلَ يَسَّرَهُۥ ۝٢٠"],
[21,585,30,"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥۖ ۝٢١"],
[22,585,30,"ثُمَّ إِذَا شَا أَنشَرَهُۥۖ ۝٢٢"],
[23,585,30,"كَلَّا لَمَّا يَقْضِ مَا أَمَرَهُۥۖ ۝٢٣"],
[24,585,30,"فَلْيَنظُرِ ࡴ۬لْإِنسَٰنُ إِلَىٰ طَعَامِهِۦۖ ۝٢٤"],
[25,585,30,"إِنَّا صَبَبْنَا ࡰ۬لْمَآءَ صَبّاࣰ ۝٢٥"],
[26,585,30,"ثُمَّ شَقَقْنَا ࡰ۬لْأَرْضَ شَقّاࣰ ۝٢٦"],
[27,585,30,"فَأَنۢبَتْنَا فِيهَا حَبّاࣰ ۝٢٧"],
[28,585,30,"وَعِنَباࣰ وَقَضْباࣰ ۝٢٨"],
[29,585,30,"وَزَيْتُوناࣰ وَنَخْلاࣰ ۝٢٩"],
[30,585,30,"وَحَدَآئِقَ غُلْباࣰ ۝٣٠"],
[31,585,30,"وَفَٰكِهَةࣰ وَأَبّاࣰ ۝٣١"],
[32,585,30,"مَّتَٰعاࣰ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ ۝٣٢"],
[33,585,30,"فَإِذَا جَآءَتِ ࡴ۬لصَّآخَّةُ ۝٣٣"],
[34,585,30,"يَوْمَ يَفِرُّ ࡲ۬لْمَرْءُ مِنْ أَخِيهِ ۝٣٤"],
[35,585,30,"وَأُمِّهِۦ وَأَبِيهِ ۝٣٥"],
[36,585,30,"وَصَٰحِبَتِهِۦ وَبَنِيهِۖ ۝٣٦"],
[37,585,30,"لِكُلِّ ࡴٜمْرِےࣲٕ مِّنْهُمْ يَوْمَئِذࣲ شَأْنࣱ يُغْنِيهِۖ ۝٣٧"],
[38,585,30,"وُجُوهࣱ يَوْمَئِذࣲ مُّسْفِرَةࣱ ۝٣٨"],
[39,585,30,"ضَاحِكَةࣱ مُّسْتَبْشِرَةࣱۖ ۝٣٩"],
[40,585,30,"وَوُجُوهࣱ يَوْمَئِذٍ عَلَيْهَا غَبَرَةࣱ ۝٤٠"],
[41,586,30,"تَرْهَقُهَا قَتَرَةٌۖ ۝٤١"],
[42,586,30,"أُوْلَٰٓئِكَ هُمُ ࡲ۬لْكَفَرَةُ ࡲ۬لْفَجَرَةُۖ ۝٤٢"]
]}
