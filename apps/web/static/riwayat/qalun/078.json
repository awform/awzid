{"v":1,"key":"qalun","version":"kfgqpc_qalun_v30","source":"KFGQPC","s":78,"name":"النَّبَإِ","t":[
[1,582,30,"عَمَّۖ يَتَسَآءَلُونَ ۝١"],
[2,582,30,"عَنِ ࡴ۬لنَّبَإِ ࡴ۬لْعَظِيمِ ۝٢"],
[3,582,30,"ࡴ۬لذِے هُمْ فِيهِ مُخْتَلِفُونَۖ ۝٣"],
[4,582,30,"كَلَّا سَيَعْلَمُونَ ۝٤"],
[5,582,30,"ثُمَّ كَلَّا سَيَعْلَمُونَۖ ۝٥"],
[6,582,30,"أَلَمْ نَجْعَلِ ࡴ۬لْأَرْضَ مِهَٰداࣰ ۝٦"],
[7,582,30,"وَالْجِبَالَ أَوْتَاداࣰ ۝٧"],
[8,582,30,"وَخَلَقْنَٰكُمْ أَزْوَٰجاࣰ ۝٨"],
[9,582,30,"وَجَعَلْنَا نَوْمَكُمْ سُبَاتاࣰ ۝٩"],
[10,582,30,"وَجَعَلْنَا ࡰ۬ليْلَ لِبَاساࣰ ۝١٠"],
[11,582,30,"وَجَعَلْنَا ࡰ۬لنَّهَارَ مَعَاشاࣰ ۝١١"],
[12,582,30,"وَبَنَيْنَا فَوْقَكُمْ سَبْعاࣰ شِدَاداࣰ ۝١٢"],
[13,582,30,"وَجَعَلْنَا سِرَاجاࣰ وَهَّاجاࣰ ۝١٣"],
[14,582,30,"وَأَنزَلْنَا مِنَ ࡰ۬لْمُعْصِرَٰتِ مَآءࣰ ثَجَّاجاࣰ ۝١٤"],
[15,582,30,"لِّنُخْرِجَ بِهِۦ حَبّاࣰ وَنَبَاتاࣰ ۝١٥"],
[16,582,30,"وَجَنَّٰتٍ أَلْفَافاًۖ ۝١٦"],
[17,582,30,"إِنَّ يَوْمَ ࡰ۬لْفَصْلِ كَانَ مِيقَٰتاࣰ ۝١٧"],
[18,582,30,"يَوْمَ يُنفَخُ فِے ࡴ۬لصُّورِ فَتَأْتُونَ أَفْوَاجاࣰ ۝١٨"],
[19,582,30,"وَفُتِّحَتِ ࡴ۬لسَّمَآءُ فَكَانَتْ أَبْوَٰباࣰ ۝١٩"],
[20,582,30,"وَسُيِّرَتِ ࡴ۬لْجِبَالُ فَكَانَتْ سَرَاباًۖ ۝٢٠"],
[21,582,30,"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَاداࣰ ۝٢١"],
[22,582,30,"لِّلطَّٰغِينَ مَـَٔاباࣰ ۝٢٢"],
[23,582,30,"لَّٰبِثِينَ فِيهَا أَحْقَاباࣰۖ ۝٢٣"],
[24,582,30,"لَّا يَذُوقُونَ فِيهَا بَرْداࣰ وَلَا شَرَاباً ۝٢٤"],
[25,582,30,"إِلَّا حَمِيماࣰ وَغَسَاقاࣰ ۝٢٥"],
[26,582,30,"جَزَآءࣰ وِفَاقاًۖ ۝٢٦"],
[27,582,30,"إِنَّهُمْ كَانُواْ لَا يَرْجُونَ حِسَاباࣰ ۝٢٧"],
[28,582,30,"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّاباࣰۖ ۝٢٨"],
[29,582,30,"وَكُلَّ شَےْءٍ أَحْصَيْنَٰهُ كِتَٰباࣰۖ ۝٢٩"],
[30,582,30,"فَذُوقُواْ فَلَن نَّزِيدَكُمْ إِلَّا عَذَاباًۖ ۝٣٠"],
[31,583,30,"إِنَّ لِلْمُتَّقِينَ مَفَازاً ۝٣١"],
[32,583,30,"حَدَآئِقَ وَأَعْنَٰباࣰ ۝٣٢"],
[33,583,30,"وَكَوَاعِبَ أَتْرَاباࣰ ۝٣٣"],
[34,583,30,"وَكَأْساࣰ دِهَاقاࣰ ۝٣٤"],
[35,583,30,"لَّا يَسْمَعُونَ فِيهَا لَغْواࣰ وَلَا كِذَّاباࣰۖ ۝٣٥"],
[36,583,30,"جَزَآءࣰ مِّن رَّبِّكَ عَطَآءً حِسَاباࣰۖ ۝٣٦"],
[37,583,30,"رَّبُّ ࡲ۬لسَّمَٰوَٰتِ وَالْأَرْضِ وَمَا بَيْنَهُمَاۖ ࡰ۬لرَّحْمَٰنُ لَا يَمْلِكُونَ مِنْهُ خِطَاباࣰۖ ۝٣٧"],
[38,583,30,"يَوْمَ يَقُومُ ࡲ۬لرُّوحُ وَالْمَلَٰٓئِكَةُ صَفّاࣰ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ࡲ۬لرَّحْمَٰنُ وَقَالَ صَوَاباࣰۖ ۝٣٨"],
[39,583,30,"ذَٰلِكَ ࡰ۬لْيَوْمُ ࡲ۬لْحَقُّۖ فَمَن شَآءَ ࡰٜتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔاباًۖ ۝٣٩"],
[40,583,30,"إِنَّا أَنذَرْنَٰكُمْ عَذَاباࣰ قَرِيباࣰ يَوْمَ يَنظُرُ ࡲ۬لْمَرْءُ مَا قَدَّمَتْ يَدَٰهُ وَيَقُولُ ࡲ۬لْكَافِرُ يَٰلَيْتَنِے كُنتُ تُرَٰباَۢۖ ۝٤٠"]
]}
