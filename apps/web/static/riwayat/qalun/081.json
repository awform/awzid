{"v":1,"key":"qalun","version":"kfgqpc_qalun_v30","source":"KFGQPC","s":81,"name":"التَّكْوِيرِ","t":[
[1,586,30,"إِذَا ࡰ۬لشَّمْسُ كُوِّرَتْ ۝١"],
[2,586,30,"وَإِذَا ࡰ۬لنُّجُومُ ࡲٜنكَدَرَتْ ۝٢"],
[3,586,30,"وَإِذَا ࡰ۬لْجِبَالُ سُيِّرَتْ ۝٣"],
[4,586,30,"وَإِذَا ࡰ۬لْعِشَارُ عُطِّلَتْ ۝٤"],
[5,586,30,"وَإِذَا ࡰ۬لْوُحُوشُ حُشِرَتْ ۝٥"],
[6,586,30,"وَإِذَا ࡰ۬لْبِحَارُ سُجِّرَتْ ۝٦"],
[7,586,30,"وَإِذَا ࡰ۬لنُّفُوسُ زُوِّجَتْ ۝٧"],
[8,586,30,"وَإِذَا ࡰ۬لْمَوْءُۥدَةُ سُئِلَتْ ۝٨"],
[9,586,30,"بِأَيِّ ذَنۢبࣲ قُتِلَتْ ۝٩"],
[10,586,30,"وَإِذَا ࡰ۬لصُّحُفُ نُشِرَتْ ۝١٠"],
[11,586,30,"وَإِذَا ࡰ۬لسَّمَآءُ كُشِطَتْ ۝١١"],
[12,586,30,"وَإِذَا ࡰ۬لْجَحِيمُ سُعِّرَتْ ۝١٢"],
[13,586,30,"وَإِذَا ࡰ۬لْجَنَّةُ أُزْلِفَتْ ۝١٣"],
[14,586,30,"عَلِمَتْ نَفْسࣱ مَّا أَحْضَرَتْۖ ۝١٤"],
[15,586,30,"فَلَا أُقْسِمُ بِالْخُنَّسِ ۝١٥"],
[16,586,30,"ࡴ۬لْجَوَارِ ࡴ۬لْكُنَّسِ ۝١٦"],
[17,586,30,"وَاليْلِ إِذَا عَسْعَسَ ۝١٧"],
[18,586,30,"وَالصُّبْحِ إِذَا تَنَفَّسَ ۝١٨"],
[19,586,30,"إِنَّهُۥ لَقَوْلُ رَسُولࣲ كَرِيمࣲ ۝١٩"],
[20,586,30,"ذِے قُوَّةٍ عِندَ ذِے ࡴ۬لْعَرْشِ مَكِينࣲ ۝٢٠"],
[21,586,30,"مُّطَاعࣲ ثَمَّ أَمِينࣲۖ ۝٢١"],
[22,586,30,"وَمَا صَٰحِبُكُم بِمَجْنُونࣲۖ ۝٢٢"],
[23,586,30,"وَلَقَدْ رَءَاهُ بِالْأُفُقِ ࡴ۬لْمُبِينِۖ ۝٢٣"],
[24,586,30,"وَمَا هُوَ عَلَى ࡰ۬لْغَيْبِ بِضَنِينࣲۖ ۝٢٤"],
[25,586,30,"وَمَا هُوَ بِقَوْلِ شَيْطَٰنࣲ رَّجِيمࣲ ۝٢٥"],
[26,586,30,"فَأَيْنَ تَذْهَبُونَۖ ۝٢٦"],
[27,586,30,"إِنْ هُوَ إِلَّا ذِكْرࣱ لِّلْعَٰلَمِينَ ۝٢٧"],
[28,586,30,"لِمَن شَآءَ مِنكُمْ أَنْ يَّسْتَقِيمَۖ ۝٢٨"],
[29,586,30,"وَمَا تَشَآءُونَ إِلَّا أَنْ يَّشَآءَ ࡰ۬للَّهُ رَبُّ ࡲ۬لْعَٰلَمِينَۖ ۝٢٩"]
]}
