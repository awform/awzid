{"v":1,"key":"qalun","version":"kfgqpc_qalun_v30","source":"KFGQPC","s":86,"name":"الطَّارِقِ","t":[
[1,591,30,"وَالسَّمَآءِ وَالطَّارِقِ ۝١"],
[2,591,30,"وَمَا أَدْرَيٰكَ مَا ࡰ۬لطَّارِقُ ۝٢"],
[3,591,30,"ࡲ۬لنَّجْمُ ࡲ۬لثَّاقِبُ ۝٣"],
[4,591,30,"إِن كُلُّ نَفْسࣲ لَّمَا عَلَيْهَا حَافِظࣱۖ ۝٤"],
[5,591,30,"فَلْيَنظُرِ ࡴ۬لْإِنسَٰنُ مِمَّ خُلِقَۖ ۝٥"],
[6,591,30,"خُلِقَ مِن مَّآءࣲ دَافِقࣲ ۝٦"],
[7,591,30,"يَخْرُجُ مِنۢ بَيْنِ ࡴ۬لصُّلْبِ وَالتَّرَآئِبِۖ ۝٧"],
[8,591,30,"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرࣱ ۝٨"],
[9,591,30,"يَوْمَ تُبْلَى ࡰ۬لسَّرَآئِرُ ۝٩"],
[10,591,30,"فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲۖ ۝١٠"],
[11,591,30,"وَالسَّمَآءِ ذَاتِ ࡴ۬لرَّجْعِ ۝١١"],
[12,591,30,"وَالْأَرْضِ ذَاتِ ࡴ۬لصَّدْعِ ۝١٢"],
[13,591,30,"إِنَّهُۥ لَقَوْلࣱ فَصْلࣱ ۝١٣"],
[14,591,30,"وَمَا هُوَ بِالْهَزْلِۖ ۝١٤"],
[15,591,30,"إِنَّهُمْ يَكِيدُونَ كَيْداࣰ ۝١٥"],
[16,591,30,"وَأَكِيدُ كَيْداࣰۖ ۝١٦"],
[17,591,30,"فَمَهِّلِ ࡴ۬لْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْداَۢۖ ۝١٧"]
]}
