{"v":1,"key":"qalun","version":"kfgqpc_qalun_v30","source":"KFGQPC","s":101,"name":"القَارِعَةِ","t":[
[1,600,30,"ࡴ۬لْقَارِعَةُ مَا ࡰ۬لْقَارِعَةُۖ ۝١"],
[2,600,30,"وَمَا أَدْرَيٰكَ مَا ࡰ۬لْقَارِعَةُۖ ۝٢"],
[3,600,30,"يَوْمَ يَكُونُ ࡲ۬لنَّاسُ كَالْفَرَاشِ ࡴ۬لْمَبْثُوثِ ۝٣"],
[4,600,30,"وَتَكُونُ ࡲ۬لْجِبَالُ كَالْعِهْنِ ࡴ۬لْمَنفُوشِۖ ۝٤"],
[5,600,30,"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ ۝٥"],
[6,600,30,"فَهْوَ فِے عِيشَةࣲ رَّاضِيَةࣲۖ ۝٦"],
[7,600,30,"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ ۝٧"],
[8,600,30,"فَأُمُّهُۥ هَاوِيَةࣱۖ ۝٨"],
[9,600,30,"وَمَا أَدْرَيٰكَ مَا هِيَهْۖ ۝٩"],
[10,600,30,"نَارٌ حَامِيَةُۢۖ ۝١٠"]
]}
