{"v":1,"key":"qalun","version":"kfgqpc_qalun_v30","source":"KFGQPC","s":96,"name":"العَلَقِ","t":[
[1,597,30,"ࡴٜقْرَأْ بِاسْمِ رَبِّكَ ࡰ۬لذِے خَلَقَۖ ۝١"],
[2,597,30,"خَلَقَ ࡰ۬لْإِنسَٰنَ مِنْ عَلَقٍۖ ۝٢"],
[3,597,30,"ࡴٜقْرَأْ وَرَبُّكَ ࡰ۬لْأَكْرَمُ ۝٣"],
[4,597,30,"ࡲ۬لذِے عَلَّمَ بِالْقَلَمِ ۝٤"],
[5,597,30,"عَلَّمَ ࡰ۬لْإِنسَٰنَ مَا لَمْ يَعْلَمْۖ ۝٥"],
[6,597,30,"كَلَّا إِنَّ ࡰ۬لْإِنسَٰنَ لَيَطْغَىٰ ۝٦"],
[7,597,30,"أَن رَّءَاهُ ࡲٜسْتَغْنَىٰۖ ۝٧"],
[8,597,30,"إِنَّ إِلَىٰ رَبِّكَ ࡰ۬لرُّجْعَىٰۖ ۝٨"],
[9,597,30,"أَرَٰ۬يْتَ ࡰ۬لذِے يَنْهَىٰ ۝٩"],
[10,597,30,"عَبْداً إِذَا صَلَّىٰۖ ۝١٠"],
[11,597,30,"أَرَٰ۬يْتَ إِن كَانَ عَلَى ࡰ۬لْهُدَىٰ ۝١١"],
[12,597,30,"أَوْ أَمَرَ بِالتَّقْوَىٰۖ ۝١٢"],
[13,598,30,"أَرَٰ۬يْتَ إِن كَذَّبَ وَتَوَلَّىٰ ۝١٣"],
[14,598,30,"أَلَمْ يَعْلَم بِأَنَّ ࡰ۬للَّهَ يَرَىٰۖ ۝١٤"],
[15,598,30,"كَلَّا لَئِن لَّمْ يَنتَهِ ۝١٥"],
[16,598,30,"لَنَسْفَعاَۢ بِالنَّاصِيَةِ ۝١٦"],
[17,598,30,"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲۖ ۝١٧"],
[18,598,30,"فَلْيَدْعُ نَادِيَهُۥ ۝١٨"],
[19,598,30,"سَنَدْعُ ࡲ۬لزَّبَانِيَةَۖ ۝١٩"],
[20,598,30,"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبۖ ۝٢٠"]
]}
