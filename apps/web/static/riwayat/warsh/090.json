{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":90,"name":"ࡲ۬لْبَلَدِ","t":[
[1,594,30,"لَآ أُقْسِمُ بِهَٰذَا ࡰ۬لْبَلَدِ ۝١"],
[2,594,30,"وَأَنتَ حِلُّۢ بِهَٰذَا ࡰ۬لْبَلَدِ ۝٢"],
[3,594,30,"وَوَالِدࣲ وَمَا وَلَدَ ۝٣"],
[4,594,30,"لَقَدْ خَلَقْنَا ࡰ۬لِانسَٰنَ فِے كَبَدٍ࣌ ۝٤"],
[5,594,30,"ࡰيَحْسِبُ أَن لَّنْ يَّقْدِرَ عَلَيْهِ أَحَدࣱ ۝٥"],
[6,594,30,"يَقُولُ أَهْلَكْتُ مَالاࣰ لُّبَداً࣌ ۝٦"],
[7,594,30,"ࡰيَحْسِبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ࣌ ۝٧"],
[8,594,30,"ࡰلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ ۝٨"],
[9,594,30,"وَلِسَاناࣰ وَشَفَتَيْنِ ۝٩"],
[10,594,30,"وَهَدَيْنَٰهُ ࡲ۬لنَّجْدَيْنِ࣌ ۝١٠"],
[11,594,30,"فَلَا ࡰٜقْتَحَمَ ࡰ۬لْعَقَبَةَ࣌ ۝١١"],
[12,594,30,"وَمَآ أَدْرٜيٰكَ مَا ࡰ۬لْعَقَبَةُ࣌ ۝١٢"],
[13,594,30,"فَكُّ رَقَبَةٍ ۝١٣"],
[14,594,30,"ࡰوِ ࡴطْعَامࣱ فِے يَوْمࣲ ذِے مَسْغَبَةࣲ ۝١٤"],
[15,594,30,"يَتِيماࣰ ذَا مَقْرَبَةٍ ۝١٥"],
[16,594,30,"ࡰوْ مِسْكِيناࣰ ذَا مَتْرَبَةࣲ࣌ ۝١٦"],
[17,594,30,"ثُمَّ كَانَ مِنَ ࡰ۬لذِينَ ءَامَنُواْ وَتَوَاصَوْاْ بِالصَّبْرِ وَتَوَاصَوْاْ بِالْمَرْحَمَةِ࣌ ۝١٧"],
[18,594,30,"أُوْلَٰٓئِكَ أَصْحَٰبُ ࡲ۬لْمَيْمَنَةِ࣌ ۝١٨"],
[19,595,30,"وَالذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمُۥٓ أَصْحَٰبُ ࡲ۬لْمَشْـَٔمَةِ࣌ ۝١٩"],
[20,595,30,"عَلَيْهِمْ نَارࣱ مُّوصَدَةࣱ࣌ ۝٢٠"]
]}
