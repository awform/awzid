{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":100,"name":"ࡲ۬لْعَٰدِيَٰتِ","t":[
[1,599,30,"وَالْعَٰدِيَٰتِ ضَبْحاࣰ ۝١"],
[2,599,30,"فَالْمُورِيَٰتِ قَدْحاࣰ ۝٢"],
[3,599,30,"فَالْمُغِيرَٰتِ صُبْحاࣰ ۝٣"],
[4,599,30,"فَأَثَرْنَ بِهِۦ نَقْعاࣰ ۝٤"],
[5,599,30,"فَوَسَطْنَ بِهِۦ جَمْعاً ۝٥"],
[6,600,30,"ࡴنَّ ࡰ۬لِانسَٰنَ لِرَبِّهِۦ لَكَنُودࣱ ۝٦"],
[7,600,30,"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدࣱ ۝٧"],
[8,600,30,"وَإِنَّهُۥ لِحُبِّ ࡴ۬لْخَيْرِ لَشَدِيدٌ࣌ ۝٨"],
[9,600,30,"۞ ࡰفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِے ࡴ۬لْقُبُورِ ۝٩"],
[10,600,30,"وَحُصِّلَ مَا فِے ࡴ۬لصُّدُورِ ۝١٠"],
[11,600,30,"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذࣲ لَّخَبِيرٌ࣌ ۝١١"]
]}
