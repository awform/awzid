{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":104,"name":"ࡲ۬لْهُمَزَةِ","t":[
[1,601,30,"وَيْلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ ۝١"],
[2,601,30,"ࡴ۬لذِے جَمَعَ مَالاࣰ وَعَدَّدَهُۥ ۝٢"],
[3,601,30,"يَحْسِبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ ۝٣"],
[4,601,30,"كَلَّا࣌ لَيُنۢبَذَنَّ فِے ࡴ۬لْحُطَمَةِ࣌ ۝٤"],
[5,601,30,"وَمَآ أَدْرٜيٰكَ مَا ࡰ۬لْحُطَمَةُ࣌ ۝٥"],
[6,601,30,"نَارُ ࡲ۬للَّهِ ࡴ۬لْمُوقَدَةُ ۝٦"],
[7,601,30,"ࡲ۬لتِے تَطَّلِعُ عَلَى ࡰ۬لَافْـِٕدَةِ࣌ ۝٧"],
[8,601,30,"إِنَّهَا عَلَيْهِم مُّوصَدَةࣱ ۝٨"],
[9,601,30,"فِے عَمَدࣲ مُّمَدَّدَةٍ࣌ ۝٩"]
]}
