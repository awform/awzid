{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":92,"name":"ࡲ۬ليْلِ","t":[
[1,595,30,"وَاليْلِ إِذَا يَغْشٜىٰ ۝١"],
[2,595,30,"وَالنَّهٜارِ إِذَا تَجَلّٜىٰ ۝٢"],
[3,595,30,"وَمَا خَلَقَ ࡰ۬لذَّكَرَ وَالُانثٜىٰٓ ۝٣"],
[4,595,30,"إِنَّ سَعْيَكُمْ لَشَتّٜىٰ࣌ ۝٤"],
[5,595,30,"فَأَمَّا مَنَ ࡰعْطٜىٰ وَاتَّقٜىٰ ۝٥"],
[6,595,30,"وَصَدَّقَ بِالْحُسْنٜىٰ ۝٦"],
[7,595,30,"فَسَنُيَسِّرُهُۥ لِلْيُسْرٜىٰ࣌ ۝٧"],
[8,595,30,"وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْنٜىٰ ۝٨"],
[9,595,30,"وَكَذَّبَ بِالْحُسْنٜىٰ ۝٩"],
[10,596,30,"فَسَنُيَسِّرُهُۥ لِلْعُسْرٜىٰ࣌ ۝١٠"],
[11,596,30,"وَمَا يُغْنِے عَنْهُ مَالُهُۥٓ إِذَا تَرَدّٜىٰٓ࣌ ۝١١"],
[12,596,30,"إِنَّ عَلَيْنَا لَلْهُدٜىٰ ۝١٢"],
[13,596,30,"وَإِنَّ لَنَا لَلَاخِرَةَ وَالُاولٜىٰ࣌ ۝١٣"],
[14,596,30,"فَأَنذَرْتُكُمْ نَاراࣰ تَلَظّٜىٰ ۝١٤"],
[15,596,30,"لَا يَصْلَيٰهَآ إِلَّا ࡰ۬لَاشْقَي ۝١٥"],
[16,596,30,"ࡰ۬لذِے كَذَّبَ وَتَوَلّٜىٰ࣌ ۝١٦"],
[17,596,30,"وَسَيُجَنَّبُهَا ࡰ۬لَاتْقَي ۝١٧"],
[18,596,30,"ࡰ۬لذِے يُوتِے مَالَهُۥ يَتَزَكّٜىٰ࣌ ۝١٨"],
[19,596,30,"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةࣲ تُجْزٜىٰٓ ۝١٩"],
[20,596,30,"إِلَّا ࡰٜبْتِغَآءَ وَجْهِ رَبِّهِ ࡴ۬لَاعْلٜىٰ࣌ ۝٢٠"],
[21,596,30,"وَلَسَوْفَ يَرْضٜىٰ࣌ ۝٢١"]
]}
