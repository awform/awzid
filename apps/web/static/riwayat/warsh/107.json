{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":107,"name":"ࡲ۬لْمَاعُونِ","t":[
[1,602,30,"ࡰرَٰٓيْتَ ࡰ۬لذِے يُكَذِّبُ بِالدِّينِ ۝١"],
[2,602,30,"فَذَٰلِكَ ࡰ۬لذِے يَدُعُّ ࡲ۬لْيَتِيمَ ۝٢"],
[3,602,30,"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ࡴ۬لْمِسْكِينِ࣌ ۝٣"],
[4,602,30,"فَوَيْلࣱ لِّلْمُصَلِّينَ ۝٤"],
