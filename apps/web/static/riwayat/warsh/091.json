{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":91,"name":"ࡲ۬لشَّمْسِ","t":[
[1,595,30,"وَالشَّمْسِ وَضُحَيٰهَا ۝١"],
[2,595,30,"وَالْقَمَرِ إِذَا تَلَيٰهَا ۝٢"],
[3,595,30,"وَالنَّهٜارِ إِذَا جَلَّيٰهَا ۝٣"],
[4,595,30,"وَاليْلِ إِذَا يَغْشَيٰهَا ۝٤"],
[5,595,30,"وَالسَّمَآءِ وَمَا بَنَيٰهَا ۝٥"],
[6,595,30,"وَالَارْضِ وَمَا طَحَيٰهَا ۝٦"],
[7,595,30,"وَنَفْسࣲ وَمَا سَوَّيٰهَا ۝٧"],
[8,595,30,"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَيٰهَا ۝٨"],
[9,595,30,"قَدَ ࡰفْلَحَ مَن زَكَّيٰهَا ۝٩"],
[10,595,30,"وَقَدْ خَابَ مَن دَسَّيٰهَا࣌ ۝١٠"],
[11,595,30,"كَذَّبَتْ ثَمُودُ بِطَغْوَيٰهَآ ۝١١"],
[12,595,30,"إِذِ ࡴٜنۢبَعَثَ أَشْقَيٰهَا ۝١٢"],
[13,595,30,"فَقَالَ لَهُمْ رَسُولُ ࡲ۬للَّهِ نَاقَةَ ࡰ۬للَّهِ وَسُقْيَاهَا ۝١٣"],
[14,595,30,"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّيٰهَا࣌ ۝١٤"],
[15,595,30,"فَلَا يَخَافُ عُقْبَٰهَا࣌ ۝١٥"]
]}
