{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":1,"name":"ࡲ۬لْفَاتِحَةِ","t":[
[1,1,1,"ࡴ۬لْحَمْدُ لِلهِ رَبِّ ࡴ۬لْعَٰلَمِينَ ۝١"],
[2,1,1,"ࡰ۬لرَّحْمَٰنِ ࡴ۬لرَّحِيمِ ۝٢"],
[3,1,1,"مَلِكِ يَوْمِ ࡴ۬لدِّينِ࣌ ۝٣"],
[4,1,1,"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ࣌ ۝٤"],
[5,1,1,"ࡲٜهْدِنَا ࡰ۬لصِّرَٰطَ ࡰ۬لْمُسْتَقِيمَ ۝٥"],
[6,1,1,"صِرَٰطَ ࡰ۬لذِينَ أَنْعَمْتَ عَلَيْهِمْ ۝٦"],
[7,1,1,"غَيْرِ ࡴ۬لْمَغْضُوبِ عَلَيْهِمْ وَلَا ࡰ۬لضَّآلِّينَ࣌ ۝٧"]
]}
