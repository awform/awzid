{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":93,"name":"ࡲ۬لضُّحٜيٰ","t":[
[1,596,30,"وَالضُّحٜىٰ ۝١"],
[2,596,30,"وَاليْلِ إِذَا سَجٜىٰ ۝٢"],
[3,596,30,"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٜىٰ࣌ ۝٣"],
[4,596,30,"وَلَلَاخِرَةُ خَيْرࣱ لَّكَ مِنَ ࡰ۬لُاولٜىٰ࣌ ۝٤"],
[5,596,30,"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضٜىٰٓ࣌ ۝٥"],
[6,596,30,"أَلَمْ يَجِدْكَ يَتِيماࣰ فَـَٔاوٜىٰ ۝٦"],
[7,596,30,"وَوَجَدَكَ ضَآلّاࣰ فَهَدٜىٰ ۝٧"],
[8,596,30,"وَوَجَدَكَ عَآئِلاࣰ فَأَغْنٜىٰ࣌ ۝٨"],
[9,596,30,"فَأَمَّا ࡰ۬لْيَتِيمَ فَلَا تَقْهَرْ࣌ ۝٩"],
[10,596,30,"وَأَمَّا ࡰ۬لسَّآئِلَ فَلَا تَنْهَرْ࣌ ۝١٠"],
[11,596,30,"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثَ࣌ ۝١١"]
]}
