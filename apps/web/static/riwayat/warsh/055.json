[1,531,27,"ࡴ۬لرَّحْمَٰنُ عَلَّمَ ࡰ۬لْقُرْءَانَ࣌ ۝١"],
[2,531,27,"خَلَقَ ࡰ۬لِانسَٰنَ عَلَّمَهُ ࡲ۬لْبَيَانَ࣌ ۝٢"],
[3,531,27,"ࡰ۬لشَّمْسُ وَالْقَمَرُ بِحُسْبَانࣲ࣌ ۝٣"],
[4,531,27,"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَٰنِ࣌ ۝٤"],
[5,531,27,"وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ ࡰ۬لْمِيزَانَ ۝٥"],
[6,531,27,"أَلَّا تَطْغَوْاْ فِے ࡴ۬لْمِيزَانِ ۝٦"],
[7,531,27,"وَأَقِيمُواْ ࡲ۬لْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُواْ ࡲ۬لْمِيزَانَ࣌ ۝٧"],
[8,531,27,"وَالَارْضَ وَضَعَهَا لِلَانَامِ ۝٨"],
[9,531,27,"فِيهَا فَٰكِهَةࣱ وَالنَّخْلُ ذَاتُ ࡲ۬لَاكْمَامِ ۝٩"],
[10,531,27,"وَالْحَبُّ ذُو ࡲ۬لْعَصْفِ وَالرَّيْحَانُ࣌ ۝١٠"],
[11,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝١١"],
[12,531,27,"خَلَقَ ࡰ۬لِانسَٰنَ مِن صَلْصَٰلࣲ كَالْفَخّٜارِ ۝١٢"],
[13,531,27,"وَخَلَقَ ࡰ۬لْجَآنَّ مِن مَّارِجࣲ مِّن نّٜارࣲ࣌ ۝١٣"],
[14,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝١٤"],
[15,531,27,"رَبُّ ࡲ۬لْمَشْرِقَيْنِ وَرَبُّ ࡲ۬لْمَغْرِبَيْنِ࣌ ۝١٥"],
[16,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝١٦"],
[17,532,27,"مَرَجَ ࡰ۬لْبَحْرَيْنِ يَلْتَقِيَٰنِ ۝١٧"],
[18,532,27,"بَيْنَهُمَا بَرْزَخࣱ لَّا يَبْغِيَٰنِ࣌ ۝١٨"],
[19,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝١٩"],
[20,532,27,"يُخْرَجُ مِنْهُمَا ࡰ۬للُّؤْلُؤُاْ وَالْمَرْجَانُ࣌ ۝٢٠"],
[21,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٢١"],
[22,532,27,"وَلَهُ ࡲ۬لْجَوَارِ ࡴ۬لْمُنشَأَٰتُ فِے ࡴ۬لْبَحْرِ كَالَاعْلَٰمِ࣌ ۝٢٢"],
[23,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٢٣"],
[24,532,27,"كُلُّ مَنْ عَلَيْهَا فَانࣲ ۝٢٤"],
[25,532,27,"وَيَبْقٜىٰ وَجْهُ رَبِّكَ ذُو ࡲ۬لْجَلَٰلِ وَالِاكْرَامِ࣌ ۝٢٥"],
[26,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٢٦"],
[27,532,27,"يَسْـَٔلُهُۥ مَن فِے ࡴ۬لسَّمَٰوَٰتِ وَالَارْضِ كُلَّ يَوْمٍ هُوَ فِے شَأْنࣲ࣌ ۝٢٧"],
[28,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٢٨"],
[29,532,27,"سَنَفْرُغُ لَكُمُۥٓ أَيُّهَ ࡰ۬لثَّقَلَٰنِ࣌ ۝٢٩"],
[30,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٣٠"],
[31,532,27,"يَٰمَعْشَرَ ࡰ۬لْجِنِّ وَالِانسِ إِنِ ࡴٜسْتَطَعْتُمُۥٓ أَن تَنفُذُواْ مِنَ ࡰقْطٜارِ ࡴ۬لسَّمَٰوَٰتِ وَالَارْضِ فَانفُذُواْ࣌ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنࣲ࣌ ۝٣١"],
[32,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٣٢"],
[33,532,27,"يُرْسَلُ عَلَيْكُمَا شُوَاظࣱ مِّن نّٜارࣲ ۝٣٣"],
[34,532,27,"وَنُحَاسࣱ فَلَا تَنتَصِرَٰنِ࣌ ۝٣٤"],
[35,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٣٥"],
[36,532,27,"فَإِذَا ࡰٜنشَقَّتِ ࡴ۬لسَّمَآءُ فَكَانَتْ وَرْدَةࣰ كَالدِّهَانِ ۝٣٦"],
[37,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٣٧"],
[38,532,27,"فَيَوْمَئِذࣲ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسࣱ وَلَا جَآنࣱّ࣌ ۝٣٨"],
[39,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٣٩"],
[40,532,27,"۞ يُعْرَفُ ࡲ۬لْمُجْرِمُونَ بِسِيمٜـٰهُمْ فَيُوخَذُ بِالنَّوَٰصِے وَالَاقْدَامِ࣌ ۝٤٠"],
[41,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٤١"],
[42,533,27,"هَٰذِهِۦ جَهَنَّمُ ࡲ۬لتِے يُكَذِّبُ بِهَا ࡰ۬لْمُجْرِمُونَ ۝٤٢"],
[43,533,27,"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ اٰنࣲ࣌ ۝٤٣"],
[44,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٤٤"],
[45,533,27,"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَٰنِ ۝٤٥"],
[46,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٤٦"],
[47,533,27,"ذَوَاتَآ أَفْنَانࣲ࣌ ۝٤٧"],
[48,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٤٨"],
[49,533,27,"فِيهِمَا عَيْنَٰنِ تَجْرِيَٰنِ࣌ ۝٤٩"],
[50,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٥٠"],
[51,533,27,"فِيهِمَا مِن كُلِّ فَٰكِهَةࣲ زَوْجَٰنِ࣌ ۝٥١"],
[52,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٥٢"],
[53,533,27,"مُتَّكِـِٕينَ عَلَىٰ فُرُشِۢ بَطَآئِنُهَا مِنِ ࡴسْتَبْرَقࣲ وَجَنَا ࡰ۬لْجَنَّتَيْنِ دَانࣲ࣌ ۝٥٣"],
[54,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٥٤"],
[55,533,27,"فِيهِنَّ قَٰصِرَٰتُ ࡲ۬لطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسࣱ قَبْلَهُمْ وَلَا جَآنࣱّ࣌ ۝٥٥"],
[56,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٥٦"],
[57,533,27,"كَأَنَّهُنَّ ࡰ۬لْيَاقُوتُ وَالْمَرْجَانُ࣌ ۝٥٧"],
[58,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٥٨"],
[59,533,27,"هَلْ جَزَآءُ ࡲ۬لِاحْسَٰنِ إِلَّا ࡰ۬لِاحْسَٰنُ࣌ ۝٥٩"],
[60,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٦٠"],
[61,533,27,"وَمِن دُونِهِمَا جَنَّتَٰنِ ۝٦١"],
[62,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٦٢"],
[63,533,27,"مُدْهَآمَّتَٰنِ࣌ ۝٦٣"],
[64,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٦٤"],
[65,533,27,"فِيهِمَا عَيْنَٰنِ نَضَّاخَتَٰنِ࣌ ۝٦٥"],
[66,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٦٦"],
[67,533,27,"فِيهِمَا فَٰكِهَةࣱ وَنَخْلࣱ وَرُمَّانࣱ࣌ ۝٦٧"],
[68,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٦٨"],
[69,534,27,"فِيهِنَّ خَيْرَٰتٌ حِسَانࣱ࣌ ۝٦٩"],
[70,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٧٠"],
[71,534,27,"حُورࣱ مَّقْصُورَٰتࣱ فِے ࡴ۬لْخِيَامِ࣌ ۝٧١"],
[72,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٧٢"],
[73,534,27,"لَمْ يَطْمِثْهُنَّ إِنسࣱ قَبْلَهُمْ وَلَا جَآنࣱّ࣌ ۝٧٣"],
[74,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٧٤"],
[75,534,27,"مُتَّكِـِٕينَ عَلَىٰ رَفْرَفٍ خُضْرࣲ وَعَبْقَرِيٍّ حِسَانࣲ࣌ ۝٧٥"],
[76,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ࣌ ۝٧٦"],
[77,534,27,"تَبَٰرَكَ ࡰٜسْمُ رَبِّكَ ذِے ࡴ۬لْجَلَٰلِ وَالِاكْرَامِ࣌ ۝٧٧"]
