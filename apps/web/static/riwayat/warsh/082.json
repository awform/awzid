{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":82,"name":"ࡲ۬لِانفِطَارِ","t":[
[1,587,30,"إِذَا ࡰ۬لسَّمَآءُ ࡲٜنفَطَرَتْ ۝١"],
[2,587,30,"وَإِذَا ࡰ۬لْكَوَاكِبُ ࡲٜنتَثَرَتْ ۝٢"],
[3,587,30,"وَإِذَا ࡰ۬لْبِحَارُ فُجِّرَتْ ۝٣"],
[4,587,30,"وَإِذَا ࡰ۬لْقُبُورُ بُعْثِرَتْ ۝٤"],
[5,587,30,"عَلِمَتْ نَفْسࣱ مَّا قَدَّمَتْ وَأَخَّرَتْ࣌ ۝٥"],
[6,587,30,"يَٰٓأَيُّهَا ࡰ۬لِانسَٰنُ مَا غَرَّكَ بِرَبِّكَ ࡰ۬لْكَرِيمِ ۝٦"],
[7,587,30,"ࡴ۬لذِے خَلَقَكَ فَسَوّٜيٰكَ فَعَدَّلَكَ ۝٧"],
[8,587,30,"فِےٓ أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَكَ࣌ ۝٨"],
[9,587,30,"كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ ۝٩"],
[10,587,30,"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ ۝١٠"],
[11,587,30,"كِرَاماࣰ كَٰتِبِينَ ۝١١"],
[12,587,30,"يَعْلَمُونَ مَا تَفْعَلُونَ࣌ ۝١٢"],
[13,587,30,"إِنَّ ࡰ۬لَابْرَارَ لَفِے نَعِيمࣲ࣌ ۝١٣"],
[14,587,30,"وَإِنَّ ࡰ۬لْفُجَّارَ لَفِے جَحِيمࣲ ۝١٤"],
[15,587,30,"يَصْلَوْنَهَا يَوْمَ ࡰ۬لدِّينِ ۝١٥"],
[16,587,30,"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ࣌ ۝١٦"],
[17,587,30,"وَمَآ أَدْرٜيٰكَ مَا يَوْمُ ࡲ۬لدِّينِ ۝١٧"],
[18,587,30,"ثُمَّ مَآ أَدْرٜيٰكَ مَا يَوْمُ ࡲ۬لدِّينِ࣌ ۝١٨"],
[19,587,30,"يَوْمَ لَا تَمْلِكُ نَفْسࣱ لِّنَفْسࣲ شَيْـٔاࣰ࣌ وَالَامْرُ يَوْمَئِذࣲ لِّلهِ࣌ ۝١٩"]
]}
