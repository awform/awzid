{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":105,"name":"ࡲ۬لْفِيلِ","t":[
[1,601,30,"ࡰلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ࡴ۬لْفِيلِ࣌ ۝١"],
[2,601,30,"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِے تَضْلِيلࣲ ۝٢"],
[3,601,30,"وَأَرْسَلَ عَلَيْهِمْ طَيْراً ࡰبَابِيلَ ۝٣"],
[4,601,30,"تَرْمِيهِم بِحِجَارَةࣲ مِّن سِجِّيلࣲ ۝٤"],
[5,601,30,"فَجَعَلَهُمْ كَعَصْفࣲ مَّاكُولࣲ࣌ ۝٥"]
]}
