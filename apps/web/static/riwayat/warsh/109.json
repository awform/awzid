{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":109,"name":"ࡲ۬لْكَٰفِرُونَ","t":[
[1,603,30,"قُلْ يَٰٓأَيُّهَا ࡰ۬لْكَٰفِرُونَ ۝١"],
[2,603,30,"لَآ أَعْبُدُ مَا تَعْبُدُونَ ۝٢"],
[3,603,30,"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ࣌ ۝٣"],
[4,603,30,"وَلَآ أَنَا عَابِدࣱ مَّا عَبَدتُّمْ ۝٤"],
[5,603,30,"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ࣌ ۝٥"],
[6,603,30,"لَكُمْ دِينُكُمْ وَلِيَ دِينِ࣌ ۝٦"]
]}
