{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":89,"name":"ࡲ۬لْفَجْرِ","t":[
[1,593,30,"وَالْفَجْرِ ۝١"],
[2,593,30,"وَلَيَالٍ عَشْرࣲ ۝٢"],
[3,593,30,"وَالشَّفْعِ وَالْوَتْرِ ۝٣"],
[4,593,30,"وَاليْلِ إِذَا يَسْرِۦ ۝٤"],
[5,593,30,"هَلْ فِے ذَٰلِكَ قَسَمࣱ لِّذِے حِجْرٍ࣌ ۝٥"],
[6,593,30,"ࡰلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ ۝٦"],
[7,593,30,"ࡴرَمَ ذَاتِ ࡴ۬لْعِمَادِ ۝٧"],
[8,593,30,"ࡴ۬لتِے لَمْ يُخْلَقْ مِثْلُهَا فِے ࡴ۬لْبِلَٰدِ ۝٨"],
[9,593,30,"وَثَمُودَ ࡰ۬لذِينَ جَابُواْ ࡲ۬لصَّخْرَ بِالْوَادِۦ ۝٩"],
[10,593,30,"وَفِرْعَوْنَ ذِے ࡴ۬لَاوْتَادِ ۝١٠"],
[11,593,30,"ࡴ۬لذِينَ طَغَوْاْ فِے ࡴ۬لْبِلَٰدِ ۝١١"],
[12,593,30,"فَأَكْثَرُواْ فِيهَا ࡰ۬لْفَسَادَ ۝١٢"],
[13,593,30,"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ࣌ ۝١٣"],
[14,593,30,"ࡴنَّ رَبَّكَ لَبِالْمِرْصَادِ࣌ ۝١٤"],
[15,593,30,"فَأَمَّا ࡰ۬لِانسَٰنُ إِذَا مَا ࡰٜبْتَلٜيٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ ۝١٥"],
[16,593,30,"فَيَقُولُ رَبِّيَ أَكْرَمَنِۦ࣌ ۝١٦"],
[17,593,30,"وَأَمَّآ إِذَا مَا ࡰٜبْتَلٜيٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ ۝١٧"],
[18,593,30,"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ ۝١٨"],
[19,593,30,"كَلَّا࣌ بَل لَّا تُكْرِمُونَ ࡰ۬لْيَتِيمَ ۝١٩"],
[20,593,30,"وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ ࡴ۬لْمِسْكِينِ ۝٢٠"],
[21,593,30,"وَتَاكُلُونَ ࡰ۬لتُّرَاثَ أَكْلاࣰ لَّمّاࣰ ۝٢١"],
[22,593,30,"وَتُحِبُّونَ ࡰ۬لْمَالَ حُبّاࣰ جَمّاࣰ ۝٢٢"],
[23,593,30,"كَلَّآ࣌ إِذَا دُكَّتِ ࡴ۬لَارْضُ دَكّاࣰ دَكّاࣰ ۝٢٣"],
[24,593,30,"وَجَآءَ رَبُّكَ وَالْمَلَكُ صَفّاࣰ صَفّاࣰ ۝٢٤"],
[25,594,30,"وَجِےٓءَ يَوْمَئِذِۢ بِجَهَنَّمَ ۝٢٥"],
[26,594,30,"يَوْمَئِذࣲ يَتَذَكَّرُ ࡲ۬لِانسَٰنُ وَأَنّٜىٰ لَهُ ࡲ۬لذِّكْرٜىٰ࣌ ۝٢٦"],
[27,594,30,"يَقُولُ يَٰلَيْتَنِے قَدَّمْتُ لِحَيَاتِے࣌ ۝٢٧"],
[28,594,30,"فَيَوْمَئِذࣲ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدࣱ ۝٢٨"],
[29,594,30,"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدࣱ࣌ ۝٢٩"],
[30,594,30,"يَٰٓأَيَّتُهَا ࡰ۬لنَّفْسُ ࡲ۬لْمُطْمَئِنَّةُ ۝٣٠"],
[31,594,30,"ࡲٜرْجِعِےٓ إِلَىٰ رَبِّكِ رَاضِيَةࣰ مَّرْضِيَّةࣰ ۝٣١"],
[32,594,30,"فَادْخُلِے فِے عِبَٰدِے وَادْخُلِے جَنَّتِے࣌ ۝٣٢"]
]}
