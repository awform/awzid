{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":75,"name":"ࡲ۬لْقِيَٰمَةِ","t":[
[1,577,29,"لَآ أُقْسِمُ بِيَوْمِ ࡴ۬لْقِيَٰمَةِ ۝١"],
[2,577,29,"وَلَآ أُقْسِمُ بِالنَّفْسِ ࡴ۬للَّوَّامَةِ࣌ ۝٢"],
[3,577,29,"أَيَحْسِبُ ࡲ۬لِانسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ ۝٣"],
[4,577,29,"بَلٜىٰ࣌ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ࣌ ۝٤"],
[5,577,29,"بَلْ يُرِيدُ ࡲ۬لِانسَٰنُ لِيَفْجُرَ أَمَامَهُۥ࣌ ۝٥"],
[6,577,29,"يَسْـَٔلُ أَيَّانَ يَوْمُ ࡲ۬لْقِيَٰمَةِ࣌ ۝٦"],
[7,577,29,"فَإِذَا بَرَقَ ࡰ۬لْبَصَرُ ۝٧"],
[8,577,29,"وَخَسَفَ ࡰ۬لْقَمَرُ ۝٨"],
[9,577,29,"وَجُمِعَ ࡰ۬لشَّمْسُ وَالْقَمَرُ ۝٩"],
[10,577,29,"يَقُولُ ࡲ۬لِانسَٰنُ يَوْمَئِذٍ ࡰيْنَ ࡰ۬لْمَفَرُّ࣌ ۝١٠"],
[11,577,29,"كَلَّا لَا وَزَرَ࣌ ۝١١"],
[12,577,29,"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ࡴ۬لْمُسْتَقَرُّ࣌ ۝١٢"],
[13,577,29,"يُنَبَّؤُاْ ࡲ۬لِانسَٰنُ يَوْمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَ࣌ ۝١٣"],
[14,577,29,"بَلِ ࡴ۬لِانسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةࣱ ۝١٤"],
[15,577,29,"وَلَوَ ࡰلْقٜىٰ مَعَاذِيرَهُۥ࣌ ۝١٥"],
[16,577,29,"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ࣌ إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ࣌ ۝١٦"],
[17,577,29,"فَإِذَا قَرَأْنَٰهُ فَاتَّبِعْ قُرْءَانَهُۥ ۝١٧"],
[18,577,29,"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ࣌ ۝١٨"],
[19,578,29,"كَلَّا بَلْ تُحِبُّونَ ࡰ۬لْعَاجِلَةَ ۝١٩"],
[20,578,29,"وَتَذَرُونَ ࡰ۬لَاخِرَةَ࣌ ۝٢٠"],
[21,578,29,"وُجُوهࣱ يَوْمَئِذࣲ نَّاضِرَةٌ ۝٢١"],
[22,578,29,"ࡴلَىٰ رَبِّهَا نَاظِرَةࣱ࣌ ۝٢٢"],
[23,578,29,"وَوُجُوهࣱ يَوْمَئِذِۢ بَاسِرَةࣱ ۝٢٣"],
[24,578,29,"تَظُنُّ أَنْ يُّفْعَلَ بِهَا فَاقِرَةࣱ࣌ ۝٢٤"],
[25,578,29,"كَلَّآ إِذَا بَلَغَتِ ࡴ۬لتَّرَاقِيَ ۝٢٥"],
[26,578,29,"وَقِيلَ مَن رَّاقࣲ ۝٢٦"],
[27,578,29,"وَظَنَّ أَنَّهُ ࡲ۬لْفِرَاقُ ۝٢٧"],
[28,578,29,"وَالْتَفَّتِ ࡴ۬لسَّاقُ بِالسَّاقِ ۝٢٨"],
[29,578,29,"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ࡴ۬لْمَسَاقُ࣌ ۝٢٩"],
[30,578,29,"فَلَا صَدَّقَ وَلَا صَلّٜىٰ࣌ ۝٣٠"],
[31,578,29,"وَلَٰكِن كَذَّبَ وَتَوَلّٜىٰ࣌ ۝٣١"],
[32,578,29,"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطّٜىٰٓ࣌ ۝٣٢"],
[33,578,29,"أَوْلٜىٰ لَكَ فَأَوْلٜىٰ ۝٣٣"],
[34,578,29,"ثُمَّ أَوْلٜىٰ لَكَ فَأَوْلٜىٰٓ࣌ ۝٣٤"],
[35,578,29,"أَيَحْسِبُ ࡲ۬لِانسَٰنُ أَنْ يُّتْرَكَ سُدىً࣌ ۝٣٥"],
[36,578,29,"ࡰلَمْ يَكُ نُطْفَةࣰ مِّن مَّنِيࣲّ تُمْنٜىٰ ۝٣٦"],
[37,578,29,"ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوّٜىٰ ۝٣٧"],
[38,578,29,"فَجَعَلَ مِنْهُ ࡲ۬لزَّوْجَيْنِ ࡴ۬لذَّكَرَ وَالُانثٜىٰٓ࣌ ۝٣٨"],
[39,578,29,"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَنْ يُّحْۑِيَ ࡰ۬لْمَوْتٜىٰ࣌ ۝٣٩"]
]}
