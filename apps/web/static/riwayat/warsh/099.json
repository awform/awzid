{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":99,"name":"ࡲ۬لزَّلْزَلَةِ","t":[
[1,599,30,"إِذَا زُلْزِلَتِ ࡴ۬لَارْضُ زِلْزَالَهَا ۝١"],
[2,599,30,"وَأَخْرَجَتِ ࡴ۬لَارْضُ أَثْقَالَهَا ۝٢"],
[3,599,30,"وَقَالَ ࡰ۬لِانسَٰنُ مَا لَهَا ۝٣"],
[4,599,30,"يَوْمَئِذࣲ تُحَدِّثُ أَخْبَارَهَا ۝٤"],
[5,599,30,"بِأَنَّ رَبَّكَ أَوْحٜىٰ لَهَا࣌ ۝٥"],
[6,599,30,"يَوْمَئِذࣲ يَصْدُرُ ࡲ۬لنَّاسُ أَشْتَاتاࣰ ۝٦"],
[7,599,30,"لِّيُرَوَاْ ࡰعْمَٰلَهُمْ࣌ ۝٧"],
[8,599,30,"فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْراࣰ يَرَهُۥ࣌ ۝٨"],
[9,599,30,"وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةࣲ شَرّاࣰ يَرَهُۥ࣌ ۝٩"]
]}
