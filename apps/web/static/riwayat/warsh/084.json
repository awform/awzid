{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":84,"name":"ࡲ۬لِانشِقَاقِ","t":[
[1,589,30,"إِذَا ࡰ۬لسَّمَآءُ ࡲٜنشَقَّتْ ۝١"],
[2,589,30,"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ ۝٢"],
[3,589,30,"وَإِذَا ࡰ۬لَارْضُ مُدَّتْ ۝٣"],
[4,589,30,"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ ۝٤"],
[5,589,30,"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ࣌ ۝٥"],
[6,589,30,"يَٰٓأَيُّهَا ࡰ۬لِانسَٰنُ إِنَّكَ كَادِحٌ ࡴلَىٰ رَبِّكَ كَدْحاࣰ فَمُلَٰقِيهِ࣌ ۝٦"],
[7,589,30,"فَأَمَّا مَنُ ࡳوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ ۝٧"],
[8,589,30,"فَسَوْفَ يُحَاسَبُ حِسَاباࣰ يَسِيراࣰ ۝٨"],
[9,589,30,"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُوراࣰ࣌ ۝٩"],
[10,589,30,"وَأَمَّا مَنُ ࡳوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ ۝١٠"],
[11,589,30,"فَسَوْفَ يَدْعُواْ ثُبُوراࣰ ۝١١"],
[12,589,30,"وَيُصَلَّىٰ سَعِيراً࣌ ۝١٢"],
[13,589,30,"ࡴنَّهُۥ كَانَ فِےٓ أَهْلِهِۦ مَسْرُوراً࣌ ۝١٣"],
[14,589,30,"ࡴنَّهُۥ ظَنَّ أَن لَّنْ يَّحُورَ ۝١٤"],
[15,589,30,"بَلٜىٰٓ࣌ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيراࣰ࣌ ۝١٥"],
[16,589,30,"۞ فَلَآ أُقْسِمُ بِالشَّفَقِ ۝١٦"],
[17,589,30,"وَاليْلِ وَمَا وَسَقَ ۝١٧"],
[18,589,30,"وَالْقَمَرِ إِذَا ࡰٜتَّسَقَ ۝١٨"],
[19,589,30,"لَتَرْكَبُنَّ طَبَقاً عَن طَبَقࣲ࣌ ۝١٩"],
[20,589,30,"فَمَا لَهُمْ لَا يُومِنُونَ ۝٢٠"],
[21,589,30,"وَإِذَا قُرِۓَ عَلَيْهِمُ ࡲ۬لْقُرْءَانُ لَا يَسْجُدُونَ࣌۩ ۝٢١"],
[22,589,30,"بَلِ ࡴ۬لذِينَ كَفَرُواْ يُكَذِّبُونَ ۝٢٢"],
[23,589,30,"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ࣌ ۝٢٣"],
[24,589,30,"فَبَشِّرْهُم بِعَذَابٍ ࡰلِيمٍ࣌ ۝٢٤"],
[25,590,30,"ࡴلَّا ࡰ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ ࡲ۬لصَّٰلِحَٰتِ لَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونࣲ࣌ ۝٢٥"]
]}
