{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":94,"name":"ࡲ۬لشَّرْحِ","t":[
[1,596,30,"ࡰلَمْ نَشْرَحْ لَكَ صَدْرَكَ ۝١"],
[2,596,30,"وَوَضَعْنَا عَنكَ وِزْرَكَ ۝٢"],
[3,597,30,"ࡰ۬لذِےٓ أَنقَضَ ظَهْرَكَ ۝٣"],
[4,597,30,"وَرَفَعْنَا لَكَ ذِكْرَكَ࣌ ۝٤"],
[5,597,30,"فَإِنَّ مَعَ ࡰ۬لْعُسْرِ يُسْراً ۝٥"],
[6,597,30,"ࡴنَّ مَعَ ࡰ۬لْعُسْرِ يُسْراࣰ࣌ ۝٦"],
[7,597,30,"فَإِذَا فَرَغْتَ فَانصَبْ ۝٧"],
[8,597,30,"وَإِلَىٰ رَبِّكَ فَارْغَبْ࣌ ۝٨"]
]}
