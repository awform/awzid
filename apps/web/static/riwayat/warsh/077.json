{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":77,"name":"ࡲ۬لْمُرْسَلَٰت","t":[
[1,580,29,"وَالْمُرْسَلَٰتِ عُرْفاࣰ ۝١"],
[2,580,29,"فَالْعَٰصِفَٰتِ عَصْفاࣰ ۝٢"],
[3,580,29,"وَالنَّٰشِرَٰتِ نَشْراࣰ ۝٣"],
[4,580,29,"فَالْفَٰرِقَٰتِ فَرْقاࣰ ۝٤"],
[5,580,29,"فَالْمُلْقِيَٰتِ ذِكْراً ۝٥"],
[6,580,29,"عُذْراً ࡰوْ نُذُراً ۝٦"],
[7,580,29,"ࡴنَّمَا تُوعَدُونَ لَوَٰقِعࣱ࣌ ۝٧"],
[8,580,29,"فَإِذَا ࡰ۬لنُّجُومُ طُمِسَتْ ۝٨"],
[9,580,29,"وَإِذَا ࡰ۬لسَّمَآءُ فُرِجَتْ ۝٩"],
[10,580,29,"وَإِذَا ࡰ۬لْجِبَالُ نُسِفَتْ ۝١٠"],
[11,580,29,"وَإِذَا ࡰ۬لرُّسُلُ أُقِّتَتْ ۝١١"],
[12,580,29,"لِأَيِّ يَوْمٍ ࡳجِّلَتْ ۝١٢"],
[13,580,29,"لِيَوْمِ ࡴ۬لْفَصْلِ࣌ ۝١٣"],
[14,580,29,"وَمَآ أَدْرٜيٰكَ مَا يَوْمُ ࡲ۬لْفَصْلِ࣌ ۝١٤"],
[15,580,29,"وَيْلࣱ يَوْمَئِذࣲ لِّلْمُكَذِّبِينَ࣌ ۝١٥"],
[16,580,29,"۞ أَلَمْ نُهْلِكِ ࡴ۬لَاوَّلِينَ࣌ ۝١٦"],
[17,580,29,"ثُمَّ نُتْبِعُهُمُ ࡲ۬لَاخِرِينَ࣌ ۝١٧"],
[18,580,29,"كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَ࣌ ۝١٨"],
[19,580,29,"وَيْلࣱ يَوْمَئِذࣲ لِّلْمُكَذِّبِينَ࣌ ۝١٩"],
[20,581,29,"أَلَمْ نَخْلُقكُّم مِّن مَّآءࣲ مَّهِينࣲ ۝٢٠"],
[21,581,29,"فَجَعَلْنَٰهُ فِے قَرٜارࣲ مَّكِينٍ ۝٢١"],
[22,581,29,"ࡴلَىٰ قَدَرࣲ مَّعْلُومࣲ ۝٢٢"],
[23,581,29,"فَقَدَّرْنَا࣌ فَنِعْمَ ࡰ۬لْقَٰدِرُونَ࣌ ۝٢٣"],
[24,581,29,"وَيْلࣱ يَوْمَئِذࣲ لِّلْمُكَذِّبِينَ࣌ ۝٢٤"],
[25,581,29,"أَلَمْ نَجْعَلِ ࡴ۬لَارْضَ كِفَاتاً ۝٢٥"],
[26,581,29,"ࡰحْيَآءࣰ وَأَمْوَٰتاࣰ ۝٢٦"],
[27,581,29,"وَجَعَلْنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتࣲ وَأَسْقَيْنَٰكُم مَّآءࣰ فُرَاتاࣰ࣌ ۝٢٧"],
[28,581,29,"وَيْلࣱ يَوْمَئِذࣲ لِّلْمُكَذِّبِينَ࣌ ۝٢٨"],
[29,581,29,"ࡰٜنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ ۝٢٩"],
[30,581,29,"ࡰٜنطَلِقُوٓاْ إِلَىٰ ظِلࣲّ ذِے ثَلَٰثِ شُعَبࣲ ۝٣٠"],
[31,581,29,"لَّا ظَلِيلࣲ وَلَا يُغْنِے مِنَ ࡰ۬للَّهَبِ࣌ ۝٣١"],
[32,581,29,"إِنَّهَا تَرْمِے بِشَرَرࣲ كَالْقَصْرِ ۝٣٢"],
[33,581,29,"كَأَنَّهُۥ جِمَٰلَٰتࣱ صُفْرࣱ࣌ ۝٣٣"],
[34,581,29,"وَيْلࣱ يَوْمَئِذࣲ لِّلْمُكَذِّبِينَ࣌ ۝٣٤"],
[35,581,29,"هَٰذَا يَوْمُ لَا يَنطِقُونَ ۝٣٥"],
[36,581,29,"وَلَا يُوذَنُ لَهُمْ فَيَعْتَذِرُونَ࣌ ۝٣٦"],
[37,581,29,"وَيْلࣱ يَوْمَئِذࣲ لِّلْمُكَذِّبِينَ࣌ ۝٣٧"],
[38,581,29,"هَٰذَا يَوْمُ ࡲ۬لْفَصْلِ جَمَعْنَٰكُمْ وَالَاوَّلِينَ ۝٣٨"],
[39,581,29,"فَإِن كَانَ لَكُمْ كَيْدࣱ فَكِيدُونِ࣌ ۝٣٩"],
[40,581,29,"وَيْلࣱ يَوْمَئِذࣲ لِّلْمُكَذِّبِينَ࣌ ۝٤٠"],
[41,581,29,"إِنَّ ࡰ۬لْمُتَّقِينَ فِے ظِلَٰلࣲ وَعُيُونࣲ ۝٤١"],
[42,581,29,"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ࣌ ۝٤٢"],
[43,581,29,"كُلُواْ وَاشْرَبُواْ࣌ هَنِيٓـٔاَۢ بِمَا كُنتُمْ تَعْمَلُونَ࣌ ۝٤٣"],
[44,581,29,"إِنَّا كَذَٰلِكَ نَجْزِے ࡴ۬لْمُحْسِنِينَ࣌ ۝٤٤"],
[45,581,29,"وَيْلࣱ يَوْمَئِذࣲ لِّلْمُكَذِّبِينَ࣌ ۝٤٥"],
[46,581,29,"كُلُواْ وَتَمَتَّعُواْ قَلِيلاً ࡴنَّكُم مُّجْرِمُونَ࣌ ۝٤٦"],
[47,581,29,"وَيْلࣱ يَوْمَئِذࣲ لِّلْمُكَذِّبِينَ࣌ ۝٤٧"],
[48,581,29,"وَإِذَا قِيلَ لَهُمُ ࡲٜرْكَعُواْ لَا يَرْكَعُونَ࣌ ۝٤٨"],
[49,581,29,"وَيْلࣱ يَوْمَئِذࣲ لِّلْمُكَذِّبِينَ࣌ ۝٤٩"],
[50,581,29,"فَبِأَيِّ حَدِيثِۢ بَعْدَهُۥ يُومِنُونَ࣌ ۝٥٠"]
]}
