{"v":1,"key":"warsh","version":"kfgqpc_warsh_v30","source":"KFGQPC","s":74,"name":"ࡲ۬لْمُدَّثِّرِ","t":[
[1,575,29,"يَٰٓأَيُّهَا ࡰ۬لْمُدَّثِّرُ ۝١"],
[2,575,29,"قُمْ فَأَنذِرْ࣌ ۝٢"],
[3,575,29,"وَرَبَّكَ فَكَبِّرْ࣌ ۝٣"],
[4,575,29,"وَثِيَابَكَ فَطَهِّرْ࣌ ۝٤"],
[5,575,29,"وَالرِّجْزَ فَاهْجُرْ࣌ ۝٥"],
[6,575,29,"وَلَا تَمْنُن تَسْتَكْثِرُ࣌ ۝٦"],
[7,575,29,"وَلِرَبِّكَ فَاصْبِرْ࣌ ۝٧"],
[8,575,29,"فَإِذَا نُقِرَ فِے ࡴ۬لنَّاقُورِ ۝٨"],
[9,575,29,"فَذَٰلِكَ يَوْمَئِذࣲ يَوْمٌ عَسِيرٌ ۝٩"],
[10,575,29,"عَلَى ࡰ۬لْكٜـٰفِرِينَ غَيْرُ يَسِيرࣲ࣌ ۝١٠"],
[11,575,29,"ذَرْنِے وَمَنْ خَلَقْتُ وَحِيداࣰ ۝١١"],
[12,575,29,"وَجَعَلْتُ لَهُۥ مَالاࣰ مَّمْدُوداࣰ ۝١٢"],
[13,575,29,"وَبَنِينَ شُهُوداࣰ ۝١٣"],
[14,575,29,"وَمَهَّدتُّ لَهُۥ تَمْهِيداࣰ ۝١٤"],
[15,575,29,"ثُمَّ يَطْمَعُ أَنَ ࡰزِيدَ ۝١٥"],
[16,575,29,"كَلَّآ࣌ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيداࣰ࣌ ۝١٦"],
[17,575,29,"سَأُرْهِقُهُۥ صَعُوداً࣌ ۝١٧"],
[18,575,29,"ࡴنَّهُۥ فَكَّرَ وَقَدَّرَ ۝١٨"],
[19,576,29,"فَقُتِلَ كَيْفَ قَدَّرَ ۝١٩"],
[20,576,29,"ثُمَّ قُتِلَ كَيْفَ قَدَّرَ ۝٢٠"],
[21,576,29,"ثُمَّ نَظَرَ ۝٢١"],
[22,576,29,"ثُمَّ عَبَسَ وَبَسَرَ ۝٢٢"],
[23,576,29,"ثُمَّ أَدْبَرَ وَاسْتَكْبَرَ ۝٢٣"],
[24,576,29,"فَقَالَ إِنْ هَٰذَآ إِلَّا سِحْرࣱ يُوثَرُ ۝٢٤"],
[25,576,29,"إِنْ هَٰذَآ إِلَّا قَوْلُ ࡲ۬لْبَشَرِ࣌ ۝٢٥"],
[26,576,29,"سَأُصْلِيهِ سَقَرَ࣌ ۝٢٦"],
[27,576,29,"وَمَآ أَدْرٜيٰكَ مَا سَقَرُ࣌ ۝٢٧"],
[28,576,29,"لَا تُبْقِے وَلَا تَذَرُ࣌ ۝٢٨"],
[29,576,29,"لَوَّاحَةࣱ لِّلْبَشَرِ࣌ ۝٢٩"],
[30,576,29,"عَلَيْهَا تِسْعَةَ عَشَرَ࣌ ۝٣٠"],
[31,576,29,"۞ وَمَا جَعَلْنَآ أَصْحَٰبَ ࡰ۬لنّٜارِ إِلَّا مَلَٰٓئِكَةࣰ࣌ وَمَا جَعَلْنَا عِدَّتَهُمُۥٓ إِلَّا فِتْنَةࣰ لِّلذِينَ كَفَرُواْ لِيَسْتَيْقِنَ ࡰ۬لذِينَ أُوتُواْ ࡲ۬لْكِتَٰبَ وَيَزْدَادَ ࡰ۬لذِينَ ءَامَنُوٓاْ إِيمَٰناࣰ وَلَا يَرْتَابَ ࡰ۬لذِينَ أُوتُواْ ࡲ۬لْكِتَٰبَ وَالْمُومِنُونَ وَلِيَقُولَ ࡰ۬لذِينَ فِے قُلُوبِهِم مَّرَضࣱ وَالْكَٰفِرُونَ مَاذَآ أَرَادَ ࡰ۬للَّهُ بِهَٰذَا مَثَلاࣰ࣌ كَذَٰلِكَ يُضِلُّ ࡲ۬للَّهُ مَنْ يَّشَآءُ وَيَهْدِے مَنْ يَّشَآءُ࣌ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ࣌ وَمَا هِيَ إِلَّا ذِكْرٜىٰ لِلْبَشَرِ࣌ ۝٣١"],
[32,576,29,"كَلَّا وَالْقَمَرِ ۝٣٢"],
[33,576,29,"وَاليْلِ إِذَ ࡰدْبَرَ ۝٣٣"],
[34,576,29,"وَالصُّبْحِ إِذَآ أَسْفَرَ ۝٣٤"],
[35,576,29,"إِنَّهَا لَإِحْدَى ࡰ۬لْكُبَرِ ۝٣٥"],
[36,576,29,"نَذِيراࣰ لِّلْبَشَرِ ۝٣٦"],
[37,576,29,"لِمَن شَآءَ مِنكُمُۥٓ أَنْ يَّتَقَدَّمَ أَوْ يَتَأَخَّرَ࣌ ۝٣٧"],
[38,576,29,"كُلُّ نَفْسِۢ بِمَا كَسَبَتْ رَهِينَةٌ ۝٣٨"],
[39,576,29,"ࡴلَّآ أَصْحَٰبَ ࡰ۬لْيَمِينِ࣌ ۝٣٩"],
[40,576,29,"فِے جَنَّٰتࣲ يَتَسَآءَلُونَ عَنِ ࡴ۬لْمُجْرِمِينَ ۝٤٠"],
[41,576,29,"مَا سَلَكَكُمْ فِے سَقَرَ࣌ ۝٤١"],
[42,576,29,"قَالُواْ لَمْ نَكُ مِنَ ࡰ۬لْمُصَلِّينَ ۝٤٢"],
[43,576,29,"وَلَمْ نَكُ نُطْعِمُ ࡲ۬لْمِسْكِينَ ۝٤٣"],
[44,576,29,"وَكُنَّا نَخُوضُ مَعَ ࡰ۬لْخَآئِضِينَ ۝٤٤"],
[45,576,29,"وَكُنَّا نُكَذِّبُ بِيَوْمِ ࡴ۬لدِّينِ ۝٤٥"],
[46,576,29,"حَتَّىٰٓ أَتٜيٰنَا ࡰ۬لْيَقِينُ࣌ ۝٤٦"],
[47,577,29,"فَمَا تَنفَعُهُمْ شَفَٰعَةُ ࡲ۬لشَّٰفِعِينَ࣌ ۝٤٧"],
[48,577,29,"فَمَا لَهُمْ عَنِ ࡴ۬لتَّذْكِرَةِ مُعْرِضِينَ ۝٤٨"],
[49,577,29,"كَأَنَّهُمْ حُمُرࣱ مُّسْتَنفَرَةࣱ ۝٤٩"],
[50,577,29,"فَرَّتْ مِن قَسْوَرَةِۢ࣌ ۝٥٠"],
[51,577,29,"بَلْ يُرِيدُ كُلُّ ࡲٜمْرِےࣲٕ مِّنْهُمُۥٓ أَنْ يُّوتٜىٰ صُحُفاࣰ مُّنَشَّرَةࣰ࣌ ۝٥١"],
[52,577,29,"كَلَّا بَل لَّا يَخَافُونَ ࡰ۬لَاخِرَةَ࣌ ۝٥٢"],
[53,577,29,"كَلَّآ إِنَّهُۥ تَذْكِرَةࣱ࣌ ۝٥٣"],
[54,577,29,"فَمَن شَآءَ ذَكَرَهُۥ࣌ ۝٥٤"],
[55,577,29,"وَمَا تَذْكُرُونَ إِلَّآ أَنْ يَّشَآءَ ࡰ۬للَّهُ࣌ هُوَ أَهْلُ ࡲ۬لتَّقْوٜىٰ وَأَهْلُ ࡲ۬لْمَغْفِرَةِ࣌ ۝٥٥"]
]}
