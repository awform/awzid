{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":90,"name":"البَلَدِ","t":[
[1,594,30,"لَا أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ ۝١"],
[2,594,30,"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ ۝٢"],
[3,594,30,"وَوَالِدࣲ وَمَا وَلَدَ ۝٣"],
[4,594,30,"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ ۝٤"],
[5,594,30,"أَيَحۡسِبُ أَن لَّن يَقۡدِرَ عَلَيۡهِۦ أَحَدࣱ ۝٥"],
[6,594,30,"يَقُولُ أَهۡلَكۡتُ مَالࣰا لُّبَدًا ۝٦"],
[7,594,30,"أَيَحۡسِبُ أَن لَّمۡ يَرَهُۥ أَحَدٌ ۝٧"],
[8,594,30,"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ ۝٨"],
[9,594,30,"وَلِسَانࣰا وَشَفَتَيۡنِ ۝٩"],
[10,594,30,"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ ۝١٠"],
[11,594,30,"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ ۝١١"],
[12,594,30,"وَمَا أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ ۝١٢"],
[13,594,30,"فَكَّ رَقَبَةً ۝١٣"],
[14,594,30,"أَوۡ أَطۡعَمَ فِي يَوۡمࣲ ذِي مَسۡغَبَةࣲ ۝١٤"],
[15,594,30,"يَتِيمࣰا ذَا مَقۡرَبَةٍ ۝١٥"],
[16,594,30,"أَوۡ مِسۡكِينࣰا ذَا مَتۡرَبَةࣲ ۝١٦"],
[17,594,30,"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ ۝١٧"],
[18,594,30,"أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ۝١٨"],
[19,595,30,"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمُۥ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ ۝١٩"],
[20,595,30,"عَلَيۡهِمُۥ نَارࣱ مُّوصَدَةُۢ ۝٢٠"]
]}
