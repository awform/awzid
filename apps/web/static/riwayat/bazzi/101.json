{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":101,"name":"القَارِعَةِ","t":[
[1,600,30,"ٱلۡقَارِعَةُ مَا ٱلۡقَارِعَةُ ۝١"],
[2,600,30,"وَمَا أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ ۝٢"],
[3,600,30,"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ ۝٣"],
[4,600,30,"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ ۝٤"],
[5,600,30,"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ ۝٥"],
[6,600,30,"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ ۝٦"],
[7,600,30,"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ ۝٧"],
[8,600,30,"فَأُمُّهُۥ هَاوِيَةࣱ ۝٨"],
[9,600,30,"وَمَا أَدۡرَىٰكَ مَا هِيَهۡ ۝٩"],
[10,600,30,"نَارٌ حَامِيَةُۢ ۝١٠"]
]}
