{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":56,"name":"الوَاقِعَةِ","t":[
[1,534,27,"إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ ۝١"],
[2,534,27,"لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ ۝٢"],
[3,534,27,"خَافِضَةࣱ رَّافِعَةٌ ۝٣"],
[4,534,27,"إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجࣰّا ۝٤"],
[5,534,27,"وَبُسَّتِ ٱلۡجِبَالُ بَسࣰّا ۝٥"],
[6,534,27,"فَكَانَتۡ هَبَآءࣰ مُّنۢبَثࣰّا ۝٦"],
[7,534,27,"وَكُنتُمُۥ أَزۡوَٰجࣰا ثَلَٰثَةࣰ ۝٧"],
[8,534,27,"فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ۝٨"],
[9,534,27,"مَا أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ۝٩"],
[10,534,27,"وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ ۝١٠"],
[11,534,27,"مَا أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ ۝١١"],
[12,534,27,"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ ۝١٢"],
[13,534,27,"أُوْلَٰٓئِكَ ٱلۡمُقَرَّبُونَ ۝١٣"],
[14,534,27,"فِي جَنَّٰتِ ٱلنَّعِيمِ ۝١٤"],
[15,534,27,"ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِينَ ۝١٥"],
[16,534,27,"وَقَلِيلࣱ مِّنَ ٱلۡأٓخِرِينَ ۝١٦"],
[17,534,27,"عَلَىٰ سُرُرࣲ مَّوۡضُونَةࣲ ۝١٧"],
[18,534,27,"مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ ۝١٨"],
[19,535,27,"يَطُوفُ عَلَيۡهِمُۥ وِلۡدَٰنࣱ مُّخَلَّدُونَ ۝١٩"],
[20,535,27,"بِأَكۡوَابࣲ وَأَبَارِيقَ ۝٢٠"],
[21,535,27,"وَكَأۡسࣲ مِّن مَّعِينࣲ ۝٢١"],
[22,535,27,"لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزَفُونَ ۝٢٢"],
[23,535,27,"وَفَٰكِهَةࣲ مِّمَّا يَتَخَيَّرُونَ ۝٢٣"],
[24,535,27,"وَلَحۡمِ طَيۡرࣲ مِّمَّا يَشۡتَهُونَ ۝٢٤"],
[25,535,27,"وَحُورٌ عِينࣱ كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ ۝٢٥"],
[26,535,27,"جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ ۝٢٦"],
[27,535,27,"لَا يَسۡمَعُونَ فِيهَا لَغۡوࣰا وَلَا تَأۡثِيمًا إِلَّا قِيلࣰا سَلَٰمࣰا سَلَٰمࣰا ۝٢٧"],
[28,535,27,"وَأَصۡحَٰبُ ٱلۡيَمِينِ ۝٢٨"],
[29,535,27,"مَا أَصۡحَٰبُ ٱلۡيَمِينِ ۝٢٩"],
[30,535,27,"فِي سِدۡرࣲ مَّخۡضُودࣲ ۝٣٠"],
[31,535,27,"وَطَلۡحࣲ مَّنضُودࣲ ۝٣١"],
[32,535,27,"وَظِلࣲّ مَّمۡدُودࣲ ۝٣٢"],
[33,535,27,"وَمَآءࣲ مَّسۡكُوبࣲ ۝٣٣"],
[34,535,27,"وَفَٰكِهَةࣲ كَثِيرَةࣲ ۝٣٤"],
[35,535,27,"لَّا مَقۡطُوعَةࣲ وَلَا مَمۡنُوعَةࣲ ۝٣٥"],
[36,535,27,"وَفُرُشࣲ مَّرۡفُوعَةٍ ۝٣٦"],
[37,535,27,"إِنَّا أَنشَأۡنَٰهُنَّ إِنشَآءࣰ ۝٣٧"],
[38,535,27,"فَجَعَلۡنَٰهُنَّ أَبۡكَارًا ۝٣٨"],
[39,535,27,"عُرُبًا أَتۡرَابࣰا ۝٣٩"],
[40,535,27,"لِّأَصۡحَٰبِ ٱلۡيَمِينِ ۝٤٠"],
[41,535,27,"ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِينَ ۝٤١"],
[42,535,27,"وَثُلَّةࣱ مِّنَ ٱلۡأٓخِرِينَ ۝٤٢"],
[43,535,27,"وَأَصۡحَٰبُ ٱلشِّمَالِ ۝٤٣"],
[44,535,27,"مَا أَصۡحَٰبُ ٱلشِّمَالِ ۝٤٤"],
[45,535,27,"فِي سَمُومࣲ وَحَمِيمࣲ وَظِلࣲّ مِّن يَحۡمُومࣲ ۝٤٥"],
[46,535,27,"لَّا بَارِدࣲ وَلَا كَرِيمٍ ۝٤٦"],
[47,535,27,"إِنَّهُمُۥ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ ۝٤٧"],
[48,535,27,"وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ ۝٤٨"],
[49,535,27,"وَكَانُواْ يَقُولُونَ ۝٤٩"],
[50,535,27,"أَىٜذَا مُتۡنَا وَكُنَّا تُرَابࣰا وَعِظَٰمًا أَࢇنَّا لَمَبۡعُوثُونَ ۝٥٠"],
[51,535,27,"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ ۝٥١"],
[52,535,27,"قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ ۝٥٢"],
[53,535,27,"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمࣲ مَّعۡلُومࣲ ۝٥٣"],
[54,536,27,"ثُمَّ إِنَّكُمُۥ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ ۝٥٤"],
[55,536,27,"لَأٓكِلُونَ مِن شَجَرࣲ مِّن زَقُّومࣲ ۝٥٥"],
[56,536,27,"فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ۝٥٦"],
[57,536,27,"فَشَٰرِبُونَ عَلَيۡهِۦ مِنَ ٱلۡحَمِيمِ ۝٥٧"],
[58,536,27,"فَشَٰرِبُونَ شَرۡبَ ٱلۡهِيمِ ۝٥٨"],
[59,536,27,"هَٰذَا نُزُلُهُمُۥ يَوۡمَ ٱلدِّينِ ۝٥٩"],
[60,536,27,"نَحۡنُ خَلَقۡنَٰكُمُۥ فَلَوۡلَا تُصَدِّقُونَ ۝٦٠"],
[61,536,27,"أَفَرَءَيۡتُمُۥ مَا تُمۡنُونَ ۝٦١"],
[62,536,27,"ءَࡶنتُمُۥ تَخۡلُقُونَهُۥ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ ۝٦٢"],
[63,536,27,"نَحۡنُ قَدَرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ۝٦٣"],
[64,536,27,"عَلَىٰ أَن نُّبَدِّلَ أَمۡثَٰلَكُمُۥ وَنُنشِئَكُمُۥ فِي مَا لَا تَعۡلَمُونَ ۝٦٤"],
[65,536,27,"وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشَآءَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَّكَّرُونَ ۝٦٥"],
[66,536,27,"أَفَرَءَيۡتُمُۥ مَا تَحۡرُثُونَ ۝٦٦"],
[67,536,27,"ءَࡶنتُمُۥ تَزۡرَعُونَهُۥ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ ۝٦٧"],
[68,536,27,"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُۥ حُطَٰمࣰا فَظَلۡتُمُۥ تَفَكَّهُونَ ۝٦٨"],
[69,536,27,"إِنَّا لَمُغۡرَمُونَ ۝٦٩"],
[70,536,27,"بَلۡ نَحۡنُ مَحۡرُومُونَ ۝٧٠"],
[71,536,27,"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ ۝٧١"],
[72,536,27,"ءَࡶنتُمُۥ أَنزَلۡتُمُوهُۥ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ ۝٧٢"],
[73,536,27,"لَوۡ نَشَآءُ جَعَلۡنَٰهُۥ أُجَاجࣰا فَلَوۡلَا تَشۡكُرُونَ ۝٧٣"],
[74,536,27,"أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ ۝٧٤"],
[75,536,27,"ءَࡶنتُمُۥ أَنشَأۡتُمُۥ شَجَرَتَهَا أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ ۝٧٥"],
[76,536,27,"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةࣰ وَمَتَٰعࣰا لِّلۡمُقۡوِينَ ۝٧٦"],
[77,536,27,"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ۝٧٧"],
[78,536,27,"۞ فَلَا أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ ۝٧٨"],
[79,536,27,"وَإِنَّهُۥ لَقَسَمࣱ لَّوۡ تَعۡلَمُونَ عَظِيمٌ ۝٧٩"],
[80,537,27,"إِنَّهُۥ لَقُرَانࣱ كَرِيمࣱ ۝٨٠"],
[81,537,27,"فِي كِتَٰبࣲ مَّكۡنُونࣲ ۝٨١"],
[82,537,27,"لَّا يَمَسُّهُۥ إِلَّا ٱلۡمُطَهَّرُونَ ۝٨٢"],
[83,537,27,"تَنزِيلࣱ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ۝٨٣"],
[84,537,27,"أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُمُۥ مُدۡهِنُونَ ۝٨٤"],
[85,537,27,"وَتَجۡعَلُونَ رِزۡقَكُمُۥ أَنَّكُمُۥ تُكَذِّبُونَ ۝٨٥"],
[86,537,27,"فَلَوۡلَا إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ ۝٨٦"],
[87,537,27,"وَأَنتُمُۥ حِينَئِذࣲ تَنظُرُونَ ۝٨٧"],
[88,537,27,"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِۦ مِنكُمُۥ وَلَٰكِن لَّا تُبۡصِرُونَ ۝٨٨"],
[89,537,27,"فَلَوۡلَا إِن كُنتُمُۥ غَيۡرَ مَدِينِينَ ۝٨٩"],
[90,537,27,"تَرۡجِعُونَهَا إِن كُنتُمُۥ صَٰدِقِينَ ۝٩٠"],
[91,537,27,"فَأَمَّا إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ ۝٩١"],
[92,537,27,"فَرَوۡحࣱ وَرَيۡحَانࣱ وَجَنَّتُ نَعِيمࣲ ۝٩٢"],
[93,537,27,"وَأَمَّا إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ۝٩٣"],
[94,537,27,"فَسَلَٰمࣱ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ۝٩٤"],
[95,537,27,"وَأَمَّا إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ ۝٩٥"],
[96,537,27,"فَنُزُلࣱ مِّنۡ حَمِيمࣲ ۝٩٦"],
[97,537,27,"وَتَصۡلِيَةُ جَحِيمٍ ۝٩٧"],
[98,537,27,"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ ۝٩٨"],
[99,537,27,"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ۝٩٩"]
]}
