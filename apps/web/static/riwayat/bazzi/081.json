{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":81,"name":"التَّكۡوِيرِ","t":[
[1,586,30,"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ ۝١"],
[2,586,30,"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ ۝٢"],
[3,586,30,"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ ۝٣"],
[4,586,30,"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ ۝٤"],
[5,586,30,"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ ۝٥"],
[6,586,30,"وَإِذَا ٱلۡبِحَارُ سُجِرَتۡ ۝٦"],
[7,586,30,"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ ۝٧"],
[8,586,30,"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ ۝٨"],
[9,586,30,"بِأَيِّ ذَنۢبࣲ قُتِلَتۡ ۝٩"],
[10,586,30,"وَإِذَا ٱلصُّحُفُ نُشِّرَتۡ ۝١٠"],
[11,586,30,"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ ۝١١"],
[12,586,30,"وَإِذَا ٱلۡجَحِيمُ سُعِرَتۡ ۝١٢"],
[13,586,30,"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ ۝١٣"],
[14,586,30,"عَلِمَتۡ نَفۡسࣱ مَّا أَحۡضَرَتۡ ۝١٤"],
[15,586,30,"فَلَا أُقۡسِمُ بِٱلۡخُنَّسِ ۝١٥"],
[16,586,30,"ٱلۡجَوَارِ ٱلۡكُنَّسِ ۝١٦"],
[17,586,30,"وَٱلَّيۡلِ إِذَا عَسۡعَسَ ۝١٧"],
[18,586,30,"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ ۝١٨"],
[19,586,30,"إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِيمࣲ ۝١٩"],
[20,586,30,"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينࣲ ۝٢٠"],
[21,586,30,"مُّطَاعࣲ ثَمَّ أَمِينࣲ ۝٢١"],
[22,586,30,"وَمَا صَاحِبُكُمُۥ بِمَجۡنُونࣲ ۝٢٢"],
[23,586,30,"وَلَقَدۡ رَءَاهُۥ بِٱلۡأُفُقِ ٱلۡمُبِينِ ۝٢٣"],
[24,586,30,"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضظَنِينࣲ ۝٢٤"],
[25,586,30,"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنࣲ رَّجِيمࣲ ۝٢٥"],
[26,586,30,"فَأَيۡنَ تَذۡهَبُونَ ۝٢٦"],
[27,586,30,"إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَٰلَمِينَ ۝٢٧"],
[28,586,30,"لِمَن شَآءَ مِنكُمُۥ أَن يَسۡتَقِيمَ ۝٢٨"],
[29,586,30,"وَمَا تَشَآءُونَ إِلَّا أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ ۝٢٩"]
]}
