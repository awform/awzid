{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":86,"name":"الطَّارِقِ","t":[
[1,591,30,"وَٱلسَّمَآءِ وَٱلطَّارِقِ ۝١"],
[2,591,30,"وَمَا أَدۡرَىٰكَ مَا ٱلطَّارِقُ ۝٢"],
[3,591,30,"ٱلنَّجۡمُ ٱلثَّاقِبُ ۝٣"],
[4,591,30,"إِن كُلُّ نَفۡسࣲ لَّمَا عَلَيۡهَا حَافِظࣱ ۝٤"],
[5,591,30,"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ ۝٥"],
[6,591,30,"خُلِقَ مِن مَّآءࣲ دَافِقࣲ ۝٦"],
[7,591,30,"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ ۝٧"],
[8,591,30,"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ ۝٨"],
[9,591,30,"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ ۝٩"],
[10,591,30,"فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ ۝١٠"],
[11,591,30,"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ ۝١١"],
[12,591,30,"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ ۝١٢"],
[13,591,30,"إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ ۝١٣"],
[14,591,30,"وَمَا هُوَ بِٱلۡهَزۡلِ ۝١٤"],
[15,591,30,"إِنَّهُمُۥ يَكِيدُونَ كَيۡدࣰا ۝١٥"],
[16,591,30,"وَأَكِيدُ كَيۡدࣰا ۝١٦"],
[17,591,30,"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمُۥ رُوَيۡدَۢا ۝١٧"]
]}
