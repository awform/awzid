{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":109,"name":"الكَافِرُونَ","t":[
[1,603,30,"قُلۡ يَٰأَيُّهَا ٱلۡكَٰفِرُونَ ۝١"],
[2,603,30,"لَا أَعۡبُدُ مَا تَعۡبُدُونَ ۝٢"],
[3,603,30,"وَلَا أَنتُمُۥ عَٰبِدُونَ مَا أَعۡبُدُ ۝٣"],
[4,603,30,"وَلَا أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمُۥ ۝٤"],
[5,603,30,"وَلَا أَنتُمُۥ عَٰبِدُونَ مَا أَعۡبُدُ ۝٥"],
[6,603,30,"لَكُمُۥ دِينُكُمُۥ وَلِي دِينِ ۝٦"]
]}
