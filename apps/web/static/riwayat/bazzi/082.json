{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":82,"name":"الانفِطَارِ","t":[
[1,587,30,"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ ۝١"],
[2,587,30,"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ ۝٢"],
[3,587,30,"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ ۝٣"],
[4,587,30,"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ ۝٤"],
[5,587,30,"عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ ۝٥"],
[6,587,30,"يَٰأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ ۝٦"],
[7,587,30,"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَّلَكَ ۝٧"],
[8,587,30,"فِي أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَكَ ۝٨"],
[9,587,30,"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ ۝٩"],
[10,587,30,"وَإِنَّ عَلَيۡكُمُۥ لَحَٰفِظِينَ ۝١٠"],
[11,587,30,"كِرَامࣰا كَٰتِبِينَ ۝١١"],
[12,587,30,"يَعۡلَمُونَ مَا تَفۡعَلُونَ ۝١٢"],
[13,587,30,"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمࣲ ۝١٣"],
[14,587,30,"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمࣲ ۝١٤"],
[15,587,30,"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ ۝١٥"],
[16,587,30,"وَمَا هُمُۥ عَنۡهَا بِغَآئِبِينَ ۝١٦"],
[17,587,30,"وَمَا أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ۝١٧"],
[18,587,30,"ثُمَّ مَا أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ۝١٨"],
[19,587,30,"يَوۡمُ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَيۡـࣰٔاۖ وَٱلۡأَمۡرُ يَوۡمَئِذࣲ لِّلَّهِ ۝١٩"]
]}
