{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":97,"name":"القَدۡرِ","t":[
[1,598,30,"إِنَّا أَنزَلۡنَٰهُۥ فِي لَيۡلَةِ ٱلۡقَدۡرِ ۝١"],
[2,598,30,"وَمَا أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ ۝٢"],
[3,598,30,"لَيۡلَةُ ٱلۡقَدۡرِ ۝٣"],
[4,598,30,"خَيۡرࣱ مِّنۡ أَلۡفِ شَهۡرࣲ ۝٤"],
[5,598,30,"تَّنَزَّلُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِمُۥ مِن كُلِّ أَمۡرࣲ ۝٥"],
[6,598,30,"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ ۝٦"]
]}
