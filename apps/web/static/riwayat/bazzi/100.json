{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":100,"name":"العَادِيَاتِ","t":[
[1,599,30,"وَٱلۡعَٰدِيَٰتِ ضَبۡحࣰا ۝١"],
[2,599,30,"فَٱلۡمُورِيَٰتِ قَدۡحࣰا ۝٢"],
[3,599,30,"فَٱلۡمُغِيرَٰتِ صُبۡحࣰا ۝٣"],
[4,599,30,"فَأَثَرۡنَ بِهِۦ نَقۡعࣰا ۝٤"],
[5,599,30,"فَوَسَطۡنَ بِهِۦ جَمۡعًا ۝٥"],
[6,600,30,"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودࣱ ۝٦"],
[7,600,30,"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدࣱ ۝٧"],
[8,600,30,"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ ۝٨"],
[9,600,30,"۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ ۝٩"],
[10,600,30,"وَحُصِّلَ مَا فِي ٱلصُّدُورِ ۝١٠"],
[11,600,30,"إِنَّ رَبَّهُمُۥ بِهِمُۥ يَوۡمَئِذࣲ لَّخَبِيرُۢ ۝١١"]
]}
