{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":107,"name":"المَاعُونِ","t":[
[1,602,30,"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ ۝١"],
[2,602,30,"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ ۝٢"],
[3,602,30,"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ۝٣"],
[4,602,30,"فَوَيۡلࣱ لِّلۡمُصَلِّينَ ۝٤"],
[5,602,30,"ٱلَّذِينَ هُمُۥ عَن صَلَاتِهِمُۥ سَاهُونَ ۝٥"],
[6,602,30,"ٱلَّذِينَ هُمُۥ يُرَآءُونَ وَيَمۡنَعُونَ ٱلۡمَاعُونَ ۝٦"]
]}
