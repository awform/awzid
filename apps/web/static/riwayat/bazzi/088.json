{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":88,"name":"الغَاشِيَةِ","t":[
[1,592,30,"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ ۝١"],
[2,592,30,"وُجُوهࣱ يَوۡمَئِذٍ خَٰشِعَةٌ ۝٢"],
[3,592,30,"عَامِلَةࣱ نَّاصِبَةࣱ ۝٣"],
[4,592,30,"تَصۡلَىٰ نَارًا حَامِيَةࣰ ۝٤"],
[5,592,30,"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةࣲ ۝٥"],
[6,592,30,"لَّيۡسَ لَهُمُۥ طَعَامٌ إِلَّا مِن ضَرِيعࣲ ۝٦"],
[7,592,30,"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعࣲ ۝٧"],
[8,592,30,"وُجُوهࣱ يَوۡمَئِذࣲ نَّاعِمَةࣱ ۝٨"],
[9,592,30,"لِّسَعۡيِهَا رَاضِيَةࣱ ۝٩"],
[10,592,30,"فِي جَنَّةٍ عَالِيَةࣲ ۝١٠"],
[11,592,30,"لَّا يُسۡمَعُ فِيهَا لَٰغِيَةࣱ ۝١١"],
[12,592,30,"فِيهَا عَيۡنࣱ جَارِيَةࣱ ۝١٢"],
[13,592,30,"فِيهَا سُرُرࣱ مَّرۡفُوعَةࣱ ۝١٣"],
[14,592,30,"وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ ۝١٤"],
[15,592,30,"وَنَمَارِقُ مَصۡفُوفَةࣱ ۝١٥"],
[16,592,30,"وَزَرَابِيُّ مَبۡثُوثَةٌ ۝١٦"],
[17,592,30,"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ ۝١٧"],
[18,592,30,"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ ۝١٨"],
[19,592,30,"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ ۝١٩"],
[20,592,30,"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ ۝٢٠"],
[21,592,30,"فَذَكِّرۡ إِنَّمَا أَنتَ مُذَكِّرࣱ ۝٢١"],
[22,592,30,"لَّسۡتَ عَلَيۡهِمُۥ بِمُصَيۡطِرٍ ۝٢٢"],
[23,593,30,"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ۝٢٣"],
[24,593,30,"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ ۝٢٤"],
[25,593,30,"إِنَّ إِلَيۡنَا إِيَابَهُمُۥ ۝٢٥"],
[26,593,30,"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُمُۥ ۝٢٦"]
]}
