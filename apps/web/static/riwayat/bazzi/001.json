{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":1,"name":"الفَاتِحَةِ","t":[
[1,1,1,"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ ۝١"],
[2,1,1,"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ ۝٢"],
[3,1,1,"ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ ۝٣"],
[4,1,1,"مَلِكِ يَوۡمِ ٱلدِّينِ ۝٤"],
[5,1,1,"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ ۝٥"],
