{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":77,"name":"المُرۡسَلَاتِ","t":[
[1,580,29,"وَٱلۡمُرۡسَلَٰتِ عُرۡفࣰا ۝١"],
[2,580,29,"فَٱلۡعَٰصِفَٰتِ عَصۡفࣰا ۝٢"],
[3,580,29,"وَٱلنَّٰشِرَٰتِ نَشۡرࣰا ۝٣"],
[4,580,29,"فَٱلۡفَٰرِقَٰتِ فَرۡقࣰا ۝٤"],
[5,580,29,"فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا ۝٥"],
[6,580,29,"عُذۡرًا أَوۡ نُذُرًا ۝٦"],
[7,580,29,"إِنَّمَا تُوعَدُونَ لَوَٰقِعࣱ ۝٧"],
[8,580,29,"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ ۝٨"],
[9,580,29,"وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ ۝٩"],
[10,580,29,"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ ۝١٠"],
[11,580,29,"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ ۝١١"],
[12,580,29,"لِأَيِّ يَوۡمٍ أُجِّلَتۡ ۝١٢"],
[13,580,29,"لِيَوۡمِ ٱلۡفَصۡلِ ۝١٣"],
[14,580,29,"وَمَا أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ ۝١٤"],
[15,580,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝١٥"],
[16,580,29,"أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ ۝١٦"],
[17,580,29,"ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ ۝١٧"],
[18,580,29,"كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ ۝١٨"],
[19,580,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝١٩"],
[20,581,29,"أَلَمۡ نَخۡلُقكُّمُۥ مِن مَّآءࣲ مَّهِينࣲ ۝٢٠"],
[21,581,29,"فَجَعَلۡنَٰهُۥ فِي قَرَارࣲ مَّكِينٍ ۝٢١"],
[22,581,29,"إِلَىٰ قَدَرࣲ مَّعۡلُومࣲ ۝٢٢"],
[23,581,29,"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ ۝٢٣"],
[24,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٢٤"],
[25,581,29,"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا ۝٢٥"],
[26,581,29,"أَحۡيَآءࣰ وَأَمۡوَٰتࣰا ۝٢٦"],
[27,581,29,"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتࣲ وَأَسۡقَيۡنَٰكُمُۥ مَآءࣰ فُرَاتࣰا ۝٢٧"],
[28,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٢٨"],
[29,581,29,"ٱنطَلِقُواْ إِلَىٰ مَا كُنتُمُۥ بِهِۦ تُكَذِّبُونَ ۝٢٩"],
[30,581,29,"ٱنطَلِقُواْ إِلَىٰ ظِلࣲّ ذِي ثَلَٰثِ شُعَبࣲ ۝٣٠"],
[31,581,29,"لَّا ظَلِيلࣲ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ ۝٣١"],
[32,581,29,"إِنَّهَا تَرۡمِي بِشَرَرࣲ كَٱلۡقَصۡرِ ۝٣٢"],
[33,581,29,"كَأَنَّهُۥ جِمَٰلَٰتࣱ صُفۡرࣱ ۝٣٣"],
[34,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٣٤"],
[35,581,29,"هَٰذَا يَوۡمُ لَا يَنطِقُونَ ۝٣٥"],
[36,581,29,"وَلَا يُؤۡذَنُ لَهُمُۥ فَيَعۡتَذِرُونَ ۝٣٦"],
[37,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٣٧"],
[38,581,29,"هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمُۥ وَٱلۡأَوَّلِينَ ۝٣٨"],
[39,581,29,"فَإِن كَانَ لَكُمُۥ كَيۡدࣱ فَكِيدُونِ ۝٣٩"],
[40,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٤٠"],
[41,581,29,"إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلࣲ وَعِيُونࣲ ۝٤١"],
[42,581,29,"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ ۝٤٢"],
[43,581,29,"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمُۥ تَعۡمَلُونَ ۝٤٣"],
[44,581,29,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ۝٤٤"],
[45,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٤٥"],
[46,581,29,"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُمُۥ مُجۡرِمُونَ ۝٤٦"],
[47,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٤٧"],
[48,581,29,"وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ ۝٤٨"],
[49,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٤٩"],
[50,581,29,"فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ ۝٥٠"]
]}
