{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":89,"name":"الفَجۡرِ","t":[
[1,593,30,"وَٱلۡفَجۡرِ ۝١"],
[2,593,30,"وَلَيَالٍ عَشۡرࣲ ۝٢"],
[3,593,30,"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ ۝٣"],
[4,593,30,"وَٱلَّيۡلِ إِذَا يَسۡرِۦ ۝٤"],
[5,593,30,"هَلۡ فِي ذَٰلِكَ قَسَمࣱ لِّذِي حِجۡرٍ ۝٥"],
[6,593,30,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ ۝٦"],
[7,593,30,"إِرَمَ ذَاتِ ٱلۡعِمَادِ ۝٧"],
[8,593,30,"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ ۝٨"],
[9,593,30,"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِۦ ۝٩"],
[10,593,30,"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ ۝١٠"],
[11,593,30,"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ ۝١١"],
[12,593,30,"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ ۝١٢"],
[13,593,30,"فَصَبَّ عَلَيۡهِمُۥ رَبُّكَ سَوۡطَ عَذَابٍ ۝١٣"],
[14,593,30,"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ ۝١٤"],
[15,593,30,"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُۥ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ ۝١٥"],
[16,593,30,"فَيَقُولُ رَبِّيَ أَكۡرَمَنِۦ ۝١٦"],
[17,593,30,"وَأَمَّا إِذَا مَا ٱبۡتَلَىٰهُۥ فَقَدَرَ عَلَيۡهِۦ رِزۡقَهُۥ ۝١٧"],
[18,593,30,"فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ ۝١٨"],
[19,593,30,"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ ۝١٩"],
[20,593,30,"وَلَا تَحُضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ۝٢٠"],
[21,593,30,"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلࣰا لَّمࣰّا ۝٢١"],
[22,593,30,"وَتُحِبُّونَ ٱلۡمَالَ حُبࣰّا جَمࣰّا ۝٢٢"],
[23,593,30,"كَلَّاۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكࣰّا دَكࣰّا ۝٢٣"],
[24,593,30,"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفࣰّا صَفࣰّا ۝٢٤"],
[25,594,30,"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَ ۝٢٥"],
[26,594,30,"يَوۡمَئِذࣲ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ ۝٢٦"],
[27,594,30,"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي ۝٢٧"],
[28,594,30,"فَيَوۡمَئِذࣲ لَّا يُعَذِّبُ عَذَابَهُۥ أَحَدࣱ ۝٢٨"],
[29,594,30,"وَلَا يُوثِقُ وَثَاقَهُۥ أَحَدࣱ ۝٢٩"],
[30,594,30,"يَٰأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ ۝٣٠"],
[31,594,30,"ٱرۡجِعِي إِلَىٰ رَبِّكِ رَاضِيَةࣰ مَّرۡضِيَّةࣰ ۝٣١"],
[32,594,30,"فَٱدۡخُلِي فِي عِبَٰدِي وَٱدۡخُلِي جَنَّتِي ۝٣٢"]
]}
