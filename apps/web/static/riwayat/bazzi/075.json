{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":75,"name":"القِيَامَةِ","t":[
[1,577,29,"لَأُاْقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ ۝١"],
[2,577,29,"وَلَا أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ ۝٢"],
[3,577,29,"أَيَحۡسِبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ ۝٣"],
[4,577,29,"بَلَىٰ قَٰدِرِينَ عَلَىٰ أَن نُّسَوِّيَ بَنَانَهُۥ ۝٤"],
[5,577,29,"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ ۝٥"],
[6,577,29,"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ ۝٦"],
[7,577,29,"فَإِذَا بَرِقَ ٱلۡبَصَرُ ۝٧"],
[8,577,29,"وَخَسَفَ ٱلۡقَمَرُ ۝٨"],
[9,577,29,"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ ۝٩"],
[10,577,29,"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ ۝١٠"],
[11,577,29,"كَلَّا لَا وَزَرَ ۝١١"],
[12,577,29,"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ ۝١٢"],
[13,577,29,"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ ۝١٣"],
[14,577,29,"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةࣱ ۝١٤"],
[15,577,29,"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ ۝١٥"],
[16,577,29,"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦ إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرَانَهُۥ ۝١٦"],
[17,577,29,"فَإِذَا قَرَأۡنَٰهُۥ فَٱتَّبِعۡ قُرَانَهُۥ ۝١٧"],
[18,577,29,"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ ۝١٨"],
[19,578,29,"كَلَّا بَلۡ يُحِبُّونَ ٱلۡعَاجِلَةَ ۝١٩"],
[20,578,29,"وَيَذَرُونَ ٱلۡأٓخِرَةَ ۝٢٠"],
[21,578,29,"وُجُوهࣱ يَوۡمَئِذࣲ نَّاضِرَةٌ ۝٢١"],
[22,578,29,"إِلَىٰ رَبِّهَا نَاظِرَةࣱ ۝٢٢"],
[23,578,29,"وَوُجُوهࣱ يَوۡمَئِذِۭ بَاسِرَةࣱ ۝٢٣"],
[24,578,29,"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةࣱ ۝٢٤"],
[25,578,29,"كَلَّا إِذَا بَلَغَتِ ٱلتَّرَاقِيَ ۝٢٥"],
[26,578,29,"وَقِيلَ مَن رَّاقࣲ ۝٢٦"],
[27,578,29,"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ ۝٢٧"],
[28,578,29,"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ ۝٢٨"],
[29,578,29,"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ ۝٢٩"],
[30,578,29,"فَلَا صَدَّقَ وَلَا صَلَّىٰ ۝٣٠"],
[31,578,29,"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ ۝٣١"],
[32,578,29,"ثُمَّ ذَهَبَ إِلَىٰ أَهۡلِهِۦ يَتَمَطَّىٰ ۝٣٢"],
[33,578,29,"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ ۝٣٣"],
[34,578,29,"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰ ۝٣٤"],
[35,578,29,"أَيَحۡسِبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى ۝٣٥"],
[36,578,29,"أَلَمۡ يَكُ نُطۡفَةࣰ مِّن مَّنِيࣲّ تُمۡنَىٰ ۝٣٦"],
[37,578,29,"ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوَّىٰ ۝٣٧"],
[38,578,29,"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰ ۝٣٨"],
[39,578,29,"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ ۝٣٩"]
]}
