{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":96,"name":"العَلَقِ","t":[
[1,597,30,"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ ۝١"],
[2,597,30,"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ ۝٢"],
[3,597,30,"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ ۝٣"],
[4,597,30,"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ ۝٤"],
[5,597,30,"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ ۝٥"],
[6,597,30,"كَلَّا إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰ ۝٦"],
[7,597,30,"أَن رَّءَاهُ ٱسۡتَغۡنَىٰ ۝٧"],
[8,597,30,"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰ ۝٨"],
[9,597,30,"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ ۝٩"],
[10,597,30,"عَبۡدًا إِذَا صَلَّىٰ ۝١٠"],
[11,597,30,"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰ ۝١١"],
[12,597,30,"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰ ۝١٢"],
[13,598,30,"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰ ۝١٣"],
[14,598,30,"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ ۝١٤"],
[15,598,30,"كَلَّا لَئِن لَّمۡ يَنتَهِ ۝١٥"],
[16,598,30,"لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ ۝١٦"],
[17,598,30,"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ ۝١٧"],
[18,598,30,"فَلۡيَدۡعُ نَادِيَهُۥ ۝١٨"],
[19,598,30,"سَنَدۡعُ ٱلزَّبَانِيَةَ ۝١٩"],
[20,598,30,"كَلَّا لَا تُطِعۡهُۥ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩ ۝٢٠"]
]}
