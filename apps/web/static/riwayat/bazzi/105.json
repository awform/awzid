{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":105,"name":"الفِيلِ","t":[
[1,601,30,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ ۝١"],
[2,601,30,"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمُۥ فِي تَضۡلِيلࣲ ۝٢"],
[3,601,30,"وَأَرۡسَلَ عَلَيۡهِمُۥ طَيۡرًا أَبَابِيلَ ۝٣"],
[4,601,30,"تَرۡمِيهِمُۥ بِحِجَارَةࣲ مِّن سِجِّيلࣲ ۝٤"],
[5,601,30,"فَجَعَلَهُمُۥ كَعَصۡفࣲ مَّأۡكُولِۭ ۝٥"]
]}
