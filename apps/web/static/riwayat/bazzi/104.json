{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":104,"name":"الهُمَزَةِ","t":[
[1,601,30,"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ ۝١"],
[2,601,30,"ٱلَّذِي جَمَعَ مَالࣰا وَعَدَّدَهُۥ ۝٢"],
[3,601,30,"يَحۡسِبُ أَنَّ مَالَهُۥ أَخۡلَدَهُۥ ۝٣"],
[4,601,30,"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ ۝٤"],
[5,601,30,"وَمَا أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ ۝٥"],
[6,601,30,"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ ۝٦"],
[7,601,30,"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ ۝٧"],
[8,601,30,"إِنَّهَا عَلَيۡهِمُۥ مُوصَدَةࣱ ۝٨"],
[9,601,30,"فِي عَمَدࣲ مُّمَدَّدَةِۭ ۝٩"]
]}
