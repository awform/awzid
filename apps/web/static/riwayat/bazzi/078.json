{"v":1,"key":"bazzi","version":"kfgqpc_bazzi_v30","source":"KFGQPC","s":78,"name":"النَّبَإِ","t":[
[1,582,30,"عَمَّ يَتَسَآءَلُونَ ۝١"],
[2,582,30,"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ ۝٢"],
[3,582,30,"ٱلَّذِي هُمُۥ فِيهِۦ مُخۡتَلِفُونَ ۝٣"],
[4,582,30,"كَلَّا سَيَعۡلَمُونَ ۝٤"],
[5,582,30,"ثُمَّ كَلَّا سَيَعۡلَمُونَ ۝٥"],
[6,582,30,"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدࣰا ۝٦"],
[7,582,30,"وَٱلۡجِبَالَ أَوۡتَادࣰا ۝٧"],
[8,582,30,"وَخَلَقۡنَٰكُمُۥ أَزۡوَٰجࣰا ۝٨"],
[9,582,30,"وَجَعَلۡنَا نَوۡمَكُمُۥ سُبَاتࣰا ۝٩"],
[10,582,30,"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسࣰا ۝١٠"],
[11,582,30,"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشࣰا ۝١١"],
[12,582,30,"وَبَنَيۡنَا فَوۡقَكُمُۥ سَبۡعࣰا شِدَادࣰا ۝١٢"],
[13,582,30,"وَجَعَلۡنَا سِرَاجࣰا وَهَّاجࣰا ۝١٣"],
[14,582,30,"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءࣰ ثَجَّاجࣰا ۝١٤"],
[15,582,30,"لِّنُخۡرِجَ بِهِۦ حَبࣰّا وَنَبَاتࣰا ۝١٥"],
[16,582,30,"وَجَنَّٰتٍ أَلۡفَافًا ۝١٦"],
[17,582,30,"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتࣰا ۝١٧"],
[18,582,30,"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجࣰا ۝١٨"],
[19,582,30,"وَفُتِّحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبࣰا ۝١٩"],
[20,582,30,"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا ۝٢٠"],
[21,582,30,"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادࣰا ۝٢١"],
[22,582,30,"لِّلطَّٰغِينَ مَـَٔابࣰا ۝٢٢"],
[23,582,30,"لَّٰبِثِينَ فِيهَا أَحۡقَابࣰا ۝٢٣"],
[24,582,30,"لَّا يَذُوقُونَ فِيهَا بَرۡدࣰا وَلَا شَرَابًا ۝٢٤"],
[25,582,30,"إِلَّا حَمِيمࣰا وَغَسَاقࣰا ۝٢٥"],
[26,582,30,"جَزَآءࣰ وِفَاقًا ۝٢٦"],
[27,582,30,"إِنَّهُمُۥ كَانُواْ لَا يَرۡجُونَ حِسَابࣰا ۝٢٧"],
[28,582,30,"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابࣰا ۝٢٨"],
[29,582,30,"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُۥ كِتَٰبࣰا ۝٢٩"],
[30,582,30,"فَذُوقُواْ فَلَن نَّزِيدَكُمُۥ إِلَّا عَذَابًا ۝٣٠"],
[31,583,30,"إِنَّ لِلۡمُتَّقِينَ مَفَازًا ۝٣١"],
[32,583,30,"حَدَآئِقَ وَأَعۡنَٰبࣰا ۝٣٢"],
[33,583,30,"وَكَوَاعِبَ أَتۡرَابࣰا ۝٣٣"],
[34,583,30,"وَكَأۡسࣰا دِهَاقࣰا ۝٣٤"],
[35,583,30,"لَّا يَسۡمَعُونَ فِيهَا لَغۡوࣰا وَلَا كِذَّٰبࣰا ۝٣٥"],
[36,583,30,"جَزَآءࣰ مِّن رَّبِّكَ عَطَآءً حِسَابࣰا ۝٣٦"],
[37,583,30,"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنُۖ لَا يَمۡلِكُونَ مِنۡهُۥ خِطَابࣰا ۝٣٧"],
[38,583,30,"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفࣰّاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابࣰا ۝٣٨"],
[39,583,30,"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا ۝٣٩"],
[40,583,30,"إِنَّا أَنذَرۡنَٰكُمُۥ عَذَابࣰا قَرِيبࣰا ۝٤٠"],
[41,583,30,"يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُۥ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا ۝٤١"]
]}
