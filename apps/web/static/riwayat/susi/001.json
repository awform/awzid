{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":1,"name":"الفَاتِحَةِ","t":[
[1,1,1,"ࡵ۬لۡحَمۡدُ لِلَّهِ رَبِّ ࡵ۬لۡعَٰلَمِينَ ۝١"],
[2,1,1,"ࡱ۬لرَّحۡمَٰنِ ࡵ۬لرَّحِيم ۝٢"],
[3,1,1,"مَّلِكِ يَوۡمِ ࡵ۬لدِّينِ ۝٣"],
[4,1,1,"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ ۝٤"],
[5,1,1,"ࡲٜهۡدِنَا ࡱ۬لصِّرَٰطَ ࡱ۬لۡمُسۡتَقِيمَ ۝٥"],
[6,1,1,"صِرَٰطَ ࡱ۬لَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ ۝٦"],
[7,1,1,"غَيۡرِ ࡵ۬لۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ࡱ۬لضَّآلِّينَ ۝٧"]
