{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":109,"name":"الكَافِرُونَ","t":[
[1,603,30,"قُلۡ يَٰأَيُّهَا ࡱ۬لۡكَٰفِرُونَ ۝١"],
[2,603,30,"لَا أَعۡبُدُ مَا تَعۡبُدُونَ ۝٢"],
[3,603,30,"وَلَا أَنتُمۡ عَٰبِدُونَ مَا أَعۡبُدُ ۝٣"],
[4,603,30,"وَلَا أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمۡ ۝٤"],
[5,603,30,"وَلَا أَنتُمۡ عَٰبِدُونَ مَا أَعۡبُدُ ۝٥"],
[6,603,30,"لَكُمۡ دِينُكُمۡ وَلِي دِينِ ۝٦"]
]}
