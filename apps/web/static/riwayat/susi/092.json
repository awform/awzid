{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":92,"name":"اللَّيۡلِ","t":[
[1,595,30,"وَࡱلَّيۡلِ إِذَا يَغۡش۪ىٰ ۝١"],
[2,595,30,"وَࡱلنَّهٜارِ إِذَا تَجَلّ۪ىٰ ۝٢"],
[3,595,30,"وَمَا خَلَقَ ࡱ۬لذَّكَرَ وَࡱلۡأُنث۪ىٰ ۝٣"],
[4,595,30,"إِنَّ سَعۡيَكُمۡ لَشَتّ۪ىٰ ۝٤"],
[5,595,30,"فَأَمَّا مَنۡ أَعۡطَىٰ وَࡱتَّق۪ىٰ ۝٥"],
[6,595,30,"وَصَدَّقَ بِالۡحُسۡن۪ىٰ ۝٦"],
[7,595,30,"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرٜىٰ ۝٧"],
[8,595,30,"وَأَمَّا مَنۢ بَخِلَ وَࡱسۡتَغۡن۪ىٰ ۝٨"],
[9,595,30,"وَكَذَّب بِّالۡحُسۡن۪ىٰ ۝٩"],
[10,596,30,"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرٜىٰ ۝١٠"],
[11,596,30,"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥ إِذَا تَرَدّ۪ىٰ ۝١١"],
[12,596,30,"إِنَّ عَلَيۡنَا لَلۡهُد۪ىٰ ۝١٢"],
[13,596,30,"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَࡱلۡأُول۪ىٰ ۝١٣"],
[14,596,30,"فَأَنذَرۡتُكُمۡ نَارࣰا تَلَظّ۪ىٰ ۝١٤"],
[15,596,30,"لَا يَصۡلَىٰهَا إِلَّا ࡱ۬لۡأَشۡقَى ۝١٥"],
[16,596,30,"ࡱ۬لَّذِي كَذَّبَ وَتَوَلّ۪ىٰ ۝١٦"],
[17,596,30,"وَسَيُجَنَّبُهَا ࡱ۬لۡأَتۡقَى ۝١٧"],
[18,596,30,"ࡱ۬لَّذِي يُوتِي مَالَهُۥ يَتَزَكّ۪ىٰ ۝١٨"],
[19,596,30,"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡز۪ىٰ ۝١٩"],
[20,596,30,"إِلَّا ࡱٜبۡتِغَآءَ وَجۡهِ رَبِّهِ ࡵ۬لۡأَعۡل۪ىٰ ۝٢٠"],
[21,596,30,"وَلَسَوۡفَ يَرۡض۪ىٰ ۝٢١"]
]}
