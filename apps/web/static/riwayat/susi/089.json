{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":89,"name":"الفَجۡرِ","t":[
[1,593,30,"وَࡱلۡفَجۡرِ ۝١"],
[2,593,30,"وَلَيَالٍ عَشۡرࣲ ۝٢"],
[3,593,30,"وَࡱلشَّفۡعِ وَࡱلۡوَتۡرِ ۝٣"],
[4,593,30,"وَࡱلَّيۡلِ إِذَا يَسۡرِۦ ۝٤"],
[5,593,30,"هَلۡ فِي ذَٰلِك قَّسَمࣱ لِّذِي حِجۡرٍ ۝٥"],
[6,593,30,"أَلَمۡ تَرَ كَيۡف فَّعَل رَّبُّكَ بِعَادٍ ۝٦"],
[7,593,30,"إِرَمَ ذَاتِ ࡵ۬لۡعِمَادِ ۝٧"],
[8,593,30,"ࡵ۬لَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ࡵ۬لۡبِلَٰدِ ۝٨"],
[9,593,30,"وَثَمُودَ ࡱ۬لَّذِينَ جَابُواْ ࡲ۬لصَّخۡرَ بِالۡوَادِ ۝٩"],
[10,593,30,"وَفِرۡعَوۡنَ ذِي ࡵ۬لۡأَوۡتَادِ ۝١٠"],
[11,593,30,"ࡵ۬لَّذِينَ طَغَوۡاْ فِي ࡵ۬لۡبِلَٰدِ ۝١١"],
[12,593,30,"فَأَكۡثَرُواْ فِيهَا ࡱ۬لۡفَسَادَ ۝١٢"],
[13,593,30,"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ ۝١٣"],
[14,593,30,"إِنَّ رَبَّكَ لَبِالۡمِرۡصَادِ ۝١٤"],
[15,593,30,"فَأَمَّا ࡱ۬لۡإِنسَٰنُ إِذَا مَا ࡱٜبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ ۝١٥"],
[16,593,30,"فَيَقُول رَّبِّيَ أَكۡرَمَنِۦ ۝١٦"],
[17,593,30,"وَأَمَّا إِذَا مَا ࡱٜبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ ۝١٧"],
[18,593,30,"فَيَقُول رَّبِّيَ أَهَٰنَنِۦ ۝١٨"],
[19,593,30,"كَلَّاۖ بَل لَّا يُكۡرِمُونَ ࡱ۬لۡيَتِيمَ ۝١٩"],
[20,593,30,"وَلَا يَحُضُّونَ عَلَىٰ طَعَامِ ࡵ۬لۡمِسۡكِينِ ۝٢٠"],
[21,593,30,"وَيَاكُلُونَ ࡱ۬لتُّرَاثَ أَكۡلࣰا لَّمࣰّا ۝٢١"],
[22,593,30,"وَيُحِبُّونَ ࡱ۬لۡمَالَ حُبࣰّا جَمࣰّا ۝٢٢"],
[23,593,30,"كَلَّاۖ إِذَا دُكَّتِ ࡵ۬لۡأَرۡضُ دَكࣰّا دَكࣰّا ۝٢٣"],
[24,593,30,"وَجَآءَ رَبُّكَ وَࡱلۡمَلَكُ صَفࣰّا صَفࣰّا ۝٢٤"],
[25,594,30,"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَ ۝٢٥"],
[26,594,30,"يَوۡمَئِذࣲ يَتَذَكَّرُ ࡲ۬لۡإِنسَٰنُ وَأَنَّىٰ لَهُ ࡲ۬لذِّكۡرٜىٰ ۝٢٦"],
[27,594,30,"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي ۝٢٧"],
[28,594,30,"فَيَوۡمَئِذࣲ لَّا يُعَذِّبُ عَذَابَهُۥ أَحَدࣱ ۝٢٨"],
[29,594,30,"وَلَا يُوثِقُ وَثَاقَهُۥ أَحَدࣱ ۝٢٩"],
[30,594,30,"يَٰأَيَّتُهَا ࡱ۬لنَّفۡسُ ࡲ۬لۡمُطۡمَئِنَّةُ ۝٣٠"],
[31,594,30,"ࡲٜرۡجِعِي إِلَىٰ رَبِّكِ رَاضِيَةࣰ مَّرۡضِيَّةࣰ ۝٣١"],
[32,594,30,"فَاَدۡخُلِي فِي عِبَٰدِي وَࡱدۡخُلِي جَنَّتِي ۝٣٢"]
]}
