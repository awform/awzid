{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":77,"name":"المُرۡسَلَاتِ","t":[
[1,580,29,"وَࡱلۡمُرۡسَلَٰتِ عُرۡفࣰا ۝١"],
[2,580,29,"فَاَلۡعَٰصِفَٰتِ عَصۡفࣰا ۝٢"],
[3,580,29,"وَࡱلنَّٰشِرَٰتِ نَشۡرࣰا ۝٣"],
[4,580,29,"فَاَلۡفَٰرِقَٰتِ فَرۡقࣰا ۝٤"],
[5,580,29,"فَاَلۡمُلۡقِيَٰت ذِّكۡرًا ۝٥"],
[6,580,29,"عُذۡرًا أَوۡ نُذۡرًا ۝٦"],
[7,580,29,"إِنَّمَا تُوعَدُونَ لَوَٰقِعࣱ ۝٧"],
[8,580,29,"فَإِذَا ࡱ۬لنُّجُومُ طُمِسَتۡ ۝٨"],
[9,580,29,"وَإِذَا ࡱ۬لسَّمَآءُ فُرِجَتۡ ۝٩"],
[10,580,29,"وَإِذَا ࡱ۬لۡجِبَالُ نُسِفَتۡ ۝١٠"],
[11,580,29,"وَإِذَا ࡱ۬لرُّسُلُ اۥُقِّتَتۡ ۝١١"],
[12,580,29,"لِأَيِّ يَوۡمٍ أُجِّلَتۡ ۝١٢"],
[13,580,29,"لِيَوۡمِ ࡵ۬لۡفَصۡلِ ۝١٣"],
[14,580,29,"وَمَا أَدۡرٜىٰكَ مَا يَوۡمُ ࡲ۬لۡفَصۡلِ ۝١٤"],
[15,580,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝١٥"],
[16,580,29,"۞ أَلَمۡ نُهۡلِكِ ࡵ۬لۡأَوَّلِينَ ۝١٦"],
[17,580,29,"ثُمَّ نُتۡبِعُهُمُ ࡲ۬لۡأٓخِرِينَ ۝١٧"],
[18,580,29,"كَذَٰلِكَ نَفۡعَلُ بِالۡمُجۡرِمِينَ ۝١٨"],
[19,580,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝١٩"],
[20,581,29,"أَلَمۡ نَخۡلُقكُّم مِّن مَّآءࣲ مَّهِينࣲ ۝٢٠"],
[21,581,29,"فَجَعَلۡنَٰهُ فِي قَرٜارࣲ مَّكِينٍ ۝٢١"],
[22,581,29,"إِلَىٰ قَدَرࣲ مَّعۡلُومࣲ ۝٢٢"],
[23,581,29,"فَقَدَرۡنَا فَنِعۡمَ ࡱ۬لۡقَٰدِرُونَ ۝٢٣"],
[24,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٢٤"],
[25,581,29,"أَلَمۡ نَجۡعَلِ ࡵ۬لۡأَرۡضَ كِفَاتًا ۝٢٥"],
[26,581,29,"أَحۡيَآءࣰ وَأَمۡوَٰتࣰا ۝٢٦"],
[27,581,29,"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتࣲ وَأَسۡقَيۡنَٰكُم مَّآءࣰ فُرَاتࣰا ۝٢٧"],
[28,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٢٨"],
[29,581,29,"ࡱٜنطَلِقُواْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ ۝٢٩"],
[30,581,29,"ࡱٜنطَلِقُواْ إِلَىٰ ظِلࣲّ ذِي ثَلَٰث شُّعَبࣲ ۝٣٠"],
[31,581,29,"لَّا ظَلِيلࣲ وَلَا يُغۡنِي مِنَ ࡱ۬للَّهَبِ ۝٣١"],
[32,581,29,"إِنَّهَا تَرۡمِي بِشَرَرࣲ كَاَلۡقَصۡرِ ۝٣٢"],
[33,581,29,"كَأَنَّهُۥ جِمَٰلَٰتࣱ صُفۡرࣱ ۝٣٣"],
[34,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٣٤"],
[35,581,29,"هَٰذَا يَوۡمُ لَا يَنطِقُونَ ۝٣٥"],
[36,581,29,"وَلَا يُوذَن لَّهُمۡ فَيَعۡتَذِرُونَ ۝٣٦"],
[37,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٣٧"],
[38,581,29,"هَٰذَا يَوۡمُ ࡲ۬لۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَࡱلۡأَوَّلِينَ ۝٣٨"],
[39,581,29,"فَإِن كَانَ لَكُمۡ كَيۡدࣱ فَكِيدُونِ ۝٣٩"],
[40,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٤٠"],
[41,581,29,"إِنَّ ࡱ۬لۡمُتَّقِينَ فِي ظِلَٰلࣲ وَعُيُونࣲ ۝٤١"],
[42,581,29,"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ ۝٤٢"],
[43,581,29,"كُلُواْ وَࡱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ ۝٤٣"],
[44,581,29,"إِنَّا كَذَٰلِكَ نَجۡزِي ࡵ۬لۡمُحۡسِنِينَ ۝٤٤"],
[45,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٤٥"],
[46,581,29,"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ ۝٤٦"],
[47,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٤٧"],
[48,581,29,"وَإِذَا قِيل لَّهُمُ ࡲٜرۡكَعُواْ لَا يَرۡكَعُونَ ۝٤٨"],
[49,581,29,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ ۝٤٩"],
[50,581,29,"فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُومِنُونَ ۝٥٠"]
]}
