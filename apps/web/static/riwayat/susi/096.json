{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":96,"name":"العَلَقِ","t":[
[1,597,30,"ࡵٜقۡرَأۡ بِاسۡمِ رَبِّكَ ࡱ۬لَّذِي خَلَقَ ۝١"],
[2,597,30,"خَلَقَ ࡱ۬لۡإِنسَٰنَ مِنۡ عَلَقٍ ۝٢"],
[3,597,30,"ࡵٜقۡرَأۡ وَرَبُّكَ ࡱ۬لۡأَكۡرَمُ ۝٣"],
[4,597,30,"ࡲ۬لَّذِي عَلَّم بِالۡقَلَمِ ۝٤"],
[5,597,30,"عَلَّمَ ࡱ۬لۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ ۝٥"],
[6,597,30,"كَلَّا إِنَّ ࡱ۬لۡإِنسَٰنَ لَيَطۡغ۪ىٰ ۝٦"],
[7,597,30,"أَن رَّءٜاهُ ࡲٜسۡتَغۡن۪ىٰ ۝٧"],
[8,597,30,"إِنَّ إِلَىٰ رَبِّكَ ࡱ۬لرُّجۡع۪ىٰ ۝٨"],
[9,597,30,"أَرَءَيۡتَ ࡱ۬لَّذِي يَنۡه۪ىٰ ۝٩"],
[10,597,30,"عَبۡدًا إِذَا صَلّ۪ىٰ ۝١٠"],
[11,597,30,"أَرَءَيۡتَ إِن كَانَ عَلَى ࡱ۬لۡهُد۪ىٰ ۝١١"],
[12,597,30,"أَوۡ أَمَرَ بِالتَّقۡو۪ىٰ ۝١٢"],
[13,598,30,"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلّ۪ىٰ ۝١٣"],
[14,598,30,"أَلَمۡ يَعۡلَم بِأَنَّ ࡱ۬للَّهَ يَرٜىٰ ۝١٤"],
[15,598,30,"كَلَّاۖ لَئِن لَّمۡ يَنتَهِ ۝١٥"],
[16,598,30,"لَنَسۡفَعَۢا بِالنَّاصِيَةِ ۝١٦"],
[17,598,30,"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ ۝١٧"],
[18,598,30,"فَلۡيَدۡعُ نَادِيَهُۥ ۝١٨"],
[19,598,30,"سَنَدۡعُ ࡲ۬لزَّبَانِيَةَ ۝١٩"],
[20,598,30,"كَلَّاۖ لَا تُطِعۡهُ وَࡱسۡجُدۡۤ وَࡱقۡتَرِب۩ ۝٢٠"]
]}
