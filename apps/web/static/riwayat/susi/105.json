{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":105,"name":"الفِيلِ","t":[
[1,601,30,"أَلَمۡ تَرَ كَيۡف فَّعَل رَّبُّكَ بِأَصۡحَٰبِ ࡵ۬لۡفِيلِ ۝١"],
[2,601,30,"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلࣲ ۝٢"],
[3,601,30,"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ ۝٣"],
[4,601,30,"تَرۡمِيهِم بِحِجَارَةࣲ مِّن سِجِّيلࣲ ۝٤"],
[5,601,30,"فَجَعَلَهُمۡ كَعَصۡفࣲ مَّاكُولِۭ ۝٥"]
]}
