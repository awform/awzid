{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":101,"name":"القَارِعَةِ","t":[
[1,600,30,"ࡵ۬لۡقَارِعَةُ مَا ࡱ۬لۡقَارِعَةُ ۝١"],
[2,600,30,"وَمَا أَدۡرٜىٰكَ مَا ࡱ۬لۡقَارِعَةُ ۝٢"],
[3,600,30,"يَوۡمَ يَكُونُ ࡲ۬لنَّاسُ كَاَلۡفَرَاشِ ࡵ۬لۡمَبۡثُوثِ ۝٣"],
[4,600,30,"وَتَكُونُ ࡲ۬لۡجِبَالُ كَاَلۡعِهۡنِ ࡵ۬لۡمَنفُوشِ ۝٤"],
[5,600,30,"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ ۝٥"],
[6,600,30,"فَهۡوَ فِي عِيشَةࣲ رَّاضِيَةࣲ ۝٦"],
[7,600,30,"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ ۝٧"],
[8,600,30,"فَأُمُّه هَّاوِيَةࣱ ۝٨"],
[9,600,30,"وَمَا أَدۡرٜىٰكَ مَا هِيَهۡ ۝٩"],
[10,600,30,"نَارٌ حَامِيَةُۢ ۝١٠"]
]}
