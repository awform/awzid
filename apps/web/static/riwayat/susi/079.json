{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":79,"name":"النَّازِعَاتِ","t":[
[1,583,30,"وَࡱلنَّٰزِعَٰتِ غَرۡقࣰا ۝١"],
[2,583,30,"وَࡱلنَّٰشِطَٰتِ نَشۡطࣰا ۝٢"],
[3,583,30,"وَࡱلسَّٰبِحَٰت سَّبۡحࣰا ۝٣"],
[4,583,30,"فَاَلسَّٰبِقَٰت سَّبۡقࣰا ۝٤"],
[5,583,30,"فَاَلۡمُدَبِّرَٰتِ أَمۡرࣰا ۝٥"],
[6,583,30,"يَوۡمَ تَرۡجُفُ ࡲ۬لرَّاجِفَة ۝٦"],
[7,583,30,"تَّتۡبَعُهَا ࡱ۬لرَّادِفَةُ ۝٧"],
[8,583,30,"قُلُوبࣱ يَوۡمَئِذࣲ وَاجِفَةٌ ۝٨"],
[9,583,30,"أَبۡصَٰرُهَا خَٰشِعَةࣱ ۝٩"],
[10,583,30,"يَقُولُونَ أَٰࢇنَّا لَمَرۡدُودُونَ فِي ࡵ۬لۡحَافِرَةِ ۝١٠"],
[11,583,30,"أَٰࢇذَا كُنَّا عِظَٰمࣰا نَّخِرَةࣰ ۝١١"],
[12,583,30,"قَالُواْ تِلۡكَ إِذࣰا كَرَّةٌ خَاسِرَةࣱ ۝١٢"],
[13,583,30,"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ ۝١٣"],
[14,583,30,"فَإِذَا هُم بِالسَّاهِرَةِ ۝١٤"],
[15,583,30,"هَلۡ أَتَىٰكَ حَدِيثُ مُوس۪ىٰ ۝١٥"],
[16,583,30,"إِذۡ نَادَىٰهُ رَبُّهُۥ بِالۡوَادِ ࡵ۬لۡمُقَدَّسِ طُوَى ۝١٦"],
[17,584,30,"ࡱٜذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغ۪ىٰ ۝١٧"],
[18,584,30,"فَقُلۡ هَل لَّكَ إِلَىٰ أَن تَزَكّ۪ىٰ ۝١٨"],
[19,584,30,"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡش۪ىٰ ۝١٩"],
[20,584,30,"فَأَرٜىٰهُ ࡲ۬لۡأٓيَةَ ࡱ۬لۡكُبۡرٜىٰ ۝٢٠"],
[21,584,30,"فَكَذَّبَ وَعَص۪ىٰ ۝٢١"],
[22,584,30,"ثُمَّ أَدۡبَرَ يَسۡع۪ىٰ ۝٢٢"],
[23,584,30,"فَحَشَرَ فَنَاد۪ىٰ ۝٢٣"],
[24,584,30,"فَقَالَ أَنَا۠ رَبُّكُمُ ࡲ۬لۡأَعۡل۪ىٰ ۝٢٤"],
[25,584,30,"فَأَخَذَهُ ࡲ۬للَّهُ نَكَالَ ࡱ۬لۡأٓخِرَةِ وَࡱلۡأُول۪ىٰ ۝٢٥"],
[26,584,30,"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةࣰ لِّمَن يَخۡش۪ىٰ ۝٢٦"],
[27,584,30,"ءَٰࡶنتُمۡ أَشَدُّ خَلۡقًا أَمِ ࡵ۬لسَّمَآءُۚ بَن۪ىٰهَا ۝٢٧"],
[28,584,30,"رَفَعَ سَمۡكَهَا فَسَوّ۪ىٰهَا ۝٢٨"],
[29,584,30,"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُح۪ىٰهَا ۝٢٩"],
[30,584,30,"وَࡱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَح۪ىٰهَا ۝٣٠"],
[31,584,30,"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡع۪ىٰهَا ۝٣١"],
[32,584,30,"وَࡱلۡجِبَالَ أَرۡس۪ىٰهَا ۝٣٢"],
[33,584,30,"مَتَٰعࣰا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ۝٣٣"],
[34,584,30,"فَإِذَا جَآءَتِ ࡵ۬لطَّآمَّةُ ࡲ۬لۡكُبۡرٜىٰ ۝٣٤"],
[35,584,30,"يَوۡمَ يَتَذَكَّرُ ࡲ۬لۡإِنسَٰنُ مَا سَع۪ىٰ ۝٣٥"],
[36,584,30,"وَبُرِّزَتِ ࡵ۬لۡجَحِيمُ لِمَن يَرٜىٰ ۝٣٦"],
[37,584,30,"فَأَمَّا مَن طَغَىٰ وَءَاثَرَ ࡱ۬لۡحَيَوٰةَ ࡱ۬لدُّنۡي۪ا ۝٣٧"],
[38,584,30,"فَإِنَّ ࡱ۬لۡجَحِيمَ هِيَ ࡱ۬لۡمَاو۪ىٰ ۝٣٨"],
[39,584,30,"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ࡱ۬لنَّفۡسَ عَنِ ࡵ۬لۡهَو۪ىٰ ۝٣٩"],
[40,584,30,"فَإِنَّ ࡱ۬لۡجَنَّةَ هِيَ ࡱ۬لۡمَاو۪ىٰ ۝٤٠"],
[41,584,30,"۞ يَسۡـَٔلُونَكَ عَنِ ࡵ۬لسَّاعَةِ أَيَّانَ مُرۡس۪ىٰهَا ۝٤١"],
[42,584,30,"فِيمَ أَنتَ مِن ذِكۡرٜىٰهَا ۝٤٢"],
[43,584,30,"إِلَىٰ رَبِّكَ مُنتَه۪ىٰهَا ۝٤٣"],
[44,584,30,"إِنَّمَا أَنتَ مُنذِرُ مَن يَخۡش۪ىٰهَا ۝٤٤"],
[45,584,30,"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُواْ إِلَّا عَشِيَّةً أَوۡ ضُح۪ىٰهَا ۝٤٥"]
]}
