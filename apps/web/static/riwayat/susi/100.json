{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":100,"name":"العَادِيَاتِ","t":[
[1,599,30,"وَࡱلۡعَٰدِيَٰت ضَّبۡحࣰا ۝١"],
[2,599,30,"فَاَلۡمُورِيَٰتِ قَدۡحࣰا ۝٢"],
[3,599,30,"فَاَلۡمُغِيرَٰت صُّبۡحࣰا ۝٣"],
[4,599,30,"فَأَثَرۡنَ بِهِۦ نَقۡعࣰا ۝٤"],
[5,599,30,"فَوَسَطۡنَ بِهِۦ جَمۡعًا ۝٥"],
[6,600,30,"إِنَّ ࡱ۬لۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودࣱ ۝٦"],
[7,600,30,"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدࣱ ۝٧"],
[8,600,30,"وَإِنَّهُۥ لِحُبِّ ࡵ۬لۡخَيۡر لَّشَدِيدٌ ۝٨"],
[9,600,30,"۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ࡵ۬لۡقُبُورِ ۝٩"],
[10,600,30,"وَحُصِّلَ مَا فِي ࡵ۬لصُّدُورِ ۝١٠"],
[11,600,30,"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذࣲ لَّخَبِيرُۢ ۝١١"]
]}
