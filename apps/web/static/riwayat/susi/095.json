{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":95,"name":"التِّينِ","t":[
[1,597,30,"وَࡱلتِّينِ وَࡱلزَّيۡتُونِ ۝١"],
[2,597,30,"وَطُورِ سِينِينَ ۝٢"],
[3,597,30,"وَهَٰذَا ࡱ۬لۡبَلَدِ ࡵ۬لۡأَمِينِ ۝٣"],
[4,597,30,"لَقَدۡ خَلَقۡنَا ࡱ۬لۡإِنسَٰنَ فِي أَحۡسَنِ تَقۡوِيمࣲ ۝٤"],
[5,597,30,"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ ۝٥"],
[6,597,30,"إِلَّا ࡱ۬لَّذِينَ ءَامَنُواْ وَعَمِلُواْ ࡲ۬لصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونࣲ ۝٦"],
[7,597,30,"فَمَا يُكَذِّبُكَ بَعۡدُ بِالدِّينِ ۝٧"],
[8,597,30,"أَلَيۡسَ ࡱ۬للَّهُ بِأَحۡكَمِ ࡵ۬لۡحَٰكِمِينَ ۝٨"]
]}
