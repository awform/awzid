{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":82,"name":"الانفِطَارِ","t":[
[1,587,30,"إِذَا ࡱ۬لسَّمَآءُ ࡲٜنفَطَرَتۡ ۝١"],
[2,587,30,"وَإِذَا ࡱ۬لۡكَوَاكِبُ ࡲٜنتَثَرَتۡ ۝٢"],
[3,587,30,"وَإِذَا ࡱ۬لۡبِحَارُ فُجِّرَتۡ ۝٣"],
[4,587,30,"وَإِذَا ࡱ۬لۡقُبُورُ بُعۡثِرَتۡ ۝٤"],
[5,587,30,"عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ ۝٥"],
[6,587,30,"يَٰأَيُّهَا ࡱ۬لۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ࡱ۬لۡكَرِيمِ ۝٦"],
[7,587,30,"ࡵ۬لَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَّلَكَ ۝٧"],
[8,587,30,"فِي أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَك ۝٨"],
[9,587,30,"كَّلَّا بَلۡ تُكَذِّبُونَ بِالدِّينِ ۝٩"],
[10,587,30,"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ ۝١٠"],
[11,587,30,"كِرَامࣰا كَٰتِبِينَ ۝١١"],
[12,587,30,"يَعۡلَمُونَ مَا تَفۡعَلُونَ ۝١٢"],
[13,587,30,"إِنَّ ࡱ۬لۡأَبۡرَارَ لَفِي نَعِيمࣲ ۝١٣"],
[14,587,30,"وَإِنَّ ࡱ۬لۡفُجَّارَ لَفِي جَحِيمࣲ ۝١٤"],
[15,587,30,"يَصۡلَوۡنَهَا يَوۡمَ ࡱ۬لدِّينِ ۝١٥"],
[16,587,30,"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ ۝١٦"],
[17,587,30,"وَمَا أَدۡرٜىٰكَ مَا يَوۡمُ ࡲ۬لدِّينِ ۝١٧"],
[18,587,30,"ثُمَّ مَا أَدۡرٜىٰكَ مَا يَوۡمُ ࡲ۬لدِّينِ ۝١٨"],
[19,587,30,"يَوۡمُ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَيۡـࣰٔاۖ وَࡱلۡأَمۡرُ يَوۡمَئِذࣲ لِّلَّهِ ۝١٩"]
]}
