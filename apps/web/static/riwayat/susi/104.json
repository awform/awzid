{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":104,"name":"الهُمَزَةِ","t":[
[1,601,30,"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ ۝١"],
[2,601,30,"ࡵ۬لَّذِي جَمَعَ مَالࣰا وَعَدَّدَهُۥ ۝٢"],
[3,601,30,"يَحۡسِبُ أَنَّ مَالَهُۥ أَخۡلَدَهُۥ ۝٣"],
[4,601,30,"كَلَّاۖ لَيُنۢبَذَنَّ فِي ࡵ۬لۡحُطَمَةِ ۝٤"],
[5,601,30,"وَمَا أَدۡرٜىٰكَ مَا ࡱ۬لۡحُطَمَةُ ۝٥"],
[6,601,30,"نَارُ ࡲ۬للَّهِ ࡵ۬لۡمُوقَدَةُ ۝٦"],
[7,601,30,"ࡲ۬لَّتِي تَطَّلِع عَّلَى ࡱ۬لۡأَفۡـِٔدَةِ ۝٧"],
[8,601,30,"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةࣱ ۝٨"],
[9,601,30,"فِي عَمَدࣲ مُّمَدَّدَةِۭ ۝٩"]
]}
