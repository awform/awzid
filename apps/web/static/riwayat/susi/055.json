{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":55,"name":"الرَّحۡمَٰن","t":[
[1,531,27,"ࡵ۬لرَّحۡمَٰنُ عَلَّمَ ࡱ۬لۡقُرۡءَانَ ۝١"],
[2,531,27,"خَلَقَ ࡱ۬لۡإِنسَٰنَ عَلَّمَهُ ࡲ۬لۡبَيَانَ ۝٢"],
[3,531,27,"ࡱ۬لشَّمۡسُ وَࡱلۡقَمَرُ بِحُسۡبَانࣲ ۝٣"],
[4,531,27,"وَࡱلنَّجۡمُ وَࡱلشَّجَرُ يَسۡجُدَانِ ۝٤"],
[5,531,27,"وَࡱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ࡱ۬لۡمِيزَانَ ۝٥"],
[6,531,27,"أَلَّا تَطۡغَوۡاْ فِي ࡵ۬لۡمِيزَانِ ۝٦"],
[7,531,27,"وَأَقِيمُواْ ࡲ۬لۡوَزۡنَ بِالۡقِسۡطِ وَلَا تُخۡسِرُواْ ࡲ۬لۡمِيزَانَ ۝٧"],
[8,531,27,"وَࡱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ ۝٨"],
[9,531,27,"فِيهَا فَٰكِهَةࣱ وَࡱلنَّخۡلُ ذَاتُ ࡲ۬لۡأَكۡمَامِ ۝٩"],
[10,531,27,"وَࡱلۡحَبُّ ذُو ࡲ۬لۡعَصۡفِ وَࡱلرَّيۡحَانُ ۝١٠"],
[11,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝١١"],
[12,531,27,"خَلَقَ ࡱ۬لۡإِنسَٰنَ مِن صَلۡصَٰلࣲ كَاَلۡفَخّٜارِ ۝١٢"],
[13,531,27,"وَخَلَقَ ࡱ۬لۡجَآنَّ مِن مَّارِجࣲ مِّن نّٜارࣲ ۝١٣"],
[14,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝١٤"],
[15,531,27,"رَبُّ ࡲ۬لۡمَشۡرِقَيۡنِ وَرَبُّ ࡲ۬لۡمَغۡرِبَيۡنِ ۝١٥"],
[16,531,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝١٦"],
[17,532,27,"مَرَجَ ࡱ۬لۡبَحۡرَيۡنِ يَلۡتَقِيَانِ ۝١٧"],
[18,532,27,"بَيۡنَهُمَا بَرۡزَخࣱ لَّا يَبۡغِيَانِ ۝١٨"],
[19,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝١٩"],
[20,532,27,"يُخۡرَجُ مِنۡهُمَا ࡱ۬للُّولُؤُ وَࡱلۡمَرۡجَانُ ۝٢٠"],
[21,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٢١"],
[22,532,27,"وَلَهُ ࡲ۬لۡجَوَارِ ࡵ۬لۡمُنشَـَٔاتُ فِي ࡵ۬لۡبَحۡرِ كَاَلۡأَعۡلَٰمِ ۝٢٢"],
[23,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٢٣"],
[24,532,27,"كُلُّ مَنۡ عَلَيۡهَا فَانࣲ ۝٢٤"],
[25,532,27,"وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ࡲ۬لۡجَلَٰلِ وَࡱلۡإِكۡرَامِ ۝٢٥"],
[26,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٢٦"],
[27,532,27,"يَسۡـَٔلُهُۥ مَن فِي ࡵ۬لسَّمَٰوَٰتِ وَࡱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَانࣲ ۝٢٧"],
[28,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٢٨"],
[29,532,27,"سَنَفۡرُغُ لَكُمۡ أَيُّهَ ࡱ۬لثَّقَلَانِ ۝٢٩"],
[30,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٣٠"],
[31,532,27,"يَٰمَعۡشَرَ ࡱ۬لۡجِنِّ وَࡱلۡإِنسِ إِنِ ࡵٜسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطٜارِ ࡵ۬لسَّمَٰوَٰتِ وَࡱلۡأَرۡضِ فَاَنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنࣲ ۝٣١"],
[32,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٣٢"],
[33,532,27,"يُرۡسَلُ عَلَيۡكُمَا شُوَاظࣱ مِّن نّٜارࣲ ۝٣٣"],
[34,532,27,"وَنُحَاسࣲ فَلَا تَنتَصِرَانِ ۝٣٤"],
[35,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٣٥"],
[36,532,27,"فَإِذَا ࡱٜنشَقَّتِ ࡵ۬لسَّمَآءُ فَكَانَتۡ وَرۡدَةࣰ كَاَلدِّهَانِ ۝٣٦"],
[37,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٣٧"],
[38,532,27,"فَيَوۡمَئِذࣲ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦ إِنسࣱ وَلَا جَآنࣱّ ۝٣٨"],
[39,532,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٣٩"],
[40,532,27,"۞ يُعۡرَفُ ࡲ۬لۡمُجۡرِمُونَ بِسِيم۪ـٰهُمۡ فَيُوخَذُ بِالنَّوَٰصِي وَࡱلۡأَقۡدَامِ ۝٤٠"],
[41,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٤١"],
[42,533,27,"هَٰذِهِۦ جَهَنَّمُ ࡲ۬لَّتِي يُكَذِّب بِّهَا ࡱ۬لۡمُجۡرِمُونَ ۝٤٢"],
[43,533,27,"يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانࣲ ۝٤٣"],
[44,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٤٤"],
[45,533,27,"وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ ۝٤٥"],
[46,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٤٦"],
[47,533,27,"ذَوَاتَا أَفۡنَانࣲ ۝٤٧"],
[48,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٤٨"],
[49,533,27,"فِيهِمَا عَيۡنَانِ تَجۡرِيَانِ ۝٤٩"],
[50,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٥٠"],
[51,533,27,"فِيهِمَا مِن كُلِّ فَٰكِهَةࣲ زَوۡجَانِ ۝٥١"],
[52,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٥٢"],
[53,533,27,"مُتَّكِـِٔينَ عَلَىٰ فُرُشِۭ بَطَآئِنُهَا مِنۡ إِسۡتَبۡرَقࣲۚ وَجَنَى ࡱ۬لۡجَنَّتَيۡنِ دَانࣲ ۝٥٣"],
[54,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٥٤"],
[55,533,27,"فِيهِنَّ قَٰصِرَٰتُ ࡲ۬لطَّرۡفِ لَمۡ يَطۡمِثۡهُنَّ إِنسࣱ قَبۡلَهُمۡ وَلَا جَآنࣱّ ۝٥٥"],
[56,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٥٦"],
[57,533,27,"كَأَنَّهُنَّ ࡱ۬لۡيَاقُوتُ وَࡱلۡمَرۡجَانُ ۝٥٧"],
[58,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٥٨"],
[59,533,27,"هَلۡ جَزَآءُ ࡲ۬لۡإِحۡسَٰنِ إِلَّا ࡱ۬لۡإِحۡسَٰنُ ۝٥٩"],
[60,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٦٠"],
[61,533,27,"وَمِن دُونِهِمَا جَنَّتَانِ ۝٦١"],
[62,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٦٢"],
[63,533,27,"مُدۡهَآمَّتَانِ ۝٦٣"],
[64,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٦٤"],
[65,533,27,"فِيهِمَا عَيۡنَان نَّضَّاخَتَانِ ۝٦٥"],
[66,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٦٦"],
[67,533,27,"فِيهِمَا فَٰكِهَةࣱ وَنَخۡلࣱ وَرُمَّانࣱ ۝٦٧"],
[68,533,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٦٨"],
[69,534,27,"فِيهِنَّ خَيۡرَٰتٌ حِسَانࣱ ۝٦٩"],
[70,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٧٠"],
[71,534,27,"۞ حُورࣱ مَّقۡصُورَٰتࣱ فِي ࡵ۬لۡخِيَامِ ۝٧١"],
[72,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٧٢"],
[73,534,27,"لَمۡ يَطۡمِثۡهُنَّ إِنسࣱ قَبۡلَهُمۡ وَلَا جَآنࣱّ ۝٧٣"],
[74,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٧٤"],
[75,534,27,"مُتَّكِـِٔينَ عَلَىٰ رَفۡرَفٍ خُضۡرࣲ وَعَبۡقَرِيٍّ حِسَانࣲ ۝٧٥"],
[76,534,27,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ۝٧٦"],
[77,534,27,"تَبَٰرَكَ ࡱٜسۡمُ رَبِّكَ ذِي ࡵ۬لۡجَلَٰلِ وَࡱلۡإِكۡرَامِ ۝٧٧"]
