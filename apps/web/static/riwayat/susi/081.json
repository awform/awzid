{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":81,"name":"التَّكۡوِيرِ","t":[
[1,586,30,"إِذَا ࡱ۬لشَّمۡسُ كُوِّرَتۡ ۝١"],
[2,586,30,"وَإِذَا ࡱ۬لنُّجُومُ ࡲٜنكَدَرَتۡ ۝٢"],
[3,586,30,"وَإِذَا ࡱ۬لۡجِبَالُ سُيِّرَتۡ ۝٣"],
[4,586,30,"وَإِذَا ࡱ۬لۡعِشَارُ عُطِّلَتۡ ۝٤"],
[5,586,30,"وَإِذَا ࡱ۬لۡوُحُوشُ حُشِرَتۡ ۝٥"],
[6,586,30,"وَإِذَا ࡱ۬لۡبِحَارُ سُجِرَتۡ ۝٦"],
[7,586,30,"وَإِذَا ࡱ۬لنُّفُوس زُّوِّجَتۡ ۝٧"],
[8,586,30,"وَإِذَا ࡱ۬لۡمَوۡءُۥدَة سُّئِلَتۡ ۝٨"],
[9,586,30,"بِأَيِّ ذَنۢبࣲ قُتِلَتۡ ۝٩"],
[10,586,30,"وَإِذَا ࡱ۬لصُّحُفُ نُشِّرَتۡ ۝١٠"],
[11,586,30,"وَإِذَا ࡱ۬لسَّمَآءُ كُشِطَتۡ ۝١١"],
[12,586,30,"وَإِذَا ࡱ۬لۡجَحِيمُ سُعِرَتۡ ۝١٢"],
[13,586,30,"وَإِذَا ࡱ۬لۡجَنَّةُ أُزۡلِفَتۡ ۝١٣"],
[14,586,30,"عَلِمَتۡ نَفۡسࣱ مَّا أَحۡضَرَتۡ ۝١٤"],
[15,586,30,"فَلَا أُقۡسِم بِالۡخُنَّسِ ۝١٥"],
[16,586,30,"ࡵ۬لۡجَوَارِ ࡵ۬لۡكُنَّسِ ۝١٦"],
[17,586,30,"وَࡱلَّيۡلِ إِذَا عَسۡعَسَ ۝١٧"],
[18,586,30,"وَࡱلصُّبۡحِ إِذَا تَنَفَّسَ ۝١٨"],
[19,586,30,"إِنَّهُۥ لَقَوۡل رَّسُولࣲ كَرِيمࣲ ۝١٩"],
[20,586,30,"ذِي قُوَّةٍ عِندَ ذِي ࡵ۬لۡعَرۡشِ مَكِينࣲ ۝٢٠"],
[21,586,30,"مُّطَاعࣲ ثَمَّ أَمِينࣲ ۝٢١"],
[22,586,30,"وَمَا صَاحِبُكُم بِمَجۡنُونࣲ ۝٢٢"],
[23,586,30,"وَلَقَدۡ رَءٜاهُ بِالۡأُفُقِ ࡵ۬لۡمُبِينِ ۝٢٣"],
[24,586,30,"وَمَا هُوَ عَلَى ࡱ۬لۡغَيۡب بِّضظَنِينࣲ ۝٢٤"],
[25,586,30,"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنࣲ رَّجِيمࣲ ۝٢٥"],
[26,586,30,"فَأَيۡنَ تَذۡهَبُونَ ۝٢٦"],
[27,586,30,"إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَٰلَمِينَ ۝٢٧"],
[28,586,30,"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ ۝٢٨"],
[29,586,30,"وَمَا تَشَآءُونَ إِلَّا أَن يَشَآءَ ࡱ۬للَّهُ رَبُّ ࡲ۬لۡعَٰلَمِينَ ۝٢٩"]
]}
