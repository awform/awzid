{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":86,"name":"الطَّارِقِ","t":[
[1,591,30,"وَࡱلسَّمَآءِ وَࡱلطَّارِقِ ۝١"],
[2,591,30,"وَمَا أَدۡرٜىٰكَ مَا ࡱ۬لطَّارِقُ ۝٢"],
[3,591,30,"ࡲ۬لنَّجۡمُ ࡲ۬لثَّاقِبُ ۝٣"],
[4,591,30,"إِن كُلُّ نَفۡسࣲ لَّمَا عَلَيۡهَا حَافِظࣱ ۝٤"],
[5,591,30,"فَلۡيَنظُرِ ࡵ۬لۡإِنسَٰنُ مِمَّ خُلِقَ ۝٥"],
[6,591,30,"خُلِقَ مِن مَّآءࣲ دَافِقࣲ ۝٦"],
[7,591,30,"يَخۡرُجُ مِنۢ بَيۡنِ ࡵ۬لصُّلۡبِ وَࡱلتَّرَآئِبِ ۝٧"],
[8,591,30,"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ ۝٨"],
[9,591,30,"يَوۡمَ تُبۡلَى ࡱ۬لسَّرَآئِرُ ۝٩"],
[10,591,30,"فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ ۝١٠"],
[11,591,30,"وَࡱلسَّمَآءِ ذَاتِ ࡵ۬لرَّجۡعِ ۝١١"],
[12,591,30,"وَࡱلۡأَرۡضِ ذَاتِ ࡵ۬لصَّدۡعِ ۝١٢"],
[13,591,30,"إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ ۝١٣"],
[14,591,30,"وَمَا هُوَ بِالۡهَزۡلِ ۝١٤"],
[15,591,30,"إِنَّهُمۡ يَكِيدُونَ كَيۡدࣰا وَأَكِيدُ كَيۡدࣰا ۝١٥"],
[16,591,30,"فَمَهِّلِ ࡵ۬لۡكٜـٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا ۝١٦"]
]}
