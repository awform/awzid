{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":93,"name":"الضُّحَىٰ","t":[
[1,596,30,"وَࡱلضُّح۪ىٰ ۝١"],
[2,596,30,"وَࡱلَّيۡلِ إِذَا سَج۪ىٰ ۝٢"],
[3,596,30,"مَا وَدَّعَكَ رَبُّكَ وَمَا قَل۪ىٰ ۝٣"],
[4,596,30,"وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ࡱ۬لۡأُول۪ىٰ ۝٤"],
[5,596,30,"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡض۪ىٰ ۝٥"],
[6,596,30,"أَلَمۡ يَجِدۡكَ يَتِيمࣰا فَـَٔاو۪ىٰ ۝٦"],
[7,596,30,"وَوَجَدَكَ ضَآلࣰّا فَهَد۪ىٰ ۝٧"],
[8,596,30,"وَوَجَدَكَ عَآئِلࣰا فَأَغۡن۪ىٰ ۝٨"],
[9,596,30,"فَأَمَّا ࡱ۬لۡيَتِيمَ فَلَا تَقۡهَرۡ ۝٩"],
[10,596,30,"وَأَمَّا ࡱ۬لسَّآئِلَ فَلَا تَنۡهَرۡ ۝١٠"],
[11,596,30,"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ ۝١١"]
]}
