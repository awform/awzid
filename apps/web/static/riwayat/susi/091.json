{"v":1,"key":"susi","version":"kfgqpc_susi_v30","source":"KFGQPC","s":91,"name":"الشَّمۡسِ","t":[
[1,595,30,"وَࡱلشَّمۡسِ وَضُح۪ىٰهَا ۝١"],
[2,595,30,"وَࡱلۡقَمَرِ إِذَا تَل۪ىٰهَا ۝٢"],
[3,595,30,"وَࡱلنَّهٜارِ إِذَا جَلّ۪ىٰهَا ۝٣"],
[4,595,30,"وَࡱلَّيۡلِ إِذَا يَغۡش۪ىٰهَا ۝٤"],
[5,595,30,"وَࡱلسَّمَآءِ وَمَا بَن۪ىٰهَا ۝٥"],
[6,595,30,"وَࡱلۡأَرۡضِ وَمَا طَح۪ىٰهَا ۝٦"],
[7,595,30,"وَنَفۡسࣲ وَمَا سَوّ۪ىٰهَا ۝٧"],
[8,595,30,"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡو۪ىٰهَا ۝٨"],
[9,595,30,"قَدۡ أَفۡلَحَ مَن زَكّ۪ىٰهَا ۝٩"],
[10,595,30,"وَقَدۡ خَابَ مَن دَسّ۪ىٰهَا ۝١٠"],
[11,595,30,"كَذَّبَت ثَّمُودُ بِطَغۡو۪ىٰهَا ۝١١"],
[12,595,30,"إِذِ ࡵٜنۢبَعَثَ أَشۡق۪ىٰهَا ۝١٢"],
[13,595,30,"فَقَال لَّهُمۡ رَسُولُ ࡲ۬للَّهِ نَاقَةَ ࡱ۬للَّهِ وَسُقۡي۪ـٰهَا ۝١٣"],
[14,595,30,"فَكَذَّبُوهُ فَعَقَرُوهَا ۝١٤"],
[15,595,30,"فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوّ۪ىٰهَا ۝١٥"],
[16,595,30,"وَلَا يَخَافُ عُقۡب۪ـٰهَا ۝١٦"]
]}
