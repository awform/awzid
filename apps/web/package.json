{
  "name": "@awform/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Application web progressive AWFORM (SvelteKit)",
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "dev": "node scripts/copy-fonts.mjs && vite dev",
    "build": "node scripts/copy-fonts.mjs && svelte-kit sync && vite build && node scripts/personnel.mjs",
    "preview": "vite preview",
    "start": "node build/index.js",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "budget": "node scripts/budget.mjs",
    "theme": "node scripts/theme.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@awform/content": "workspace:*",
    "@awform/grading": "workspace:*",
    "@awform/hifz": "workspace:*",
    "@awform/school": "workspace:*",
    "adhan": "4.4.6",
    "intl-messageformat": "^12.1.2",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.0",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
